#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N turbospec
#PBS -r y
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89

# Unified pipeline PBS script for ALL grid types (LHS/ML and regular/Cartesian).
# The grid type lives entirely in the config (grid.sampling: "lhs" | "grid"),
# not in the script name — point CONFIG_PATH at a regular-grid config to run one.
#
# Supports three modes of operation:
#
#   1) Array job   – one shard per PBS array task (multi-worker within each task)
#      qsub -J 0-99 -v CONFIG_PATH=...,SHARD_COUNT=100 turbospectrum_pipeline.pbs
#
#   2) Single job  – worker pool processes all shards inside one job
#      qsub -v CONFIG_PATH=... turbospectrum_pipeline.pbs
#
#   3) Finalize    – validate + merge existing shards (no synthesis)
#      qsub -v CONFIG_PATH=...,FINALIZE_ONLY=1 turbospectrum_pipeline.pbs
#
# Mode is auto-detected: PBS_ARRAY_INDEX present → array task,
# FINALIZE_ONLY=1 → finalize, otherwise → single job.
#
# Useful -v knobs:
#   SKIP_SYNTHESIS=1          generate the grid only, then stop (no synthesis/merge)
#   AUTO_PRUNE_STALE_SHARDS=1 drop shards whose layout no longer matches SHARD_COUNT
#                             before resuming (opt-in; off by default)

set -euo pipefail
cd "${PBS_O_WORKDIR}"

TAG="turbospec"

############################################
# Thread caps
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

unset PYTHONHOME || true
unset PYTHONPATH || true

############################################
# Environment activation
############################################

PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[${TAG}] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[${TAG}] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[${TAG}] Python: ${PYTHON}"
echo "[${TAG}] Mamba env: ${MAMBA_ENV_NAME}"
echo "[${TAG}] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Variables
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
DEFAULT_RUN_ROOT="/scratch/${PROJECT}/${USER_ID}/Turbospectrum_NLTE"
USER_RUN_ROOT="${RUN_ROOT:-}"
RUN_ROOT="${USER_RUN_ROOT:-${DEFAULT_RUN_ROOT}}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
WORKERS_OVERRIDE="${WORKERS:-}"
SHARD_COUNT_OVERRIDE="${SHARD_COUNT:-}"
ROWS_PER_SHARD_OVERRIDE="${ROWS_PER_SHARD:-}"
FINALIZE_ONLY="${FINALIZE_ONLY:-0}"
NO_SCRATCH="${NO_SCRATCH:-0}"
FORCE_RESTART="${FORCE_RESTART:-0}"
ALLOW_PARTIAL_MERGE="${ALLOW_PARTIAL_MERGE:-1}"
ALLOW_INCOMPLETE_PROVENANCE="${ALLOW_INCOMPLETE_PROVENANCE:-0}"
SKIP_BAD_SHARDS="${SKIP_BAD_SHARDS:-1}"
CLEANUP_SHARDS="${CLEANUP_SHARDS:-1}"
MERGE_CHUNK_ROWS="${MERGE_CHUNK_ROWS:-128}"
# Auto-prune shards whose stride/layout no longer matches SHARD_COUNT before
# resuming. Default OFF (opt-in) so existing LHS runs are unaffected; set to 1
# (or pass AUTO_PRUNE_STALE_SHARDS=1) to enable, e.g. after changing SHARD_COUNT.
AUTO_PRUNE_STALE_SHARDS="${AUTO_PRUNE_STALE_SHARDS:-0}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO="$(cd "${REPO}" >/dev/null 2>&1 && pwd)"
LAYOUT_HELPER="${REPO}/scripts/resolve_shard_layout.py"

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[${TAG}] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

to_bool01() {
    local val
    val="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    case "${val}" in
        1|true|yes|on) echo 1 ;;
        *) echo 0 ;;
    esac
}

# Surface the tail of a shard log (and any matching error lines) to stderr after
# a shard fails, so failures are debuggable from the job's combined output.
print_log_excerpt() {
    local log_path="$1"
    local label="$2"
    if [[ -f "${log_path}" ]]; then
        echo "[${TAG}] ${label}: ${log_path}" >&2
        if grep -Einq 'error|failed|exception|traceback|missing spectrum|forrtl|killed|oom|assert' "${log_path}"; then
            echo "[${TAG}] Matching error lines from ${log_path} (last 80):" >&2
            grep -Ein 'error|failed|exception|traceback|missing spectrum|forrtl|killed|oom|assert' "${log_path}" | tail -n 80 >&2 || true
        fi
        echo "[${TAG}] Last 120 lines from ${log_path}:" >&2
        tail -n 120 "${log_path}" >&2 || true
    fi
}

# Remove shard stores whose global_index no longer matches the current
# (SHARD_COUNT, ROW_COUNT) stride — e.g. left over from a run with a different
# shard layout. Gated by AUTO_PRUNE_STALE_SHARDS; never runs in array-task mode.
prune_incompatible_shards() {
    "${PYTHON}" - <<PY
import re
import shutil
from pathlib import Path

import numpy as np
import zarr

shard_dir = Path(r"${SHARDS_DIR}")
expected_shards = int(r"${SHARD_COUNT}")
row_count = int(r"${ROW_COUNT}")
pattern = re.compile(r"^spectra_shard_(\d+)\.zarr$")
removed: list[str] = []

for shard_path in sorted(shard_dir.glob("spectra_shard_*.zarr")):
    match = pattern.match(shard_path.name)
    if match is None:
        continue
    shard_idx = int(match.group(1))
    remove_reason = None
    if shard_idx < 0 or shard_idx >= expected_shards:
        remove_reason = "outside_expected_range"
    else:
        try:
            root = zarr.open_group(str(shard_path), mode="r")
            expected_indices = np.arange(shard_idx, row_count, expected_shards, dtype=np.int64)
            gidx = np.asarray(root["global_index"][:], dtype=np.int64)
            if gidx.shape != expected_indices.shape or not np.array_equal(gidx, expected_indices):
                remove_reason = "layout_mismatch"
        except Exception:
            remove_reason = "unreadable_or_missing_global_index"
    if remove_reason is not None:
        shutil.rmtree(shard_path, ignore_errors=True)
        removed.append(f"{shard_path.name}:{remove_reason}")

preview = removed[:10]
suffix = " (truncated)" if len(removed) > 10 else ""
print(f"[${TAG} prune] removed={len(removed)} preview={preview}{suffix}")
PY
}

FINALIZE_ONLY_EFFECTIVE="$(to_bool01 "${FINALIZE_ONLY}")"
FORCE_RESTART_EFFECTIVE="$(to_bool01 "${FORCE_RESTART}")"

############################################
# Mode detection
############################################

ARRAY_TASK_MODE=0
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    ARRAY_TASK_MODE=1
fi

if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]] && (( ARRAY_TASK_MODE == 1 )); then
    echo "[${TAG}] ERROR: FINALIZE_ONLY=1 should be submitted as a normal job, not as a PBS array task." >&2
    exit 1
fi

if (( ARRAY_TASK_MODE == 1 )); then
    echo "[${TAG}] Mode: array task (PBS_ARRAY_INDEX=${PBS_ARRAY_INDEX})"
elif [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]]; then
    echo "[${TAG}] Mode: finalize only (validate + merge)"
else
    echo "[${TAG}] Mode: single job (worker pool)"
fi

############################################
# Parse config
############################################

CONFIG_OUTPUTS="$(
    "${PYTHON}" - <<PY
import json
import os

cfg_path = os.path.abspath(r"${CONFIG_PATH}")
cfg_dir = os.path.dirname(cfg_path)
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
outs = cfg.get("outputs", {}) or {}
runtime = cfg.get("runtime", {}) or {}

def _abs(p):
    if not p:
        return ""
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cfg_dir, p))

def _abs_output(p, rr):
    """Resolve an output path: absolute paths stay, dot-relative (../../)
    resolves from cfg_dir, bare relative (outputs/...) resolves from run_root."""
    if not p:
        return ""
    if os.path.isabs(p):
        return p
    if not p.startswith((".", "..")):
        return os.path.abspath(os.path.join(rr, p)) if rr else os.path.abspath(os.path.join(cfg_dir, p))
    return os.path.abspath(os.path.join(cfg_dir, p))

def _infer_run_root(*paths):
    for path in paths:
        if not path:
            continue
        parent = os.path.dirname(os.path.normpath(path))
        if os.path.basename(parent) in {"shards", "zarr", "grids"} and os.path.basename(os.path.dirname(parent)) == "outputs":
            return os.path.dirname(os.path.dirname(parent))
    return ""

run_root = _abs(outs.get("run_root")) or _infer_run_root(
    outs.get("spectra_shard_template") and _abs(outs.get("spectra_shard_template")),
    outs.get("spectra_zarr") and _abs(outs.get("spectra_zarr")),
    outs.get("grid_zarr") and _abs(outs.get("grid_zarr")),
)
grid = _abs_output(outs.get("grid_zarr"), run_root)
merged = _abs_output(outs.get("spectra_zarr"), run_root)
shard_tmpl = _abs_output(outs.get("spectra_shard_template"), run_root)
shards_dir = os.path.dirname(shard_tmpl) if shard_tmpl else ""

def _int_or_empty(val):
    if val in (None, ""):
        return ""
    try:
        return str(int(val))
    except Exception:
        return ""

print(run_root)
print(grid)
print(merged)
print(shard_tmpl)
print(shards_dir)
print(_int_or_empty(runtime.get("workers")))
print(_int_or_empty(runtime.get("shard_count")))
print(_int_or_empty(runtime.get("rows_per_shard")))
print(_int_or_empty((cfg.get("grid") or {}).get("num_samples")))
print("1" if runtime.get("skip_synthesis") else "")
PY
)"

# Portable equivalent of `mapfile -t _cfg_lines` (mapfile is bash 4+; macOS ships 3.2).
_cfg_lines=()
while IFS= read -r _cfg_line; do
    _cfg_lines+=("${_cfg_line}")
done <<< "${CONFIG_OUTPUTS}"
CFG_RUN_ROOT="${_cfg_lines[0]:-}"
CFG_GRID_ZARR="${_cfg_lines[1]:-}"
CFG_MERGED_ZARR="${_cfg_lines[2]:-}"
CFG_SHARD_TEMPLATE="${_cfg_lines[3]:-}"
CFG_SHARDS_DIR="${_cfg_lines[4]:-}"
CFG_WORKERS="${_cfg_lines[5]:-}"
CFG_SHARD_COUNT="${_cfg_lines[6]:-}"
CFG_ROWS_PER_SHARD="${_cfg_lines[7]:-}"
CFG_NUM_SAMPLES="${_cfg_lines[8]:-}"
CFG_SKIP_SYNTHESIS="${_cfg_lines[9]:-}"

# Grid-only mode: honour runtime.skip_synthesis from config, with the
# SKIP_SYNTHESIS env var able to force it on (matching FORCE_RESTART semantics).
SKIP_SYNTHESIS_EFFECTIVE="$(to_bool01 "${CFG_SKIP_SYNTHESIS}")"
if [[ "$(to_bool01 "${SKIP_SYNTHESIS:-}")" == "1" ]]; then
    SKIP_SYNTHESIS_EFFECTIVE="1"
fi

if [[ -z "${USER_RUN_ROOT}" && -n "${CFG_RUN_ROOT}" ]]; then
    RUN_ROOT="${CFG_RUN_ROOT}"
fi

WORKERS="${WORKERS_OVERRIDE:-${CFG_WORKERS:-${PBS_NCPUS:-32}}}"
if ! [[ "${WORKERS}" =~ ^[0-9]+$ ]] || (( WORKERS < 1 )); then
    echo "[${TAG}] WARN: invalid WORKERS='${WORKERS}', defaulting to 16." >&2
    WORKERS=16
fi

DEFAULT_VALIDATE_WORKERS="${WORKERS}"
if (( DEFAULT_VALIDATE_WORKERS > 32 )); then
    DEFAULT_VALIDATE_WORKERS=32
fi
VALIDATE_WORKERS="${VALIDATE_WORKERS:-${DEFAULT_VALIDATE_WORKERS}}"
if ! [[ "${VALIDATE_WORKERS}" =~ ^[0-9]+$ ]] || (( VALIDATE_WORKERS < 1 )); then
    VALIDATE_WORKERS="${DEFAULT_VALIDATE_WORKERS}"
fi

if ! [[ "${MERGE_CHUNK_ROWS}" =~ ^[0-9]+$ ]] || (( MERGE_CHUNK_ROWS < 1 )); then
    MERGE_CHUNK_ROWS=128
fi

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR:-${RUN_ROOT}/outputs/grids/parameter_grid.zarr}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR:-${RUN_ROOT}/outputs/zarr/synthesized_spectra.zarr}}"
SHARD_TEMPLATE="${SHARD_TEMPLATE:-${CFG_SHARD_TEMPLATE:-${RUN_ROOT}/outputs/shards/spectra_shard_\{shard_index\}.zarr}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR:-${RUN_ROOT}/outputs/shards}}"

if [[ "${GRID_ZARR}" != /* ]]; then GRID_ZARR="${REPO}/${GRID_ZARR}"; fi
if [[ "${SHARDS_DIR}" != /* ]]; then SHARDS_DIR="${REPO}/${SHARDS_DIR}"; fi
if [[ "${MERGED_ZARR}" != /* ]]; then MERGED_ZARR="${REPO}/${MERGED_ZARR}"; fi

LOG_DIR="${LOG_DIR:-${RUN_ROOT}/logs}"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"
MISSING_FILE="${MISSING_FILE:-${RUN_ROOT}/missing_shards.txt}"
PENDING_SHARDS_FILE="${PENDING_SHARDS_FILE:-${RUN_ROOT}/pending_shards.txt}"
NEXT_WORK_ITEM="${NEXT_WORK_ITEM:-${RUN_ROOT}/next_work_item.txt}"
LOCK_FILE="${LOCK_FILE:-${RUN_ROOT}/counter.lock}"
CONSECUTIVE_FAILURE_ABORT_THRESHOLD="${CONSECUTIVE_FAILURE_ABORT_THRESHOLD:-${INITIAL_FAILURE_ABORT_THRESHOLD:-10}}"
CONSECUTIVE_FAILURE_COUNT_FILE="${CONSECUTIVE_FAILURE_COUNT_FILE:-${RUN_ROOT}/consecutive_failure_count.txt}"
SUCCESS_COUNT_FILE="${SUCCESS_COUNT_FILE:-${RUN_ROOT}/success_count.txt}"
EARLY_STOP_MARKER="${EARLY_STOP_MARKER:-${RUN_ROOT}/early_stop_marker.txt}"

mkdir -p "${LOG_DIR}" "${SHARDS_DIR}" "$(dirname "${MERGED_ZARR}")" \
         "$(dirname "${NEXT_WORK_ITEM}")" "$(dirname "${LOCK_FILE}")" \
         "$(dirname "${PENDING_SHARDS_FILE}")" "$(dirname "${MISSING_FILE}")" \
         "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}" \
         "$(dirname "${CONSECUTIVE_FAILURE_COUNT_FILE}")" "$(dirname "${SUCCESS_COUNT_FILE}")" \
         "$(dirname "${EARLY_STOP_MARKER}")"

export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

############################################
# Normalize NLTE info-file paths
############################################
# BSYN concatenates the atom/departure directory with the entry filename
# without inserting a separator, so every directory line in the NLTE info
# file must end with '/'. Rewrite the referenced info file(s) in place when
# needed — safe because these lines are documented as bare directories.

NLTE_INFO_FILE_FROM_CFG="$(
    "${PYTHON}" - <<PY
import json, os
cfg_path = os.path.abspath(r"${CONFIG_PATH}")
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
nlte = cfg.get("nlte") or {}
info = str(nlte.get("nlte_info_file", "") or "").strip()
if info:
    if not os.path.isabs(info):
        info = os.path.abspath(os.path.join(os.path.dirname(cfg_path), info))
    print(info)
PY
)"

NLTE_INFO_CANDIDATES=()
if [[ -n "${NLTE_INFO_FILE_FROM_CFG}" ]]; then
    NLTE_INFO_CANDIDATES+=("${NLTE_INFO_FILE_FROM_CFG}")
fi
NLTE_INFO_CANDIDATES+=("${REPO}/DATA/SPECIES_LTE_NLTE.dat")

for _info_file in "${NLTE_INFO_CANDIDATES[@]}"; do
    [[ -f "${_info_file}" ]] || continue
    "${PYTHON}" - "${_info_file}" "${TAG}" <<'PY'
import os
import sys

info_path = sys.argv[1]
tag = sys.argv[2]

with open(info_path, "r", encoding="utf-8") as handle:
    lines = handle.readlines()

HEADERS = ("# path for model atom files", "# path for departure files")
modified_headers: list[str] = []
idx = 0
while idx < len(lines):
    stripped = lines[idx].strip()
    if any(stripped.startswith(h) for h in HEADERS):
        header = stripped
        j = idx + 1
        while j < len(lines):
            candidate = lines[j]
            candidate_stripped = candidate.strip()
            if candidate_stripped and not candidate_stripped.startswith("#"):
                if not candidate_stripped.endswith(("/", os.sep)):
                    trailing_nl = "\n" if candidate.endswith("\n") else ""
                    lines[j] = f"{candidate_stripped}/{trailing_nl}"
                    modified_headers.append(header)
                break
            j += 1
        idx = j + 1
        continue
    idx += 1

if modified_headers:
    with open(info_path, "w", encoding="utf-8") as handle:
        handle.writelines(lines)
    print(
        f"[{tag}] Normalized NLTE info file (added trailing '/' to "
        f"{len(modified_headers)} path line(s)): {info_path}",
        file=sys.stderr,
    )
PY
done
unset _info_file

############################################
# Grid – create if missing (with lock for
# array-task safety)
############################################

JOB_ID_BASE="${PBS_JOBID:-manual}"
JOB_ID_BASE="${JOB_ID_BASE%%[*}"
GRID_PREP_LOCK_DIR="${RUN_ROOT}/.grid_prepare_${JOB_ID_BASE}.lock"
GRID_PREP_MARKER="${RUN_ROOT}/.grid_prepare_${JOB_ID_BASE}.done"
GRID_PREP_FAILURE="${RUN_ROOT}/.grid_prepare_${JOB_ID_BASE}.failed"
GRID_PREP_TIMEOUT="${GRID_PREP_TIMEOUT:-3600}"

is_valid_grid_zarr() {
    [[ -d "$1" ]] && "${PYTHON}" -c "
import zarr, sys
try:
    root = zarr.open_group(r'$1', mode='r')
    assert 'teff' in root or 'params' in root or 'global_index' in root
except Exception:
    sys.exit(1)
" 2>/dev/null
}

generate_grid_locked() {
    echo "[${TAG}] Grid not found; generating grid (num_samples=${CFG_NUM_SAMPLES:-?})."
    "${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
        --config "${CONFIG_PATH}" \
        --skip-synthesis
}

if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" && "${FINALIZE_ONLY_EFFECTIVE}" != "1" ]]; then
    # FORCE_RESTART drops the grid readiness marker in every task so no one short-circuits
    # on a stale grid. The actual grid zarr wipe happens in the lock-winner path (array
    # mode) or the single-job path below, so only one task deletes the directory.
    rm -f "${GRID_PREP_MARKER}" "${GRID_PREP_FAILURE}"
fi

if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]]; then
    # Finalize mode: grid must already exist.
    if ! is_valid_grid_zarr "${GRID_ZARR}"; then
        echo "[${TAG}] ERROR: grid zarr not found: ${GRID_ZARR}" >&2
        exit 1
    fi
elif (( ARRAY_TASK_MODE == 1 )); then
    # Array mode: exactly one task generates the grid, others wait.
    _grid_ready=0
    if [[ -f "${GRID_PREP_MARKER}" ]] && is_valid_grid_zarr "${GRID_ZARR}"; then
        _grid_ready=1
    fi

    if (( _grid_ready == 0 )); then
        if [[ -f "${GRID_PREP_FAILURE}" ]]; then
            echo "[${TAG}] ERROR: grid preparation previously failed; see ${GRID_PREP_FAILURE}." >&2
            exit 1
        fi

        if mkdir "${GRID_PREP_LOCK_DIR}" 2>/dev/null; then
            # We won the lock — generate the grid.
            echo "[${TAG}] Array task ${PBS_ARRAY_INDEX:-?} acquired grid-preparation lock."
            rm -f "${GRID_PREP_FAILURE}"
            if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" ]]; then
                echo "[${TAG}] FORCE_RESTART: removing existing grid zarr to force regeneration."
                rm -rf "${GRID_ZARR}"
            fi
            _prep_rc=0
            if ! is_valid_grid_zarr "${GRID_ZARR}"; then
                generate_grid_locked || _prep_rc=$?
            fi
            if (( _prep_rc == 0 )) && is_valid_grid_zarr "${GRID_ZARR}"; then
                date '+%Y-%m-%dT%H:%M:%S%z' > "${GRID_PREP_MARKER}"
                rmdir "${GRID_PREP_LOCK_DIR}" 2>/dev/null || true
            else
                echo "prepare_failed_at=$(date '+%Y-%m-%dT%H:%M:%S%z')" > "${GRID_PREP_FAILURE}"
                rmdir "${GRID_PREP_LOCK_DIR}" 2>/dev/null || true
                echo "[${TAG}] ERROR: grid preparation failed." >&2
                exit 1
            fi
        else
            # Another task holds the lock — wait for it.
            echo "[${TAG}] Array task ${PBS_ARRAY_INDEX:-?} waiting for grid preparation..."
            _waited=0
            while (( _waited < GRID_PREP_TIMEOUT )); do
                if [[ -f "${GRID_PREP_MARKER}" ]] && is_valid_grid_zarr "${GRID_ZARR}"; then
                    break
                fi
                if [[ -f "${GRID_PREP_FAILURE}" ]]; then
                    echo "[${TAG}] ERROR: grid preparation failed in another task." >&2
                    exit 1
                fi
                sleep 5
                _waited=$((_waited + 5))
            done
            if ! is_valid_grid_zarr "${GRID_ZARR}"; then
                echo "[${TAG}] ERROR: timed out waiting for grid preparation (${GRID_PREP_TIMEOUT}s)." >&2
                exit 1
            fi
        fi
    fi
else
    # Single-job mode: generate directly.
    if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" ]]; then
        echo "[${TAG}] FORCE_RESTART: removing existing grid zarr to force regeneration."
        rm -rf "${GRID_ZARR}"
    fi
    if ! is_valid_grid_zarr "${GRID_ZARR}"; then
        generate_grid_locked
    fi
fi

if ! is_valid_grid_zarr "${GRID_ZARR}"; then
    echo "[${TAG}] ERROR: grid zarr not found or invalid after generation: ${GRID_ZARR}" >&2
    exit 1
fi

if [[ "${SKIP_SYNTHESIS_EFFECTIVE}" == "1" ]]; then
    echo "[${TAG}] SKIP_SYNTHESIS=1: grid prepared at ${GRID_ZARR}; skipping synthesis and merge."
    exit 0
fi

############################################
# Shard layout
############################################

ROWS_PER_SHARD_RAW="${ROWS_PER_SHARD_OVERRIDE:-${CFG_ROWS_PER_SHARD:-}}"
SHARD_COUNT_RAW="${SHARD_COUNT_OVERRIDE:-${CFG_SHARD_COUNT:-}}"

# For array jobs: infer SHARD_COUNT from the PBS array range when not
# explicitly set.  PBS Pro on Gadi exposes PBS_ARRAY_INDEX per task but
# not the total range, so we parse it from PBS_JOBID (e.g. "12345[0-99].gadi-pbs").
if (( ARRAY_TASK_MODE == 1 )) && [[ -z "${SHARD_COUNT_RAW}" ]]; then
    _array_max="$("${PYTHON}" -c "
import re, sys
m = re.search(r'\[(\d+)-(\d+)\]', sys.argv[1])
print(int(m.group(2)) + 1 if m else '')
" "${PBS_JOBID:-}" 2>/dev/null || echo "")"
    if [[ -n "${_array_max}" && "${_array_max}" =~ ^[0-9]+$ ]] && (( _array_max > 0 )); then
        SHARD_COUNT_RAW="${_array_max}"
        echo "[${TAG}] Inferred SHARD_COUNT=${_array_max} from PBS array range in PBS_JOBID."
    fi
fi

# When FINALIZE_ONLY and no explicit layout, infer from saved layout or
# existing shard directories.
SHARD_LAYOUT_FILE="${SHARDS_DIR}/.shard_layout"
if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" && -z "${SHARD_COUNT_OVERRIDE}" && -z "${ROWS_PER_SHARD_RAW}" && -z "${CFG_SHARD_COUNT}" ]]; then
    if [[ -f "${SHARD_LAYOUT_FILE}" ]]; then
        read _saved_sc _saved_rps < "${SHARD_LAYOUT_FILE}" 2>/dev/null || true
        if [[ "${_saved_sc}" =~ ^[0-9]+$ && "${_saved_rps}" =~ ^[0-9]+$ ]]; then
            SHARD_COUNT_RAW="${_saved_sc}"
            ROWS_PER_SHARD_RAW="${_saved_rps}"
            echo "[${TAG}] FINALIZE_ONLY: restored shard layout from ${SHARD_LAYOUT_FILE}: SHARD_COUNT=${_saved_sc} ROWS_PER_SHARD=${_saved_rps}"
        fi
    fi
    if [[ -z "${SHARD_COUNT_RAW}" ]]; then
        _inferred_sc="$("${PYTHON}" -c "
import re, sys
from pathlib import Path
shard_dir = Path(sys.argv[1])
indices = sorted(
    int(m.group(1))
    for p in shard_dir.glob('spectra_shard_*.zarr')
    if (m := re.match(r'spectra_shard_(\d+)\.zarr', p.name))
)
print(max(indices) + 1 if indices else '')
" "${SHARDS_DIR}" 2>/dev/null || echo "")"
        if [[ -n "${_inferred_sc}" && "${_inferred_sc}" =~ ^[0-9]+$ ]] && (( _inferred_sc > 0 )); then
            SHARD_COUNT_RAW="${_inferred_sc}"
            echo "[${TAG}] FINALIZE_ONLY: inferred SHARD_COUNT=${_inferred_sc} from existing shard files."
        fi
    fi
fi

DEFAULT_ROWS_PER_SHARD="${DEFAULT_ROWS_PER_SHARD:-128}"

if [[ -f "${LAYOUT_HELPER}" ]]; then
    LAYOUT_CMD=(
        "${PYTHON}" "${LAYOUT_HELPER}"
        --zarr-path "${GRID_ZARR}"
        --row-keys "teff,params,global_index"
        --default-rows-per-shard "${DEFAULT_ROWS_PER_SHARD}"
    )
    if [[ -n "${ROWS_PER_SHARD_RAW}" ]]; then
        LAYOUT_CMD+=(--rows-per-shard "${ROWS_PER_SHARD_RAW}")
    fi
    if [[ -n "${SHARD_COUNT_RAW}" ]]; then
        LAYOUT_CMD+=(--shard-count "${SHARD_COUNT_RAW}")
    fi
    LAYOUT_OUTPUT="$("${LAYOUT_CMD[@]}")"
    while IFS='=' read -r key value; do
        case "${key}" in
            ROW_COUNT) ROW_COUNT="${value}" ;;
            ROWS_PER_SHARD) ROWS_PER_SHARD="${value}" ;;
            SHARD_COUNT) SHARD_COUNT="${value}" ;;
            ARRAY_RANGE) ARRAY_RANGE="${value}" ;;
        esac
    done <<< "${LAYOUT_OUTPUT}"
else
    # Fallback: infer row count from grid zarr directly.
    ROW_COUNT="$("${PYTHON}" -c "
import zarr
root = zarr.open_group(r'${GRID_ZARR}', mode='r')
for key in ('teff', 'params', 'global_index'):
    if key in root and len(root[key].shape) >= 1:
        print(int(root[key].shape[0]))
        break
else:
    raise RuntimeError('Could not infer row count')
")"
    if [[ -n "${ROWS_PER_SHARD_RAW}" ]]; then
        ROWS_PER_SHARD="${ROWS_PER_SHARD_RAW}"
    fi
    if [[ -n "${SHARD_COUNT_RAW}" ]]; then
        SHARD_COUNT="${SHARD_COUNT_RAW}"
    elif [[ -n "${ROWS_PER_SHARD}" ]]; then
        SHARD_COUNT=$(( (ROW_COUNT + ROWS_PER_SHARD - 1) / ROWS_PER_SHARD ))
    else
        ROWS_PER_SHARD="${DEFAULT_ROWS_PER_SHARD}"
        SHARD_COUNT=$(( (ROW_COUNT + ROWS_PER_SHARD - 1) / ROWS_PER_SHARD ))
    fi
    if [[ -z "${ROWS_PER_SHARD:-}" ]]; then
        ROWS_PER_SHARD=$(( (ROW_COUNT + SHARD_COUNT - 1) / SHARD_COUNT ))
    fi
    ARRAY_RANGE="0-$((SHARD_COUNT - 1))"
fi

if ! [[ "${ROW_COUNT:-}" =~ ^[0-9]+$ ]] || (( ROW_COUNT < 1 )); then
    echo "[${TAG}] ERROR: could not determine grid row count." >&2
    exit 1
fi
if ! [[ "${SHARD_COUNT:-}" =~ ^[0-9]+$ ]] || (( SHARD_COUNT < 1 )); then
    echo "[${TAG}] ERROR: could not determine shard count. Provide SHARD_COUNT or ROWS_PER_SHARD." >&2
    exit 1
fi
if (( SHARD_COUNT > ROW_COUNT )); then
    SHARD_COUNT="${ROW_COUNT}"
fi

# Persist layout so FINALIZE_ONLY can restore it later.
if [[ "${FINALIZE_ONLY_EFFECTIVE}" != "1" ]]; then
    echo "${SHARD_COUNT} ${ROWS_PER_SHARD}" > "${SHARD_LAYOUT_FILE}"
fi

# Optionally drop shards whose layout no longer matches before resume/merge.
# Array tasks never prune (would race across tasks); only single-job/finalize.
if (( ARRAY_TASK_MODE == 0 )) \
    && [[ "$(to_bool01 "${AUTO_PRUNE_STALE_SHARDS}")" == "1" ]] \
    && [[ -n "${SHARDS_DIR}" && "${SHARDS_DIR}" != "/" ]]; then
    echo "[${TAG}] AUTO_PRUNE_STALE_SHARDS=1: pruning layout-incompatible shards in ${SHARDS_DIR}..."
    prune_incompatible_shards || echo "[${TAG}] WARN: shard pruning encountered an error (continuing)." >&2
fi

echo "[${TAG}] Repo: ${REPO}"
echo "[${TAG}] Config: ${CONFIG_PATH}"
echo "[${TAG}] Run root: ${RUN_ROOT}"
echo "[${TAG}] Grid: ${GRID_ZARR}"
echo "[${TAG}] Merged: ${MERGED_ZARR}"
echo "[${TAG}] Shards: ${SHARDS_DIR}"
echo "[${TAG}] Log dir: ${LOG_DIR}"
echo "[${TAG}] Grid rows: ${ROW_COUNT}"
echo "[${TAG}] Rows per shard: ${ROWS_PER_SHARD}"
echo "[${TAG}] Shard count: ${SHARD_COUNT}"
echo "[${TAG}] Array range: ${ARRAY_RANGE}"
echo "[${TAG}] Workers: ${WORKERS}"
echo "[${TAG}] Validate workers: ${VALIDATE_WORKERS}"
echo "[${TAG}] Merge chunk rows: ${MERGE_CHUNK_ROWS}"

############################################
# ARRAY TASK MODE
############################################

if (( ARRAY_TASK_MODE == 1 )); then
    SHARD_INDEX="${PBS_ARRAY_INDEX}"
    if (( SHARD_INDEX >= SHARD_COUNT )); then
        echo "[${TAG}] Array task ${SHARD_INDEX} is outside SHARD_COUNT=${SHARD_COUNT}; exiting cleanly."
        exit 0
    fi

    SCRATCH="${TMP_WORK_DIR}/shard_${SHARD_INDEX}"
    TMP_OUT="${TMP_OUTPUT_DIR}/spectra_shard_${SHARD_INDEX}.tmp.zarr"
    LOG_FILE="${LOG_DIR}/shard_${SHARD_INDEX}.log"
    mkdir -p "${SCRATCH}"

    echo "[${TAG}] Shard index: ${SHARD_INDEX}"
    echo "[${TAG}] Scratch: ${SCRATCH}"

    no_scratch_flag=""
    if [[ "$(to_bool01 "${NO_SCRATCH}")" -eq 1 ]]; then
        no_scratch_flag="--no-scratch"
    fi

    _array_synth_rc=0
    "${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
        --config "${CONFIG_PATH}" \
        --skip-grid \
        --synthesis-mode sharded \
        --shard-index "${SHARD_INDEX}" \
        --shard-count "${SHARD_COUNT}" \
        --scratch "${SCRATCH}" \
        --output "${TMP_OUT}" \
        ${no_scratch_flag} \
        2>&1 | tee "${LOG_FILE}" || _array_synth_rc=$?

    rm -rf "${SCRATCH}"
    if (( _array_synth_rc != 0 )); then
        print_log_excerpt "${LOG_FILE}" "Array shard ${SHARD_INDEX} failed; log excerpt"
        echo "[${TAG}] ERROR: array shard ${SHARD_INDEX} synthesis failed (rc=${_array_synth_rc})." >&2
        exit "${_array_synth_rc}"
    fi
    # Array tasks exit here; submit a FINALIZE_ONLY job after all tasks complete.
    exit 0
fi

############################################
# SINGLE-JOB MODE – worker pool
############################################

########################################
# Missing-shards helper (defined before
# FINALIZE_ONLY branch so finalize can
# use it)
########################################

write_missing_shards_file() {
    "${PYTHON}" - <<PY
import re
import sys
from pathlib import Path

import numpy as np
import zarr

shard_dir = Path(r"${SHARDS_DIR}")
expected_shards = int(r"${SHARD_COUNT}")
row_count = int(r"${ROW_COUNT}")
drop_failed = r"${DROP_FAILED_ROWS:-0}" in ("1", "true", "True", "yes")
out_path = Path(r"${MISSING_FILE}")
out_path.parent.mkdir(parents=True, exist_ok=True)

pattern = re.compile(r"^spectra_shard_(\d+)\.zarr$")
seen: set[int] = set()
for shard_path in sorted(shard_dir.glob("spectra_shard_*.zarr")):
    match = pattern.match(shard_path.name)
    if match is None:
        continue
    shard_idx = int(match.group(1))
    if shard_idx < 0 or shard_idx >= expected_shards:
        continue
    try:
        root = zarr.open_group(str(shard_path), mode="r")
    except Exception:
        continue
    for key in ("global_index", "flux", "status", "message"):
        if key not in root:
            root = None
            break
    if root is None:
        continue
    try:
        gidx = np.asarray(root["global_index"][:], dtype=np.int64)
        flux = np.asarray(root["flux"][:], dtype=np.float32)
        status = np.asarray(root["status"][:])
    except Exception:
        continue
    if gidx.ndim != 1 or gidx.size == 0:
        continue
    if flux.ndim != 2 or flux.shape[0] != gidx.size:
        continue
    if status.ndim != 1 or status.shape[0] != gidx.size:
        continue
    if np.any(gidx < 0) or np.any(gidx >= row_count):
        continue
    if np.unique(gidx).size != gidx.size:
        continue
    # When drop_failed is active, only require success rows to have finite flux.
    statuses = []
    for item in status.tolist():
        if isinstance(item, (bytes, bytearray)):
            item = item.decode("utf-8", errors="ignore")
        statuses.append(str(item).strip().lower())
    success_statuses = {"success", "skipped"}
    if drop_failed:
        success_mask = np.array([s in success_statuses for s in statuses], dtype=bool)
        if success_mask.any() and not np.all(np.isfinite(flux[success_mask])):
            continue
    else:
        if not np.all(np.isfinite(flux)):
            continue
        if any(s not in success_statuses for s in statuses):
            continue
    seen.add(shard_idx)

missing = sorted(set(range(expected_shards)) - seen)
text = "\n".join(str(x) for x in missing)
out_path.write_text(f"{text}\n" if text else "", encoding="utf-8")
print(
    f"[missing-shards] expected={expected_shards} valid={len(seen)} missing={len(missing)} stores={len(list(shard_dir.glob('spectra_shard_*.zarr')))}",
    file=sys.stderr,
)
PY
}

if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]]; then
    echo "[${TAG}] FINALIZE_ONLY=1: skipping synthesis."
else

    ########################################
    # Walltime guard
    ########################################

    walltime_to_seconds() {
        local raw="$1"
        if [[ -z "${raw}" ]]; then echo ""; return 0; fi
        if [[ "${raw}" =~ ^[0-9]+$ ]]; then echo "${raw}"; return 0; fi
        if [[ "${raw}" =~ ^([0-9]+):([0-9]{2}):([0-9]{2})$ ]]; then
            echo $((10#${BASH_REMATCH[1]} * 3600 + 10#${BASH_REMATCH[2]} * 60 + 10#${BASH_REMATCH[3]}))
            return 0
        fi
        echo ""
    }

    WALLTIME_RAW="${WALLTIME_SECONDS:-${PBS_WALLTIME:-${PBS_RESOURCE_LIST_WALLTIME:-}}}"
    WALLTIME_SECONDS="$(walltime_to_seconds "${WALLTIME_RAW}")"
    if ! [[ "${WALLTIME_SECONDS}" =~ ^[0-9]+$ ]] || (( WALLTIME_SECONDS < 1 )); then
        WALLTIME_SECONDS=$((12*3600))
        echo "[${TAG}] WARN: could not parse walltime from '${WALLTIME_RAW:-<unset>}' — defaulting to ${WALLTIME_SECONDS}s." >&2
    fi
    START_TIME=$(date +%s)

    SAFETY_BUFFER="${SAFETY_BUFFER:-900}"
    EST_RUNTIME="${EST_RUNTIME:-600}"
    SHARD_RETRY_ATTEMPTS="${SHARD_RETRY_ATTEMPTS:-3}"

    time_left() { echo $((WALLTIME_SECONDS - ($(date +%s) - START_TIME))); }

    consecutive_failure_stop_enabled() {
        [[ "${CONSECUTIVE_FAILURE_ABORT_THRESHOLD}" =~ ^[0-9]+$ ]] && (( CONSECUTIVE_FAILURE_ABORT_THRESHOLD > 0 ))
    }

    initialize_initial_failure_tracking() {
        local completed_count="${1:-0}"
        if ! consecutive_failure_stop_enabled; then return; fi
        printf '0\n' > "${CONSECUTIVE_FAILURE_COUNT_FILE}"
        printf '%s\n' "${completed_count}" > "${SUCCESS_COUNT_FILE}"
        rm -f "${EARLY_STOP_MARKER}"
    }

    record_shard_outcome() {
        local shard="$1" outcome="$2" log_file="$3"
        if ! consecutive_failure_stop_enabled; then return; fi

        exec 8<>"${LOCK_FILE}"
        flock -x 8
        local success_count failure_count
        success_count="$(cat "${SUCCESS_COUNT_FILE}" 2>/dev/null || printf '0')"
        failure_count="$(cat "${CONSECUTIVE_FAILURE_COUNT_FILE}" 2>/dev/null || printf '0')"
        [[ "${success_count}" =~ ^[0-9]+$ ]] || success_count=0
        [[ "${failure_count}" =~ ^[0-9]+$ ]] || failure_count=0

        if [[ "${outcome}" == "success" ]]; then
            success_count=$((success_count + 1))
            printf '%s\n' "${success_count}" > "${SUCCESS_COUNT_FILE}"
            printf '0\n' > "${CONSECUTIVE_FAILURE_COUNT_FILE}"
        else
            failure_count=$((failure_count + 1))
            printf '%s\n' "${failure_count}" > "${CONSECUTIVE_FAILURE_COUNT_FILE}"
            if (( failure_count >= CONSECUTIVE_FAILURE_ABORT_THRESHOLD )) && [[ ! -f "${EARLY_STOP_MARKER}" ]]; then
                {
                    printf 'reason=consecutive_failure_threshold_reached\n'
                    printf 'threshold=%s\n' "${CONSECUTIVE_FAILURE_ABORT_THRESHOLD}"
                    printf 'failure_count=%s\n' "${failure_count}"
                    printf 'success_count=%s\n' "${success_count}"
                    printf 'last_shard=%s\n' "${shard}"
                    printf 'last_log=%s\n' "${log_file}"
                    printf 'timestamp=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"
                } > "${EARLY_STOP_MARKER}"
                {
                    printf '[%s] EARLY STOP: %s consecutive failures; threshold=%s; last_shard=%s; log=%s\n' \
                        "${TAG}" "${failure_count}" "${CONSECUTIVE_FAILURE_ABORT_THRESHOLD}" "${shard}" "${log_file}"
                    if [[ -f "${log_file}" ]]; then
                        printf '[%s] Last error excerpt from %s:\n' "${TAG}" "${log_file}"
                        if grep -Einq 'error|failed|exception|missing spectrum|traceback|forrtl|stop|log=' "${log_file}"; then
                            grep -Ein 'error|failed|exception|missing spectrum|traceback|forrtl|stop|log=' "${log_file}" | tail -n 40
                        else
                            tail -n 40 "${log_file}"
                        fi
                    fi
                } >> "${LOG_DIR}/early_stop.log"
            fi
        fi
        flock -u 8
        exec 8>&-
    }

    should_stop_early() {
        consecutive_failure_stop_enabled && [[ -f "${EARLY_STOP_MARKER}" ]]
    }

    run_shard_attempts() {
        local shard="$1" max_attempts="$2" scratch_root="$3" log_file="$4" sleep_base="$5"
        local tmp_out="${TMP_OUTPUT_DIR}/spectra_shard_${shard}.a$$.tmp.zarr"

        for ((attempt=1; attempt<=max_attempts; attempt++)); do
            local start end attempt_scratch
            start=$(date +%s)
            attempt_scratch="${scratch_root}/shard_${shard}_a${attempt}"
            mkdir -p "${attempt_scratch}"

            local no_scratch_flag=""
            if [[ "$(to_bool01 "${NO_SCRATCH}")" -eq 1 ]]; then
                no_scratch_flag="--no-scratch"
            fi

            if "${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
                --config "${CONFIG_PATH}" \
                --skip-grid \
                --synthesis-mode sharded \
                --shard-index "${shard}" \
                --shard-count "${SHARD_COUNT}" \
                --workers 1 \
                --scratch "${attempt_scratch}" \
                --output "${tmp_out}" \
                ${no_scratch_flag} \
                >> "${log_file}" 2>&1; then
                end=$(date +%s)
                echo "runtime_seconds=$((end-start)) attempt=${attempt}" >> "${log_file}"
                return 0
            fi

            rm -rf "${tmp_out}"
            sleep $(( (RANDOM % 10) + attempt * sleep_base ))
        done
        return 1
    }

    ########################################
    # Resume setup
    ########################################

    if [[ -z "${SHARDS_DIR}" || "${SHARDS_DIR}" == "/" ]]; then
        echo "[${TAG}] ERROR: unsafe SHARDS_DIR='${SHARDS_DIR}'." >&2
        exit 1
    fi

    if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" ]]; then
        echo "[${TAG}] FORCE_RESTART: clearing previous shard outputs and merged zarr."
        find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' -exec rm -rf {} +
        rm -f "${MISSING_FILE}" "${PENDING_SHARDS_FILE}" "${NEXT_WORK_ITEM}"
        if [[ -d "${MERGED_ZARR}" ]]; then
            rm -rf "${MERGED_ZARR}"
        fi
    fi

    write_missing_shards_file 2>> "${LOG_DIR}/missing.log"
    cp "${MISSING_FILE}" "${PENDING_SHARDS_FILE}"
    PENDING_COUNT=$(wc -l < "${PENDING_SHARDS_FILE}" | tr -d '[:space:]')
    echo 0 > "${NEXT_WORK_ITEM}"

    COMPLETED_COUNT=$((SHARD_COUNT - PENDING_COUNT))
    initialize_initial_failure_tracking "${COMPLETED_COUNT}"
    echo "[${TAG}] Existing valid shards: ${COMPLETED_COUNT}/${SHARD_COUNT}"

    ########################################
    # Worker
    ########################################

    worker() {
        local jobfs_dir task_index shard available
        jobfs_dir="${TMP_WORK_DIR}/worker_${RANDOM}"
        mkdir -p "${jobfs_dir}"

        while true; do
            if should_stop_early; then
                echo "[${TAG}] Early-stop marker detected; worker exiting."
                break
            fi
            if (( $(time_left) < EST_RUNTIME + SAFETY_BUFFER )); then
                echo "[${TAG}] Worker exiting safely before walltime."
                break
            fi

            available=$(df -Pk "${jobfs_dir}" | awk 'NR==2 {print $4}')
            if (( available < 5*1024*1024 )); then
                echo "[${TAG}] Low scratch — sleeping."
                sleep 60
                continue
            fi

            exec 9<>"${LOCK_FILE}"
            flock -x 9
            task_index=$(cat "${NEXT_WORK_ITEM}")
            echo $((task_index + 1)) > "${NEXT_WORK_ITEM}"
            flock -u 9
            exec 9>&-

            if (( task_index >= PENDING_COUNT )); then break; fi

            shard="$(sed -n "$((task_index + 1))p" "${PENDING_SHARDS_FILE}")"
            if [[ -z "${shard}" ]]; then break; fi

            if ! run_shard_attempts "${shard}" "${SHARD_RETRY_ATTEMPTS}" "${jobfs_dir}" "${LOG_DIR}/shard_${shard}.log" 15; then
                echo "Shard ${shard} failed after ${SHARD_RETRY_ATTEMPTS} attempts." >> "${LOG_DIR}/shard_${shard}.log"
                print_log_excerpt "${LOG_DIR}/shard_${shard}.log" "Shard ${shard} failed; log excerpt"
                record_shard_outcome "${shard}" "failure" "${LOG_DIR}/shard_${shard}.log"
                if should_stop_early; then
                    echo "[${TAG}] Early-stop threshold reached after shard ${shard} failure; worker exiting."
                    break
                fi
            else
                record_shard_outcome "${shard}" "success" "${LOG_DIR}/shard_${shard}.log"
            fi
        done
    }

    export -f worker
    export NEXT_WORK_ITEM LOCK_FILE PENDING_COUNT PENDING_SHARDS_FILE SHARD_COUNT LOG_DIR REPO PYTHON PBS_JOBID CONFIG_PATH TMP_OUTPUT_DIR \
           CONSECUTIVE_FAILURE_ABORT_THRESHOLD CONSECUTIVE_FAILURE_COUNT_FILE SUCCESS_COUNT_FILE EARLY_STOP_MARKER TAG

    ########################################
    # Launch workers
    ########################################

    if (( PENDING_COUNT > 0 )); then
        MIN_REQUIRED_SECONDS=$((EST_RUNTIME + SAFETY_BUFFER))
        REMAINING_AT_LAUNCH="$(time_left)"
        if (( REMAINING_AT_LAUNCH < MIN_REQUIRED_SECONDS )); then
            echo "[${TAG}] WARN: only ${REMAINING_AT_LAUNCH}s remain; need ${MIN_REQUIRED_SECONDS}s. No shard attempts will start."
        else
            echo "[${TAG}] Launching ${WORKERS} workers for ${PENDING_COUNT} pending shards..."
            for ((i=0; i<WORKERS; i++)); do
                worker &
            done
            wait
        fi
    else
        echo "[${TAG}] No pending shards; moving to validation/merge."
    fi

    if should_stop_early; then
        echo "[${TAG}] ERROR: early-stop threshold reached; aborting before merge. See ${EARLY_STOP_MARKER}." >&2
        cat "${EARLY_STOP_MARKER}" >&2 || true
        exit 1
    fi

    CURRENT="$(cat "${NEXT_WORK_ITEM}")"
    if (( PENDING_COUNT > 0 && CURRENT == 0 )); then
        echo "[${TAG}] NOTICE: no shards were assigned. The walltime guard likely prevented the first attempt."
    fi
    if (( CURRENT < PENDING_COUNT )); then
        echo "[${TAG}] NOTICE: walltime ended before all shards assigned (${CURRENT}/${PENDING_COUNT})."
    fi

fi  # end of synthesis (single-job or finalize skip)

############################################
# Validation
############################################

echo "[${TAG}] Validating shard outputs..."

# Recount missing shards (needed for both single-job and finalize paths).
write_missing_shards_file 2>> "${LOG_DIR}/missing.log" || true
FINAL_MISSING="$(wc -l < "${MISSING_FILE}" 2>/dev/null | tr -d '[:space:]')"
FINAL_MISSING="${FINAL_MISSING:-0}"

echo "[${TAG}] Missing shard report: ${MISSING_FILE} (count=${FINAL_MISSING})"
if (( FINAL_MISSING > 0 )); then
    echo "First 20 missing shard IDs:"
    head -n 20 "${MISSING_FILE}"
fi

VALIDATE_CMD=(
    "${PYTHON}" "${REPO}/scripts/validate_dataset.py"
    --shard-dir "${SHARDS_DIR}"
    --expected-shards "${SHARD_COUNT}"
    --workers "${VALIDATE_WORKERS}"
)
if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    VALIDATE_CMD+=(--allow-incomplete-provenance)
fi
set +e
"${VALIDATE_CMD[@]}"
VALIDATE_RC=$?
set -e
if (( VALIDATE_RC != 0 )); then
    echo "[${TAG}] WARN: validation exited with code ${VALIDATE_RC}; continuing with merge policy."
fi

############################################
# Merge
############################################

SHARD_STORE_COUNT=$(find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' | wc -l | tr -d '[:space:]')
if (( SHARD_STORE_COUNT == 0 )); then
    echo "[${TAG}] ERROR: no shard stores found in ${SHARDS_DIR}; cannot merge." >&2
    FIRST_SHARD_LOG=""
    if compgen -G "${LOG_DIR}/shard_*.log" > /dev/null; then
        FIRST_SHARD_LOG="$(printf '%s\n' "${LOG_DIR}"/shard_*.log | sort | head -n 1)"
    fi
    if [[ -n "${FIRST_SHARD_LOG}" && -f "${FIRST_SHARD_LOG}" ]]; then
        echo "[${TAG}] First shard log excerpt (${FIRST_SHARD_LOG}):" >&2
        if grep -Fq 'Fix the missing binaries/data paths before rerunning:' "${FIRST_SHARD_LOG}"; then
            grep -Fin -A8 'Fix the missing binaries/data paths before rerunning:' "${FIRST_SHARD_LOG}" | tail -n 40 >&2 || true
        elif grep -Einq 'error|failed|exception|missing spectrum|traceback|forrtl|stop|log=' "${FIRST_SHARD_LOG}"; then
            grep -Ein 'error|failed|exception|missing spectrum|traceback|forrtl|stop|log=' "${FIRST_SHARD_LOG}" | tail -n 80 >&2 || true
        else
            tail -n 120 "${FIRST_SHARD_LOG}" >&2 || true
        fi
    fi
    exit 1
fi

MERGE_CMD=(
    "${PYTHON}" "${REPO}/scripts/merge_spectra_shards.py"
    --shard-dir "${SHARDS_DIR}"
    --grid-zarr "${GRID_ZARR}"
    --output-zarr "${MERGED_ZARR}"
    --chunk-rows "${MERGE_CHUNK_ROWS}"
    --tmp-dir "${TMP_SYSTEM_DIR}"
)

if [[ "$(to_bool01 "${SKIP_BAD_SHARDS}")" == "1" ]]; then
    MERGE_CMD+=(--skip-invalid-shards)
fi

if [[ "$(to_bool01 "${DROP_FAILED_ROWS:-0}")" == "1" ]]; then
    MERGE_CMD+=(--drop-failed-rows)
fi

if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    MERGE_CMD+=(--allow-incomplete-provenance)
fi

if (( FINAL_MISSING > 0 )); then
    if [[ "$(to_bool01 "${ALLOW_PARTIAL_MERGE}")" == "1" ]]; then
        echo "[${TAG}] WARN: missing shards detected; enabling partial merge."
        MERGE_CMD+=(--allow-missing --skip-nonexistent-shards)
    else
        echo "[${TAG}] ERROR: ${FINAL_MISSING} shards still missing; merge aborted." >&2
        exit 1
    fi
fi

echo "[${TAG}] Merging shard outputs..."
"${MERGE_CMD[@]}"
echo "[${TAG}] Merge complete: ${MERGED_ZARR}"

############################################
# Cleanup
############################################

if [[ "$(to_bool01 "${CLEANUP_SHARDS}")" == "1" ]]; then
    if (( FINAL_MISSING > 0 )); then
        # Partial merge: the remaining shards are still needed for a later full
        # merge, so never delete them here regardless of CLEANUP_SHARDS.
        echo "[${TAG}] Partial merge (${FINAL_MISSING} shards missing): keeping shard directory ${SHARDS_DIR}"
    else
        echo "[${TAG}] Cleaning up shard directory: ${SHARDS_DIR}"
        rm -rf "${SHARDS_DIR}"
    fi
fi

if [[ -d "${SCRATCH_TMP_ROOT}" ]]; then
    echo "[${TAG}] Cleaning up scratch tmp: ${SCRATCH_TMP_ROOT}"
    rm -rf "${SCRATCH_TMP_ROOT}"
fi
