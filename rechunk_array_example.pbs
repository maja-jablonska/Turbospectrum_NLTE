#!/bin/bash
#PBS -N rechunk
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l walltime=02:00:00
#PBS -l storage=scratch/y89+scratch/dg97+scratch/mk27+gdata/y89
#PBS -r y
#PBS -j oe
#PBS -m bae

# Rechunk a merged spectra store into the ML layout (scripts/rechunk_zarr.py).
# Replaces rechunk_worker.py + merge_rechunked.py: tasks write straight into
# the final store, so there is no second concatenation copy.
#
#   From a login node — submits init -> array of TASKS -> finalize, chained
#   with afterok dependencies:
#     INPUT_ZARR=/scratch/.../merged.zarr OUTPUT_ZARR=/scratch/.../ml.zarr TASKS=16 \
#         bash rechunk_array_example.pbs
#
#   As one job (small stores):
#     qsub -v INPUT_ZARR=...,OUTPUT_ZARR=...,RECHUNK_STAGE=all rechunk_array_example.pbs
#
# Knobs: TASKS (default 16), QSUB_BIN, PYTHON_BIN / MAMBA_ENV_NAME.
# Array tasks are 0-based (-J 0-(TASKS-1)); extra tasks exit 0.

set -euo pipefail

: "${INPUT_ZARR:?Need INPUT_ZARR}"
: "${OUTPUT_ZARR:?Need OUTPUT_ZARR}"
TASKS="${TASKS:-16}"
QSUB_BIN="${QSUB_BIN:-qsub}"

if [[ -n "${PBS_O_WORKDIR:-}" ]]; then
    REPO="${REPO:-${PBS_O_WORKDIR}}"
else
    REPO="${REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)}"
fi
SCRIPT_PATH="${REPO}/rechunk_array_example.pbs"
# shellcheck source=scripts/pbs_env.sh
source "${REPO}/scripts/pbs_env.sh"
RECHUNK=("${PYTHON}" "${REPO}/scripts/rechunk_zarr.py" -i "${INPUT_ZARR}" -o "${OUTPUT_ZARR}" --tasks "${TASKS}")

if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    "${RECHUNK[@]:0:2}" task "${RECHUNK[@]:2}" --task-index "${PBS_ARRAY_INDEX}"
    exit 0
fi

STAGE="${RECHUNK_STAGE:-}"
if [[ -z "${STAGE}" && -z "${PBS_JOBID:-}" ]]; then
    # Login node: submit the chain.
    VARS="INPUT_ZARR=${INPUT_ZARR},OUTPUT_ZARR=${OUTPUT_ZARR},TASKS=${TASKS},REPO=${REPO}"
    [[ -n "${PYTHON_BIN:-}" ]] && VARS+=",PYTHON_BIN=${PYTHON_BIN}"
    "${RECHUNK[@]:0:2}" plan "${RECHUNK[@]:2}"
    init_id="$("${QSUB_BIN}" -v "${VARS},RECHUNK_STAGE=init" "${SCRIPT_PATH}")"
    array_id="$("${QSUB_BIN}" -W depend=afterok:"${init_id}" -J "0-$((TASKS - 1))" -v "${VARS}" "${SCRIPT_PATH}")"
    final_id="$("${QSUB_BIN}" -W depend=afterok:"${array_id}" -v "${VARS},RECHUNK_STAGE=finalize" "${SCRIPT_PATH}")"
    echo "[rechunk] submitted init=${init_id} tasks=${array_id} finalize=${final_id}"
    exit 0
fi

"${RECHUNK[@]:0:2}" "${STAGE:-all}" "${RECHUNK[@]:2}"
