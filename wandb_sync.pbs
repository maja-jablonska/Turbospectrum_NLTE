#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N wandb-sync
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l jobfs=2GB
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail

cd "${PBS_O_WORKDIR}"

unset PYTHONHOME || true
unset PYTHONPATH || true
# Prevent mixing user-site packages (~/.local) with the activated conda env.
export PYTHONNOUSERSITE=1

MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"
PYTHON_BIN="${PYTHON_BIN:-}"
INCLUDE_OFFLINE="${INCLUDE_OFFLINE:-1}"   # 1/0
INCLUDE_SYNCED="${INCLUDE_SYNCED:-0}"    # 1/0 -> wandb sync --include-synced
SYNC_ALL="${SYNC_ALL:-0}"                 # 1/0 -> wandb sync --sync-all
BEST_EFFORT="${BEST_EFFORT:-1}"           # 1/0
MARK_SYNCED="${MARK_SYNCED:-1}"           # 1/0

# Shared defaults file for Gadi/HPC W&B settings.
WANDB_SETTINGS_FILE="${WANDB_SETTINGS_FILE:-${PBS_O_WORKDIR}/configs/training/wandb_hpc.env}"
if [[ -f "${WANDB_SETTINGS_FILE}" ]]; then
    # shellcheck disable=SC1090
    source "${WANDB_SETTINGS_FILE}"
fi

RUN_DIR="${RUN_DIR:-${PBS_O_WORKDIR}/runs/mlp_wandb}"
WANDB_LOCAL_DIR="${WANDB_LOCAL_DIR:-${RUN_DIR}/wandb}"
WANDB_SYNC_DIR="${WANDB_SYNC_DIR:-${WANDB_LOCAL_DIR}}"
SYNC_DIR="${SYNC_DIR:-${WANDB_SYNC_DIR}}"
WANDB_PROJECT="${WANDB_PROJECT:-}"        # optional filter
WANDB_ENTITY="${WANDB_ENTITY:-}"          # optional for login context

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if ! activate_mamba; then
        echo "[wandb-sync] WARN: could not activate env '${MAMBA_ENV_NAME}', using PATH python." >&2
    fi
    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[wandb-sync] ERROR: python not found." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"

if ! "${PYTHON}" - <<'PY'
import importlib
for name in ("wandb", "pydantic"):
    importlib.import_module(name)
print("[wandb-sync] Dependency preflight OK: wandb, pydantic")
PY
then
    echo "[wandb-sync] ERROR: missing/incompatible Python deps in active env." >&2
    echo "[wandb-sync] Install into env '${MAMBA_ENV_NAME}': python -m pip install 'wandb>=0.17' 'pydantic>=2,<3'" >&2
    exit 1
fi

resolve_sync_dirs() {
    local pattern="$1"
    local -a expanded=()
    local -a normalized=()
    local d

    is_wandb_run_dir() {
        local dir="$1"
        local -a matches
        shopt -s nullglob
        matches=("${dir}"/run-* "${dir}"/offline-run-* "${dir}"/*.wandb)
        shopt -u nullglob
        [[ ${#matches[@]} -gt 0 ]]
    }

    # Expand wildcard patterns (e.g. /path/run*/wandb) if provided.
    if [[ "${pattern}" == *"*"* || "${pattern}" == *"?"* || "${pattern}" == *"["* ]]; then
        shopt -s nullglob
        expanded=( ${pattern} )
        shopt -u nullglob
    else
        expanded=( "${pattern}" )
    fi

    # Normalize user-provided directories to actual W&B sync directories.
    # Common case: user passes /runs/mlp_wandb/runXXX, but W&B data lives in /runXXX/wandb.
    local -a nested=()
    for d in "${expanded[@]}"; do
        [[ -d "${d}" ]] || continue
        if is_wandb_run_dir "${d}"; then
            normalized+=("${d}")
            continue
        fi
        # If the directory itself is named "wandb", treat it as the terminal candidate
        # and do not append another /wandb.
        if [[ "$(basename "${d}")" == "wandb" ]]; then
            if is_wandb_run_dir "${d}"; then
                normalized+=("${d}")
            fi
            continue
        fi
        if [[ -d "${d}/wandb" ]] && is_wandb_run_dir "${d}/wandb"; then
            normalized+=("${d}/wandb")
            continue
        fi
        shopt -s nullglob
        nested=("${d}"/run*/wandb)
        shopt -u nullglob
        if [[ ${#nested[@]} -gt 0 ]]; then
            normalized+=("${nested[@]}")
            continue
        fi
    done

    SYNC_DIRS=()
    for d in "${normalized[@]}"; do
        if [[ -d "${d}" ]]; then
            SYNC_DIRS+=("${d}")
        fi
    done
}

declare -a SYNC_DIRS
resolve_sync_dirs "${SYNC_DIR}"
if [[ ${#SYNC_DIRS[@]} -eq 0 ]]; then
    echo "[wandb-sync] ERROR: no sync directories found for: ${SYNC_DIR}" >&2
    exit 1
fi

collect_sync_inputs() {
    local dir="$1"
    local -n out_ref="$2"
    local -a items=()
    shopt -s nullglob
    items=("${dir}"/offline-run-* "${dir}"/run-* "${dir}"/*.wandb)
    shopt -u nullglob
    if [[ ${#items[@]} -gt 0 ]]; then
        out_ref=("${items[@]}")
    else
        out_ref=("${dir}")
    fi
}

echo "[wandb-sync] Python: ${PYTHON}"
echo "[wandb-sync] Conda prefix: ${CONDA_PREFIX:-<unset>}"
echo "[wandb-sync] Sync dir pattern: ${SYNC_DIR}"
echo "[wandb-sync] Resolved sync dirs: ${#SYNC_DIRS[@]}"
for target_dir in "${SYNC_DIRS[@]}"; do
    echo "[wandb-sync] Target: ${target_dir}"
done
echo "[wandb-sync] Run dir: ${RUN_DIR}"
echo "[wandb-sync] W&B local dir: ${WANDB_LOCAL_DIR}"
echo "[wandb-sync] Include offline: ${INCLUDE_OFFLINE}"
echo "[wandb-sync] Include synced: ${INCLUDE_SYNCED}"
echo "[wandb-sync] Sync all: ${SYNC_ALL}"
echo "[wandb-sync] Mark synced: ${MARK_SYNCED}"
echo "[wandb-sync] Best effort: ${BEST_EFFORT}"

status_any=0
for target_dir in "${SYNC_DIRS[@]}"; do
    declare -a SYNC_INPUTS=()
    collect_sync_inputs "${target_dir}" SYNC_INPUTS

    CMD=("${PYTHON}" -m wandb sync)
    if [[ "${INCLUDE_OFFLINE}" == "1" ]]; then
        CMD+=(--include-offline)
    fi
    if [[ "${INCLUDE_SYNCED}" == "1" ]]; then
        CMD+=(--include-synced)
    fi
    if [[ "${SYNC_ALL}" == "1" ]]; then
        CMD+=(--sync-all)
    fi
    if [[ "${MARK_SYNCED}" == "1" ]]; then
        CMD+=(--mark-synced)
    fi
    if [[ -n "${WANDB_PROJECT}" ]]; then
        CMD+=(--project "${WANDB_PROJECT}")
    fi

    CMD+=("${SYNC_INPUTS[@]}")
    echo "[wandb-sync] Command: ${CMD[*]}"

    if [[ "${BEST_EFFORT}" == "1" ]]; then
        "${CMD[@]}" || {
            status=$?
            status_any="${status}"
            echo "[wandb-sync] WARN: sync failed for ${target_dir} with exit code ${status}" >&2
        }
    else
        "${CMD[@]}"
    fi
done

if [[ "${BEST_EFFORT}" == "1" && "${status_any}" -ne 0 ]]; then
    exit 0
fi

echo "[wandb-sync] Sync completed."
