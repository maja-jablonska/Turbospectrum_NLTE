#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N wandb-sync
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l jobfs=2GB
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail

cd "${PBS_O_WORKDIR}"

unset PYTHONHOME || true
unset PYTHONPATH || true

MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"
PYTHON_BIN="${PYTHON_BIN:-}"
SYNC_DIR="${SYNC_DIR:-${PBS_O_WORKDIR}/runs/mlp_wandb}"
INCLUDE_OFFLINE="${INCLUDE_OFFLINE:-1}"   # 1/0
SYNC_ALL="${SYNC_ALL:-0}"                 # 1/0 -> wandb sync --sync-all
BEST_EFFORT="${BEST_EFFORT:-1}"           # 1/0
MARK_SYNCED="${MARK_SYNCED:-1}"           # 1/0
WANDB_PROJECT="${WANDB_PROJECT:-}"        # optional filter
WANDB_ENTITY="${WANDB_ENTITY:-}"          # optional for login context

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if ! activate_mamba; then
        echo "[wandb-sync] WARN: could not activate env '${MAMBA_ENV_NAME}', using PATH python." >&2
    fi
    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[wandb-sync] ERROR: python not found." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"

if [[ ! -d "${SYNC_DIR}" ]]; then
    echo "[wandb-sync] ERROR: SYNC_DIR not found: ${SYNC_DIR}" >&2
    exit 1
fi

echo "[wandb-sync] Python: ${PYTHON}"
echo "[wandb-sync] Conda prefix: ${CONDA_PREFIX:-<unset>}"
echo "[wandb-sync] Sync dir: ${SYNC_DIR}"
echo "[wandb-sync] Include offline: ${INCLUDE_OFFLINE}"
echo "[wandb-sync] Sync all: ${SYNC_ALL}"
echo "[wandb-sync] Mark synced: ${MARK_SYNCED}"
echo "[wandb-sync] Best effort: ${BEST_EFFORT}"

CMD=("${PYTHON}" -m wandb sync)
if [[ "${INCLUDE_OFFLINE}" == "1" ]]; then
    CMD+=(--include-offline)
fi
if [[ "${SYNC_ALL}" == "1" ]]; then
    CMD+=(--sync-all)
fi
if [[ "${MARK_SYNCED}" == "1" ]]; then
    CMD+=(--mark-synced)
fi
if [[ -n "${WANDB_PROJECT}" ]]; then
    CMD+=(--project "${WANDB_PROJECT}")
fi

CMD+=("${SYNC_DIR}")

echo "[wandb-sync] Command: ${CMD[*]}"

if [[ "${BEST_EFFORT}" == "1" ]]; then
    "${CMD[@]}" || {
        status=$?
        echo "[wandb-sync] WARN: sync failed with exit code ${status}" >&2
        exit 0
    }
else
    "${CMD[@]}"
fi

echo "[wandb-sync] Sync completed."

