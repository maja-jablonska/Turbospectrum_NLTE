#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N ts-regular-grid
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail
cd "${PBS_O_WORKDIR}"

############################################
# Thread caps (prevent oversubscription)
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

# Prevent mixed-prefix Python startup failures on HPC nodes.
unset PYTHONHOME || true
unset PYTHONPATH || true

############################################
# Environment activation
############################################

PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[regular-grid] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[regular-grid] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[regular-grid] Python: ${PYTHON}"
echo "[regular-grid] Mamba env: ${MAMBA_ENV_NAME}"
echo "[regular-grid] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Paths + runtime knobs
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
RUN_ROOT="${RUN_ROOT:-/scratch/${PROJECT}/${USER_ID}/turbospec_regular}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_regular_grid.example.json}"
WORKERS="${WORKERS:-${PBS_NCPUS:-32}}"
SKIP_SYNTHESIS="${SKIP_SYNTHESIS:-0}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO="$(cd "${REPO}" >/dev/null 2>&1 && pwd)"

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[regular-grid] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

RUN_CONFIG_DIR="${RUN_ROOT}/config"
LOG_DIR="${RUN_ROOT}/logs"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"
mkdir -p "${RUN_CONFIG_DIR}" "${LOG_DIR}" "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}"

# Force mkstemp()/tempfile users to write under designated scratch temp.
export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

JOB_CONFIG_PATH="${RUN_CONFIG_DIR}/config_regular_grid.${PBS_JOBID}.json"

"${PYTHON}" - <<PY
import json
import os

src = os.path.abspath(r"${CONFIG_PATH}")
dst = os.path.abspath(r"${JOB_CONFIG_PATH}")
repo = os.path.abspath(r"${REPO}")
run_root = os.path.abspath(r"${RUN_ROOT}")
workers = int(r"${WORKERS}")
skip_synthesis = str(r"${SKIP_SYNTHESIS}").strip().lower() in {"1", "true", "yes", "on"}
tmp_work = os.path.abspath(r"${TMP_WORK_DIR}")
tmp_output = os.path.abspath(r"${TMP_OUTPUT_DIR}")
log_dir = os.path.abspath(r"${LOG_DIR}")

with open(src, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)

cfg_dir = os.path.dirname(src)
outputs = cfg.setdefault("outputs", {})
outputs["run_root"] = run_root
outputs["grid_csv"] = os.path.join(run_root, "outputs", "grids", "regular_parameter_grid.csv")
outputs["grid_zarr"] = os.path.join(run_root, "outputs", "grids", "regular_parameter_grid.zarr")
outputs["spectra_zarr"] = os.path.join(run_root, "outputs", "zarr", "regular_synthesized_spectra.zarr")

runtime = cfg.setdefault("runtime", {})
runtime["workers"] = workers
runtime.setdefault("chunk_rows", 32)
runtime["scratch"] = runtime.get("scratch") or os.path.join(tmp_work, "synthesis")
runtime["output_tmp"] = runtime.get("output_tmp") or os.path.join(tmp_output, "regular_synthesized_spectra.tmp.zarr")
runtime.setdefault("log_level", "INFO")
runtime["log_file"] = runtime.get("log_file") or os.path.join(log_dir, "regular_grid.synthesis.log")
runtime["skip_synthesis"] = skip_synthesis

turb = cfg.setdefault("turbospectrum", {})
turb_cfg = turb.get("config")
if not turb_cfg:
    turb_cfg = os.path.join(repo, "configs", "synthesis", "config_sample_comprehensive.json")
elif not os.path.isabs(str(turb_cfg)):
    turb_cfg = os.path.abspath(os.path.join(cfg_dir, str(turb_cfg)))
turb["config"] = turb_cfg

with open(dst, "w", encoding="utf-8") as handle:
    json.dump(cfg, handle, indent=2, sort_keys=True)
PY

echo "[regular-grid] Repo: ${REPO}"
echo "[regular-grid] Config template: ${CONFIG_PATH}"
echo "[regular-grid] Job config: ${JOB_CONFIG_PATH}"
echo "[regular-grid] Run root: ${RUN_ROOT}"
echo "[regular-grid] Scratch tmp root: ${SCRATCH_TMP_ROOT}"
echo "[regular-grid] Workers: ${WORKERS}"
echo "[regular-grid] Skip synthesis: ${SKIP_SYNTHESIS}"

"${PYTHON}" "${REPO}/scripts/synthesize_regular_grid.py" \
    --config-json "${JOB_CONFIG_PATH}" \
    --run-root "${RUN_ROOT}"

if [[ "${SKIP_SYNTHESIS}" == "1" || "${SKIP_SYNTHESIS}" == "true" ]]; then
    echo "[regular-grid] Completed grid generation only."
else
    FINAL_ZARR="${RUN_ROOT}/outputs/zarr/regular_synthesized_spectra.zarr"
    if [[ ! -d "${FINAL_ZARR}" ]]; then
        echo "[regular-grid] ERROR: expected synthesized spectra Zarr not found: ${FINAL_ZARR}" >&2
        exit 1
    fi
    echo "[regular-grid] Completed synthesis: ${FINAL_ZARR}"
fi
