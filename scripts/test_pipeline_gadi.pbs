#!/bin/bash
#PBS -N ts-pipeline-smoke
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/mk27
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR}"

############################################
# Thread caps
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

############################################
# User-overridable knobs
############################################

PROJECT="${PROJECT:-mk27}"
PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
SMOKE_SAMPLES="${SMOKE_SAMPLES:-8}"
SMOKE_WORKERS="${SMOKE_WORKERS:-1}"
SMOKE_LAM_MIN="${SMOKE_LAM_MIN:-5000}"
SMOKE_LAM_MAX="${SMOKE_LAM_MAX:-5005}"
SMOKE_LAM_STEP="${SMOKE_LAM_STEP:-0.5}"

# Prevent mixed-prefix Python startup failures on Gadi login/compute environments.
unset PYTHONHOME || true
unset PYTHONPATH || true

activate_mamba() {
  if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
    eval "$("${MAMBA_EXE}" shell hook --shell bash)"
  elif command -v mamba >/dev/null 2>&1; then
    eval "$(mamba shell hook --shell bash)"
  elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
    # Fallback for installations where mamba hook is unavailable.
    source "${HOME}/miniforge/etc/profile.d/conda.sh"
  else
    return 1
  fi

  if command -v mamba >/dev/null 2>&1; then
    mamba activate "${MAMBA_ENV_NAME}"
  elif command -v conda >/dev/null 2>&1; then
    conda activate "${MAMBA_ENV_NAME}"
  else
    return 1
  fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
  if activate_mamba; then
    :
  else
    echo "[gadi-smoke] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
  fi

  if command -v python >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python)"
  elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  else
    echo "[gadi-smoke] ERROR: no python executable found after env setup." >&2
    exit 1
  fi
fi

RUN_ROOT="/scratch/${PROJECT}/${USER}/turbospec_smoke/${PBS_JOBID}"

echo "[gadi-smoke] repo=${PBS_O_WORKDIR}"
echo "[gadi-smoke] run_root=${RUN_ROOT}"
echo "[gadi-smoke] python=${PYTHON_BIN}"
echo "[gadi-smoke] mamba_env=${MAMBA_ENV_NAME}"
echo "[gadi-smoke] conda_prefix=${CONDA_PREFIX:-<unset>}"
echo "[gadi-smoke] config=${CONFIG_PATH}"

mkdir -p "${RUN_ROOT}"

bash scripts/test_pipeline_local.sh \
  --python "${PYTHON_BIN}" \
  --config "${CONFIG_PATH}" \
  --run-root "${RUN_ROOT}" \
  --num-samples "${SMOKE_SAMPLES}" \
  --workers "${SMOKE_WORKERS}" \
  --lam-min "${SMOKE_LAM_MIN}" \
  --lam-max "${SMOKE_LAM_MAX}" \
  --lam-step "${SMOKE_LAM_STEP}" \
  --with-synthesis \
  --keep

echo "[gadi-smoke] SUCCESS"
echo "[gadi-smoke] outputs/logs kept in: ${RUN_ROOT}"
