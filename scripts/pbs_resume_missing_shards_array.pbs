#!/bin/bash
#PBS -N ts-resume-missing
#PBS -r y
#PBS -l ncpus=32
#PBS -l mem=64gb
#PBS -l walltime=12:00:00
#PBS -l jobfs=100gb
#PBS -l storage=scratch/mk27+scratch/y89
#PBS -q rsaa
#PBS -P mk27
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -j oe

set -euo pipefail

cd "${PBS_O_WORKDIR}"

############################################
# Required inputs (via qsub -v ...)
############################################

RUN_ROOT="${RUN_ROOT:-runs/local-dev}"
MISSING_IDS_FILE="${MISSING_IDS_FILE:-${MISSING_FILE:-}}"
SHARD_COUNT="${SHARD_COUNT:-}"

if [[ -z "${MISSING_IDS_FILE}" && -f "${RUN_ROOT}/missing_shards.txt" ]]; then
  MISSING_IDS_FILE="${RUN_ROOT}/missing_shards.txt"
fi
if [[ -z "${MISSING_IDS_FILE}" ]]; then
  echo "[resume-missing] ERROR: missing ID file not set. Pass MISSING_IDS_FILE (or MISSING_FILE), or create ${RUN_ROOT}/missing_shards.txt." >&2
  exit 2
fi
if [[ -z "${SHARD_COUNT}" ]]; then
  echo "[resume-missing] ERROR: SHARD_COUNT is required." >&2
  exit 2
fi
if [[ ! -f "${MISSING_IDS_FILE}" ]]; then
  echo "[resume-missing] ERROR: MISSING_IDS_FILE not found: ${MISSING_IDS_FILE}" >&2
  exit 2
fi

############################################
# User-overridable knobs
############################################

GRID_ZARR="${GRID_ZARR:-${RUN_ROOT}/outputs/grids/parameter_grid.zarr}"
TS_CONFIG="${TS_CONFIG:-configs/synthesis/config_sample_comprehensive.json}"
OUT_DIR="${OUT_DIR:-${RUN_ROOT}/outputs/shards}"
PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"
MAX_ATTEMPTS="${MAX_ATTEMPTS:-3}"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"

############################################
# Safe threading defaults
############################################

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Prevent mixed-prefix startup failures.
unset PYTHONHOME || true
unset PYTHONPATH || true

activate_mamba() {
  if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
    eval "$("${MAMBA_EXE}" shell hook --shell bash)"
  elif command -v mamba >/dev/null 2>&1; then
    eval "$(mamba shell hook --shell bash)"
  elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
    source "${HOME}/miniforge/etc/profile.d/conda.sh"
  else
    return 1
  fi

  if command -v mamba >/dev/null 2>&1; then
    mamba activate "${MAMBA_ENV_NAME}"
  elif command -v conda >/dev/null 2>&1; then
    conda activate "${MAMBA_ENV_NAME}"
  else
    return 1
  fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
  if activate_mamba; then
    :
  else
    echo "[resume-missing] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
  fi

  if command -v python >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python)"
  elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  else
    echo "[resume-missing] ERROR: no python executable found." >&2
    exit 1
  fi
fi

if [[ ! -x "${PYTHON_BIN}" ]]; then
  echo "[resume-missing] ERROR: PYTHON_BIN is not executable: ${PYTHON_BIN}" >&2
  exit 1
fi
if ! "${PYTHON_BIN}" - <<'PY' >/dev/null 2>&1
import numpy
import zarr
PY
then
  echo "[resume-missing] ERROR: Python missing required packages (numpy,zarr): ${PYTHON_BIN}" >&2
  echo "[resume-missing] Hint: submit with --python-bin \"\$(which python)\" from your working env." >&2
  exit 1
fi

mkdir -p "${OUT_DIR}" "${RUN_ROOT}/logs/pbs" "logs/pbs" "${RUN_ROOT}/logs/shards_resume" \
  "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}"

# Force mkstemp()/tempfile users to write under designated scratch temp.
export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

TASK_ORDINAL="${PBS_ARRAY_INDEX:-0}"
if ! [[ "${TASK_ORDINAL}" =~ ^[0-9]+$ ]]; then
  echo "[resume-missing] ERROR: PBS_ARRAY_INDEX must be a non-negative integer, got '${TASK_ORDINAL}'." >&2
  exit 2
fi
mapfile -t SHARD_IDS < <(
  awk '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*[0-9]+[[:space:]]*$/ {
      gsub(/[[:space:]]/, "", $0)
      print $0
    }
  ' "${MISSING_IDS_FILE}"
)
MISSING_COUNT="${#SHARD_IDS[@]}"
if (( MISSING_COUNT == 0 )); then
  echo "[resume-missing] INFO: no valid shard IDs found in ${MISSING_IDS_FILE}. Nothing to resume." >&2
  exit 0
fi
if (( TASK_ORDINAL >= MISSING_COUNT )); then
  echo "[resume-missing] ERROR: task index ${TASK_ORDINAL} out of range for ${MISSING_COUNT} shard IDs in ${MISSING_IDS_FILE}." >&2
  exit 2
fi
SHARD_INDEX="${SHARD_IDS[TASK_ORDINAL]}"

OUT="${OUT_DIR}/spectra_shard_${SHARD_INDEX}.zarr"
SCRATCH="${TMP_WORK_DIR}/shard_${SHARD_INDEX}"
LOG_FILE="${RUN_ROOT}/logs/shards_resume/shard_${SHARD_INDEX}.log"
mkdir -p "${SCRATCH}"

echo "[resume-missing] job=${PBS_JOBID} task=${TASK_ORDINAL} shard=${SHARD_INDEX}" | tee -a "${LOG_FILE}"
echo "[resume-missing] PYTHON_BIN(env)=${PYTHON_BIN}" | tee -a "${LOG_FILE}"
echo "[resume-missing] grid=${GRID_ZARR}" | tee -a "${LOG_FILE}"
echo "[resume-missing] config=${TS_CONFIG}" | tee -a "${LOG_FILE}"
echo "[resume-missing] output=${OUT}" | tee -a "${LOG_FILE}"
echo "[resume-missing] scratch_tmp_root=${SCRATCH_TMP_ROOT}" | tee -a "${LOG_FILE}"
echo "[resume-missing] python=${PYTHON_BIN}" | tee -a "${LOG_FILE}"

# Compute --max-failures as 15% of rows in this shard (ceiling).
ROW_COUNT=$("${PYTHON_BIN}" - <<PY
import zarr
root = zarr.open_group(r"${GRID_ZARR}", mode="r")
for key in ("teff", "params", "global_index"):
    if key in root and len(root[key].shape) >= 1:
        print(int(root[key].shape[0]))
        break
else:
    raise RuntimeError(f"Could not infer row count from {r'${GRID_ZARR}'}")
PY
)
ROWS_PER_SHARD=$(( (ROW_COUNT + SHARD_COUNT - 1) / SHARD_COUNT ))
MAX_FAILURES=$(( (ROWS_PER_SHARD * 15 + 99) / 100 ))
echo "[resume-missing] row_count=${ROW_COUNT} rows_per_shard=~${ROWS_PER_SHARD} max_failures=${MAX_FAILURES}" | tee -a "${LOG_FILE}"

if "${PYTHON_BIN}" - <<PY >/dev/null 2>&1
import zarr
root = zarr.open_group(r"${OUT}", mode="r")
assert "flux" in root and "wavelength" in root and root["flux"].shape[0] > 0
PY
then
  echo "[resume-missing] shard ${SHARD_INDEX} already valid. Skipping." | tee -a "${LOG_FILE}"
  exit 0
fi

for attempt in $(seq 1 "${MAX_ATTEMPTS}"); do
  TMP_OUT="${TMP_OUTPUT_DIR}/spectra_shard_${SHARD_INDEX}.a${attempt}.tmp.zarr"
  rm -rf "${TMP_OUT}" || true
  echo "[resume-missing] attempt ${attempt}/${MAX_ATTEMPTS}" | tee -a "${LOG_FILE}"

  "${PYTHON_BIN}" scripts/run_turbospectrum_shard.py \
    --grid-zarr "${GRID_ZARR}" \
    --config "${TS_CONFIG}" \
    --output-zarr "${TMP_OUT}" \
    --shard-index "${SHARD_INDEX}" \
    --shard-count "${SHARD_COUNT}" \
    --workers "${PBS_NP:-32}" \
    --scratch "${SCRATCH}" \
    --max-failures "${MAX_FAILURES}" \
    --log-level INFO \
    >> "${LOG_FILE}" 2>&1 || true

  if "${PYTHON_BIN}" - <<PY >/dev/null 2>&1
import zarr
root = zarr.open_group(r"${TMP_OUT}", mode="r")
assert "flux" in root and "wavelength" in root and root["flux"].shape[0] > 0
PY
  then
    rm -rf "${OUT}" || true
    mv "${TMP_OUT}" "${OUT}"
    echo "[resume-missing] shard ${SHARD_INDEX} succeeded on attempt ${attempt}" | tee -a "${LOG_FILE}"
    exit 0
  fi

  rm -rf "${TMP_OUT}" || true
  sleep $(( (RANDOM % 10) + attempt * 15 ))
done

echo "[resume-missing] ERROR: shard ${SHARD_INDEX} failed after ${MAX_ATTEMPTS} attempts." | tee -a "${LOG_FILE}"
exit 1
