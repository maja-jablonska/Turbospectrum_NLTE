#!/bin/bash
#PBS -N ts-synth
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l walltime=12:00:00
#PBS -j oe
#
# Array size: override via qsub -J and -v N_SHARDS=...
# Default: 100 shards.  Example: qsub -J 0-199 -v N_SHARDS=200 ...
#PBS -J 0-99
#
#PBS -o logs/pbs/ts-synth.${PBS_JOBID}.out
#PBS -e logs/pbs/ts-synth.${PBS_JOBID}.err

set -euo pipefail

cd "${PBS_O_WORKDIR}"

# ---- user settings ----
N_SHARDS="${N_SHARDS:-100}"
RUN_ROOT="${RUN_ROOT:-runs/local-dev}"
GRID_ZARR="${RUN_ROOT}/outputs/grids/parameter_grid.zarr"          # input parameter grid
TS_CONFIG="configs/synthesis/config_sample_comprehensive.json"      # Turbospectrum runtime config
OUT_DIR="${RUN_ROOT}/outputs/shards"                                # per-shard Zarr outputs go here
PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

# Optional: node-local scratch. Many PBS systems set $TMPDIR automatically.
SCRATCH_BASE="${TMPDIR:-/tmp/${USER}/pbs_${PBS_JOBID}}"

# -----------------------
mkdir -p "${OUT_DIR}" "${RUN_ROOT}/logs/pbs" "logs/pbs" "${SCRATCH_BASE}"

# Prevent oversubscription if linked BLAS/OpenMP libs are present.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

# Prevent mixed-prefix Python startup failures on HPC nodes.
unset PYTHONHOME || true
unset PYTHONPATH || true

activate_mamba() {
  if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
    eval "$("${MAMBA_EXE}" shell hook --shell bash)"
  elif command -v mamba >/dev/null 2>&1; then
    eval "$(mamba shell hook --shell bash)"
  elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
    source "${HOME}/miniforge/etc/profile.d/conda.sh"
  else
    return 1
  fi

  if command -v mamba >/dev/null 2>&1; then
    mamba activate "${MAMBA_ENV_NAME}"
  elif command -v conda >/dev/null 2>&1; then
    conda activate "${MAMBA_ENV_NAME}"
  else
    return 1
  fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
  if activate_mamba; then
    :
  else
    echo "[pbs-synth] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
  fi

  if command -v python >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python)"
  elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  else
    echo "[pbs-synth] ERROR: no python executable found after env setup." >&2
    exit 1
  fi
fi

SHARD_INDEX="${PBS_ARRAY_INDEX:-0}"
if (( SHARD_INDEX >= N_SHARDS )); then
    echo "[pbs-synth] INFO: array task ${SHARD_INDEX} >= N_SHARDS=${N_SHARDS}; exiting cleanly."
    exit 0
fi
SHARD_OUT="${OUT_DIR}/spectra_shard_${SHARD_INDEX}.zarr"
SCRATCH="${SCRATCH_BASE}/shard_${SHARD_INDEX}"
mkdir -p "${SCRATCH}"

echo "Job: ${PBS_JOBID} shard ${SHARD_INDEX}/${N_SHARDS}"
echo "Grid: ${GRID_ZARR}"
echo "Config: ${TS_CONFIG}"
echo "Output: ${SHARD_OUT}"
echo "Scratch: ${SCRATCH}"
echo "CPUs: ${PBS_NCPUS:-unknown}"
echo "Python: ${PYTHON_BIN}"
echo "Mamba env: ${MAMBA_ENV_NAME}"
echo "Conda prefix: ${CONDA_PREFIX:-<unset>}"

# Compute --max-failures as 15% of rows in this shard (ceiling).
ROW_COUNT=$("${PYTHON_BIN}" - <<PY
import zarr
root = zarr.open_group(r"${GRID_ZARR}", mode="r")
for key in ("teff", "params", "global_index"):
    if key in root and len(root[key].shape) >= 1:
        print(int(root[key].shape[0]))
        break
else:
    raise RuntimeError(f"Could not infer row count from {r'${GRID_ZARR}'}")
PY
)
ROWS_PER_SHARD=$(( (ROW_COUNT + N_SHARDS - 1) / N_SHARDS ))
MAX_FAILURES=$(( (ROWS_PER_SHARD * 15 + 99) / 100 ))
echo "Row count: ${ROW_COUNT}  Rows/shard: ~${ROWS_PER_SHARD}  Max failures: ${MAX_FAILURES}"

"${PYTHON_BIN}" scripts/run_turbospectrum_shard.py \
  --grid-zarr "${GRID_ZARR}" \
  --config "${TS_CONFIG}" \
  --output-zarr "${SHARD_OUT}" \
  --shard-index "${SHARD_INDEX}" \
  --shard-count "${N_SHARDS}" \
  --workers "${PBS_NCPUS:-32}" \
  --scratch "${SCRATCH}" \
  --max-failures "${MAX_FAILURES}" \
  --log-level INFO

# Scratch cleanup
if [[ -d "${SCRATCH}" ]]; then
    rm -rf "${SCRATCH}"
fi
