#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N filtermerge
#PBS -r y
#PBS -l ncpus=4
#PBS -l mem=32GB
#PBS -l walltime=10:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89

# Filter bad-snap rows out of per-run spectra stores and merge the survivors
# into one consolidated store (scripts/merge_spectra_runs.py --filter-bad-snaps).
# Rejected rows land in a CSV + parameter-space summary JSON so the re-run
# grid can be planned from them.
#
# Usage:
#   qsub -v RUN_DIR=/scratch/.../runs,OUTPUT_ZARR=/scratch/.../harps_clean.zarr,ATMOSPHERE_PATH=/g/data/.../marcs_standard_comp filter_merge_runs.pbs
#
#   # explicit store list instead of a directory (space-separated):
#   qsub -v RUNS="/path/run1.zarr /path/run2.zarr",OUTPUT_ZARR=...,ATMOSPHERE_PATH=... filter_merge_runs.pbs
#
# Optional -v knobs:
#   REJECTS_CSV=...            rejected-rows CSV (default: <OUTPUT_ZARR minus .zarr>_rejects.csv)
#   MAX_DTEFF / MAX_DLOGG / MAX_DFEH
#                              also drop correctly-snapped rows farther than this
#                              from the request (MARCS coverage holes)
#   DEDUP_BY_MODEL_ID=1        drop cross-run duplicate rows (first occurrence wins)
#   STRICT_PARAMS=1            require identical param_names across runs
#   ALLOW_INCOMPLETE_PROVENANCE=1
#                              proceed when provenance contract fields are missing
#   CHUNK_ROWS=128             output row chunking (matches merge default)

set -euo pipefail
cd "${PBS_O_WORKDIR}"

TAG="filtermerge"

# Thread caps, PYTHON (PYTHON_BIN or mamba env MAMBA_ENV_NAME) and to_bool01.
_PBS_REPO="${REPO:-${PBS_O_WORKDIR}}"
[[ "${_PBS_REPO}" == /* ]] || _PBS_REPO="${PBS_O_WORKDIR}/${_PBS_REPO}"
# shellcheck source=scripts/pbs_env.sh
source "${_PBS_REPO}/scripts/pbs_env.sh"
echo "[${TAG}] Python: ${PYTHON}"

############################################
# Variables
############################################

REPO="${REPO:-${PBS_O_WORKDIR}}"
RUN_DIR="${RUN_DIR:-}"
RUNS="${RUNS:-}"
OUTPUT_ZARR="${OUTPUT_ZARR:-}"
ATMOSPHERE_PATH="${ATMOSPHERE_PATH:-}"
REJECTS_CSV="${REJECTS_CSV:-}"
MAX_DTEFF="${MAX_DTEFF:-}"
MAX_DLOGG="${MAX_DLOGG:-}"
MAX_DFEH="${MAX_DFEH:-}"
DEDUP_BY_MODEL_ID="${DEDUP_BY_MODEL_ID:-0}"
STRICT_PARAMS="${STRICT_PARAMS:-0}"
ALLOW_INCOMPLETE_PROVENANCE="${ALLOW_INCOMPLETE_PROVENANCE:-0}"
CHUNK_ROWS="${CHUNK_ROWS:-128}"

if [[ -z "${OUTPUT_ZARR}" ]]; then
    echo "[${TAG}] ERROR: OUTPUT_ZARR is required (qsub -v OUTPUT_ZARR=/path/combined.zarr)." >&2
    exit 1
fi
if [[ -z "${ATMOSPHERE_PATH}" ]]; then
    echo "[${TAG}] ERROR: ATMOSPHERE_PATH is required (the MARCS model directory the runs used)." >&2
    exit 1
fi
if [[ -z "${RUN_DIR}" && -z "${RUNS}" ]]; then
    echo "[${TAG}] ERROR: provide RUN_DIR=/path/to/runs or RUNS=\"a.zarr b.zarr ...\"." >&2
    exit 1
fi
if [[ -e "${OUTPUT_ZARR}" ]]; then
    echo "[${TAG}] ERROR: OUTPUT_ZARR already exists, refusing to overwrite: ${OUTPUT_ZARR}" >&2
    exit 1
fi

if [[ -z "${REJECTS_CSV}" ]]; then
    REJECTS_CSV="${OUTPUT_ZARR%.zarr}_rejects.csv"
fi

ARGS=(
    "${REPO}/scripts/merge_spectra_runs.py"
    --output-zarr "${OUTPUT_ZARR}"
    --chunk-rows "${CHUNK_ROWS}"
    --filter-bad-snaps
    --atmosphere-path "${ATMOSPHERE_PATH}"
    --rejects-csv "${REJECTS_CSV}"
)

if [[ -n "${RUN_DIR}" ]]; then
    ARGS+=(--run-dir "${RUN_DIR}")
else
    for run_path in ${RUNS}; do
        ARGS+=(--run "${run_path}")
    done
fi

[[ -n "${MAX_DTEFF}" ]] && ARGS+=(--max-dteff "${MAX_DTEFF}")
[[ -n "${MAX_DLOGG}" ]] && ARGS+=(--max-dlogg "${MAX_DLOGG}")
[[ -n "${MAX_DFEH}" ]] && ARGS+=(--max-dfeh "${MAX_DFEH}")
[[ "${DEDUP_BY_MODEL_ID}" == "1" ]] && ARGS+=(--dedup-by-model-id)
[[ "${STRICT_PARAMS}" == "1" ]] && ARGS+=(--strict-params)
[[ "${ALLOW_INCOMPLETE_PROVENANCE}" == "1" ]] && ARGS+=(--allow-incomplete-provenance)

echo "[${TAG}] Command: ${PYTHON} ${ARGS[*]}"
"${PYTHON}" "${ARGS[@]}"

echo "[${TAG}] Done."
echo "[${TAG}] Combined store: ${OUTPUT_ZARR}"
echo "[${TAG}] Rejects: ${REJECTS_CSV}"
echo "[${TAG}] Rejects summary: ${REJECTS_CSV%.csv}_summary.json"
