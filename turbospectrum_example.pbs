#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N turbospec
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail
cd $PBS_O_WORKDIR

############################################
# Thread caps (CRITICAL)
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

# Prevent mixed-prefix Python startup failures on HPC nodes.
unset PYTHONHOME || true
unset PYTHONPATH || true
PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[turbospec] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[turbospec] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[turbospec] Python: ${PYTHON}"
echo "[turbospec] Mamba env: ${MAMBA_ENV_NAME}"
echo "[turbospec] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Paths
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
RUN_ROOT="${RUN_ROOT:-/scratch/${PROJECT}/${USER_ID}/Turbospectrum_NLTE}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
WORKERS_OVERRIDE="${WORKERS:-}"
SHARD_COUNT_OVERRIDE="${SHARD_COUNT:-}"
ROWS_PER_SHARD_OVERRIDE="${ROWS_PER_SHARD:-}"
FORCE_RESTART="${FORCE_RESTART:-0}"
ALLOW_PARTIAL_MERGE="${ALLOW_PARTIAL_MERGE:-1}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO=$(cd "${REPO}" >/dev/null 2>&1 && pwd)

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[turbospec] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

to_bool01() {
    local val
    val="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "${val}" in
        1|true|yes|on) echo 1 ;;
        *) echo 0 ;;
    esac
}

CONFIG_OUTPUTS=$(
    "${PYTHON}" - <<PY
import json
import os

cfg_path = os.path.abspath(r"${CONFIG_PATH}")
cfg_dir = os.path.dirname(cfg_path)
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
outs = cfg.get("outputs", {}) or {}
runtime = cfg.get("runtime", {}) or {}

def _abs(p):
    if not p:
        return ""
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cfg_dir, p))

grid = _abs(outs.get("grid_zarr"))
shard_tmpl = _abs(outs.get("spectra_shard_template"))
merged = _abs(outs.get("spectra_zarr"))
shards_dir = os.path.dirname(shard_tmpl) if shard_tmpl else ""
workers = runtime.get("workers")
workers_out = ""
if workers not in (None, ""):
    try:
        workers_out = str(int(workers))
    except Exception:
        workers_out = ""

shard_count = runtime.get("shard_count")
shard_count_out = ""
if shard_count not in (None, ""):
    try:
        shard_count_out = str(int(shard_count))
    except Exception:
        shard_count_out = ""

rows_per_shard = runtime.get("rows_per_shard")
rows_per_shard_out = ""
if rows_per_shard not in (None, ""):
    try:
        rows_per_shard_out = str(int(rows_per_shard))
    except Exception:
        rows_per_shard_out = ""

print(grid)
print(shards_dir)
print(merged)
print(workers_out)
print(shard_count_out)
print(rows_per_shard_out)
PY
)
mapfile -t _cfg_lines <<< "${CONFIG_OUTPUTS}"
CFG_GRID_ZARR="${_cfg_lines[0]:-}"
CFG_SHARDS_DIR="${_cfg_lines[1]:-}"
CFG_MERGED_ZARR="${_cfg_lines[2]:-}"
CFG_WORKERS="${_cfg_lines[3]:-}"
CFG_SHARD_COUNT="${_cfg_lines[4]:-}"
CFG_ROWS_PER_SHARD="${_cfg_lines[5]:-}"

WORKERS="${WORKERS_OVERRIDE:-${CFG_WORKERS:-16}}"
if ! [[ "${WORKERS}" =~ ^[0-9]+$ ]] || (( WORKERS < 1 )); then
    echo "[turbospec] WARN: invalid WORKERS='${WORKERS}', defaulting to 16." >&2
    WORKERS=16
fi

DEFAULT_VALIDATE_WORKERS="${WORKERS}"
if (( DEFAULT_VALIDATE_WORKERS > 32 )); then
    DEFAULT_VALIDATE_WORKERS=32
fi
VALIDATE_WORKERS="${VALIDATE_WORKERS:-${DEFAULT_VALIDATE_WORKERS}}"
if ! [[ "${VALIDATE_WORKERS}" =~ ^[0-9]+$ ]] || (( VALIDATE_WORKERS < 1 )); then
    echo "[turbospec] WARN: invalid VALIDATE_WORKERS='${VALIDATE_WORKERS}', defaulting to ${DEFAULT_VALIDATE_WORKERS}." >&2
    VALIDATE_WORKERS="${DEFAULT_VALIDATE_WORKERS}"
fi

MERGE_CHUNK_ROWS="${MERGE_CHUNK_ROWS:-128}"
if ! [[ "${MERGE_CHUNK_ROWS}" =~ ^[0-9]+$ ]] || (( MERGE_CHUNK_ROWS < 1 )); then
    echo "[turbospec] WARN: invalid MERGE_CHUNK_ROWS='${MERGE_CHUNK_ROWS}', defaulting to 128." >&2
    MERGE_CHUNK_ROWS=128
fi

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR:-${RUN_ROOT}/grid/parameter_grid.zarr}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR:-${RUN_ROOT}/shards}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR:-${RUN_ROOT}/synthesized_spectra.zarr}}"

if [[ "${GRID_ZARR}" != /* ]]; then
    GRID_ZARR="${REPO}/${GRID_ZARR}"
fi
if [[ "${SHARDS_DIR}" != /* ]]; then
    SHARDS_DIR="${REPO}/${SHARDS_DIR}"
fi
if [[ "${MERGED_ZARR}" != /* ]]; then
    MERGED_ZARR="${REPO}/${MERGED_ZARR}"
fi

NEXT_WORK_ITEM="${NEXT_WORK_ITEM:-${RUN_ROOT}/next_work_item.txt}"
LOCK_FILE="${LOCK_FILE:-${RUN_ROOT}/counter.lock}"
LOG_DIR="${LOG_DIR:-${RUN_ROOT}/logs}"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"
MISSING_FILE="${MISSING_FILE:-${RUN_ROOT}/missing_shards.txt}"
PENDING_SHARDS_FILE="${PENDING_SHARDS_FILE:-${RUN_ROOT}/pending_shards.txt}"
mkdir -p "${LOG_DIR}" "${SHARDS_DIR}" "$(dirname "${NEXT_WORK_ITEM}")" "$(dirname "${LOCK_FILE}")" \
         "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}"

# Force mkstemp()/tempfile users to write under designated scratch temp.
export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

echo "[turbospec] Repo: ${REPO}"
echo "[turbospec] Config: ${CONFIG_PATH}"
echo "[turbospec] Grid: ${GRID_ZARR}"
echo "[turbospec] Shards: ${SHARDS_DIR}"
echo "[turbospec] Merged: ${MERGED_ZARR}"
echo "[turbospec] Scratch tmp root: ${SCRATCH_TMP_ROOT}"
echo "[turbospec] Workers: ${WORKERS}"
echo "[turbospec] Validate workers: ${VALIDATE_WORKERS}"
echo "[turbospec] Merge chunk rows: ${MERGE_CHUNK_ROWS}"
echo "[turbospec] Missing shard report: ${MISSING_FILE}"
echo "[turbospec] Force restart: $(to_bool01 "${FORCE_RESTART}")"
echo "[turbospec] Allow partial merge: $(to_bool01 "${ALLOW_PARTIAL_MERGE}")"
echo "[turbospec] Run policy: preserve valid shards and resume missing shard IDs."

CONFIG_NUM_SAMPLES=$(
    "${PYTHON}" - <<PY
import json
with open(r"${CONFIG_PATH}", "r", encoding="utf-8") as f:
    cfg = json.load(f)
print(int((cfg.get("grid") or {}).get("num_samples", 0)))
PY
)

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec] Grid not found; generating grid (num_samples=${CONFIG_NUM_SAMPLES})."
    "${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
        --config "${CONFIG_PATH}" \
        --skip-synthesis
else
    echo "[turbospec] Using existing grid: ${GRID_ZARR}"
fi

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec] ERROR: grid zarr still not found after generation: ${GRID_ZARR}" >&2
    exit 1
fi

############################################
# Grid sanity check
############################################

ROW_COUNT=$(${PYTHON} - <<PY
import zarr
root = zarr.open_group(r"${GRID_ZARR}", mode="r")
for key in ("teff", "params", "global_index"):
    if key in root and len(root[key].shape) >= 1:
        print(int(root[key].shape[0]))
        break
else:
    raise RuntimeError(f"Could not infer row count from {r'${GRID_ZARR}'}")
PY
)

echo "Grid rows: ${ROW_COUNT}"

############################################
# Shard layout
############################################

if ! [[ "${ROW_COUNT}" =~ ^[0-9]+$ ]] || (( ROW_COUNT < 1 )); then
    echo "[turbospec] ERROR: invalid row count inferred from grid: '${ROW_COUNT}'." >&2
    exit 1
fi

ROWS_PER_SHARD="${ROWS_PER_SHARD_OVERRIDE:-${CFG_ROWS_PER_SHARD:-}}"
if [[ -n "${ROWS_PER_SHARD}" ]]; then
    if ! [[ "${ROWS_PER_SHARD}" =~ ^[0-9]+$ ]] || (( ROWS_PER_SHARD < 1 )); then
        echo "[turbospec] ERROR: ROWS_PER_SHARD must be a positive integer, got '${ROWS_PER_SHARD}'." >&2
        exit 1
    fi
fi

SHARD_COUNT="${SHARD_COUNT_OVERRIDE:-${CFG_SHARD_COUNT:-}}"
if [[ -n "${ROWS_PER_SHARD}" && -z "${SHARD_COUNT_OVERRIDE}" && -z "${CFG_SHARD_COUNT}" ]]; then
    SHARD_COUNT=$(( (ROW_COUNT + ROWS_PER_SHARD - 1) / ROWS_PER_SHARD ))
fi
if [[ -z "${SHARD_COUNT}" ]]; then
    SHARD_COUNT="${ROW_COUNT}"
fi
if ! [[ "${SHARD_COUNT}" =~ ^[0-9]+$ ]] || (( SHARD_COUNT < 1 )); then
    echo "[turbospec] ERROR: SHARD_COUNT must be a positive integer, got '${SHARD_COUNT}'." >&2
    exit 1
fi
if (( SHARD_COUNT > ROW_COUNT )); then
    echo "[turbospec] WARN: SHARD_COUNT=${SHARD_COUNT} exceeds grid rows=${ROW_COUNT}; capping to ${ROW_COUNT}." >&2
    SHARD_COUNT="${ROW_COUNT}"
fi
if [[ -z "${ROWS_PER_SHARD}" ]]; then
    ROWS_PER_SHARD=$(( (ROW_COUNT + SHARD_COUNT - 1) / SHARD_COUNT ))
fi

echo "[turbospec] Shard count: ${SHARD_COUNT}"
echo "[turbospec] Approx rows per shard: ${ROWS_PER_SHARD}"
if (( SHARD_COUNT == ROW_COUNT )); then
    echo "[turbospec] INFO: one-row-per-shard mode is active. Set SHARD_COUNT or ROWS_PER_SHARD to coarsen sharding for large grids."
fi

############################################
# Walltime guard
############################################

walltime_to_seconds () {
    local raw="$1"
    if [[ -z "${raw}" ]]; then
        echo ""
        return 0
    fi
    if [[ "${raw}" =~ ^[0-9]+$ ]]; then
        echo "${raw}"
        return 0
    fi
    if [[ "${raw}" =~ ^([0-9]+):([0-9]{2}):([0-9]{2})$ ]]; then
        local hh mm ss
        hh="${BASH_REMATCH[1]}"
        mm="${BASH_REMATCH[2]}"
        ss="${BASH_REMATCH[3]}"
        echo $((10#${hh} * 3600 + 10#${mm} * 60 + 10#${ss}))
        return 0
    fi
    echo ""
}

WALLTIME_RAW="${WALLTIME_SECONDS:-${PBS_WALLTIME:-${PBS_RESOURCE_LIST_WALLTIME:-}}}"
WALLTIME_SECONDS="$(walltime_to_seconds "${WALLTIME_RAW}")"
if ! [[ "${WALLTIME_SECONDS}" =~ ^[0-9]+$ ]] || (( WALLTIME_SECONDS < 1 )); then
    WALLTIME_SECONDS=$((12*3600))
    echo "[turbospec] WARN: could not parse walltime from '${WALLTIME_RAW:-<unset>}' — defaulting to ${WALLTIME_SECONDS}s." >&2
fi
START_TIME=$(date +%s)

SAFETY_BUFFER="${SAFETY_BUFFER:-900}"  # stop 15 minutes early
EST_RUNTIME="${EST_RUNTIME:-600}"      # expected shard runtime (tune later)
SHARD_RETRY_ATTEMPTS="${SHARD_RETRY_ATTEMPTS:-3}"          # attempts during the main worker loop

time_left () {
    echo $((WALLTIME_SECONDS - ($(date +%s) - START_TIME)))
}

run_shard_attempts () {
    local shard="$1"
    local max_attempts="$2"
    local scratch_root="$3"
    local log_file="$4"
    local sleep_base="$5"

    local tmp_out="${TMP_OUTPUT_DIR}/spectra_shard_${shard}.a$$.tmp.zarr"

    for ((attempt=1; attempt<=max_attempts; attempt++)); do
        local start end attempt_scratch
        start=$(date +%s)
        attempt_scratch="${scratch_root}/shard_${shard}_a${attempt}"
        mkdir -p "${attempt_scratch}"

        if ${PYTHON} ${REPO}/scripts/pipeline_from_config.py \
          --config "${CONFIG_PATH}" \
          --skip-grid \
          --synthesis-mode sharded \
          --shard-index "${shard}" \
          --shard-count "${SHARD_COUNT}" \
          --workers 1 \
          --scratch "${attempt_scratch}" \
          --output "${tmp_out}" \
          >> "${log_file}" 2>&1; then
            end=$(date +%s)
            echo "runtime_seconds=$((end-start)) attempt=${attempt}" >> "${log_file}"
            return 0
        fi

        rm -rf "${tmp_out}"
        sleep $(( (RANDOM % 10) + attempt * sleep_base ))
    done

    return 1
}

write_missing_shards_file () {
    ${PYTHON} - <<PY
import re
import sys
from pathlib import Path

import numpy as np
import zarr

shard_dir = Path(r"${SHARDS_DIR}")
expected_shards = int(r"${SHARD_COUNT}")
row_count = int(r"${ROW_COUNT}")
out_path = Path(r"${MISSING_FILE}")
out_path.parent.mkdir(parents=True, exist_ok=True)

pattern = re.compile(r"^spectra_shard_(\d+)\.zarr$")
seen: set[int] = set()
for shard_path in sorted(shard_dir.glob("spectra_shard_*.zarr")):
    match = pattern.match(shard_path.name)
    if match is None:
        continue
    shard_idx = int(match.group(1))
    if shard_idx < 0 or shard_idx >= expected_shards:
        continue
    try:
        root = zarr.open_group(str(shard_path), mode="r")
    except Exception:
        continue
    for key in ("global_index", "flux", "status", "message"):
        if key not in root:
            root = None
            break
    if root is None:
        continue
    try:
        gidx = np.asarray(root["global_index"][:], dtype=np.int64)
        flux = np.asarray(root["flux"][:], dtype=np.float32)
        status = np.asarray(root["status"][:])
    except Exception:
        continue
    if gidx.ndim != 1 or gidx.size == 0:
        continue
    if flux.ndim != 2 or flux.shape[0] != gidx.size:
        continue
    if status.ndim != 1 or status.shape[0] != gidx.size:
        continue
    if np.any(gidx < 0) or np.any(gidx >= row_count):
        continue
    if np.unique(gidx).size != gidx.size:
        continue
    if not np.all(np.isfinite(flux)):
        continue
    statuses = []
    for item in status.tolist():
        if isinstance(item, (bytes, bytearray)):
            item = item.decode("utf-8", errors="ignore")
        statuses.append(str(item).strip().lower())
    if any(s not in {"success", "skipped"} for s in statuses):
        continue
    seen.add(shard_idx)

missing = sorted(set(range(expected_shards)) - seen)
text = "\n".join(str(x) for x in missing)
out_path.write_text(f"{text}\n" if text else "", encoding="utf-8")
print(
    f"[missing-shards] expected={expected_shards} valid={len(seen)} missing={len(missing)} stores={len(list(shard_dir.glob('spectra_shard_*.zarr')))}",
    file=sys.stderr,
)
PY
}

############################################
# Resume setup
############################################

if [[ -z "${SHARDS_DIR}" || "${SHARDS_DIR}" == "/" ]]; then
    echo "[turbospec] ERROR: unsafe SHARDS_DIR='${SHARDS_DIR}' for shard cleanup." >&2
    exit 1
fi

if [[ "$(to_bool01 "${FORCE_RESTART}")" == "1" ]]; then
    echo "[turbospec] Force restart requested; clearing previous shard outputs."
    find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' -exec rm -rf {} +
    rm -f "${MISSING_FILE}" "${PENDING_SHARDS_FILE}" "${NEXT_WORK_ITEM}"
    if [[ -d "${MERGED_ZARR}" ]]; then
        rm -rf "${MERGED_ZARR}"
    fi
fi

write_missing_shards_file 2>> "${LOG_DIR}/missing.log"
cp "${MISSING_FILE}" "${PENDING_SHARDS_FILE}"
PENDING_COUNT=$(wc -l < "${PENDING_SHARDS_FILE}" | tr -d '[:space:]')
echo 0 > "${NEXT_WORK_ITEM}"

COMPLETED_COUNT=$((SHARD_COUNT - PENDING_COUNT))
echo "[turbospec] Existing valid shards: ${COMPLETED_COUNT}/${SHARD_COUNT}"

############################################
# Worker
############################################

worker() {
    local jobfs_dir task_index shard available
    jobfs_dir="${TMP_WORK_DIR}/worker_${RANDOM}"
    mkdir -p "${jobfs_dir}"

    while true; do

        #################################
        # Walltime protection
        #################################

        if (( $(time_left) < EST_RUNTIME + SAFETY_BUFFER )); then
            echo "Worker exiting safely before walltime."
            break
        fi

        #################################
        # Scratch precheck
        #################################

        available=$(df -Pk "${jobfs_dir}" | awk 'NR==2 {print $4}')

        # Require ~5GB free
        if (( available < 5*1024*1024 )); then
            echo "Low scratch — sleeping."
            sleep 60
            continue
        fi

        #################################
        # Atomic shard grab
        #################################

        exec 9<>"${LOCK_FILE}"
        flock -x 9

        task_index=$(cat "${NEXT_WORK_ITEM}")
        echo $((task_index + 1)) > "${NEXT_WORK_ITEM}"

        flock -u 9
        exec 9>&-

        if (( task_index >= PENDING_COUNT )); then
            break
        fi

        shard="$(sed -n "$((task_index + 1))p" "${PENDING_SHARDS_FILE}")"
        if [[ -z "${shard}" ]]; then
            break
        fi

        #################################
        # Retry with jitter
        #################################

        if ! run_shard_attempts "${shard}" "${SHARD_RETRY_ATTEMPTS}" "${jobfs_dir}" "${LOG_DIR}/shard_${shard}.log" 15; then
            echo "Shard ${shard} failed after ${SHARD_RETRY_ATTEMPTS} attempts in main loop." >> "${LOG_DIR}/shard_${shard}.log"
        fi
    done
}

export -f worker
export NEXT_WORK_ITEM LOCK_FILE PENDING_COUNT PENDING_SHARDS_FILE SHARD_COUNT LOG_DIR REPO PYTHON PBS_JOBID CONFIG_PATH TMP_OUTPUT_DIR

############################################
# Launch workers (start conservative!)
############################################

if (( PENDING_COUNT > 0 )); then
    echo "Launching ${WORKERS} workers for ${PENDING_COUNT} pending shard IDs..."
    for ((i=0; i<WORKERS; i++)); do
        worker &
    done
    wait
else
    echo "[turbospec] No pending shard IDs detected; moving directly to validation/merge."
fi

CURRENT=$(cat "${NEXT_WORK_ITEM}")

if (( CURRENT < PENDING_COUNT )); then
    echo "[turbospec] NOTICE: walltime ended before all pending shard IDs were assigned (${CURRENT}/${PENDING_COUNT})."
fi

mkdir -p "$(dirname "${MISSING_FILE}")"
write_missing_shards_file 2>> "${LOG_DIR}/missing.log"
FINAL_MISSING=$(wc -l < "${MISSING_FILE}" | tr -d '[:space:]')

echo "[turbospec] Failed shard report written: ${MISSING_FILE} (count=${FINAL_MISSING})"
if (( FINAL_MISSING > 0 )); then
    echo "First 20 missing shard IDs:"
    head -n 20 "${MISSING_FILE}"
fi

echo "[turbospec] Validating shard outputs..."
set +e
"${PYTHON}" "${REPO}/scripts/validate_dataset.py" \
    --shard-dir "${SHARDS_DIR}" \
    --expected-shards "${SHARD_COUNT}" \
    --workers "${VALIDATE_WORKERS}"
VALIDATE_RC=$?
set -e
if (( VALIDATE_RC != 0 )); then
    echo "[turbospec] WARN: validation exited with code ${VALIDATE_RC}; continuing with merge."
fi

SHARD_STORE_COUNT=$(find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' | wc -l | tr -d '[:space:]')
if (( SHARD_STORE_COUNT == 0 )); then
    echo "[turbospec] ERROR: no shard stores were produced in ${SHARDS_DIR}; skipping merge." >&2
    echo "[turbospec] ERROR: inspect ${LOG_DIR}/shard_*.log for worker failures." >&2
    FIRST_SHARD_LOG=""
    if compgen -G "${LOG_DIR}/shard_*.log" > /dev/null; then
        FIRST_SHARD_LOG="$(printf '%s\n' "${LOG_DIR}"/shard_*.log | sort | head -n 1)"
    fi
    if [[ -n "${FIRST_SHARD_LOG}" && -f "${FIRST_SHARD_LOG}" ]]; then
        echo "[turbospec] ERROR: first shard log excerpt (${FIRST_SHARD_LOG}):" >&2
        sed -n '1,120p' "${FIRST_SHARD_LOG}" >&2 || true
    fi
    exit 1
fi

MERGE_CMD=(
    "${PYTHON}" "${REPO}/scripts/merge_spectra_shards.py"
    --shard-dir "${SHARDS_DIR}"
    --grid-zarr "${GRID_ZARR}"
    --output-zarr "${MERGED_ZARR}"
    --chunk-rows "${MERGE_CHUNK_ROWS}"
    --tmp-dir "${TMP_SYSTEM_DIR}"
)

if (( FINAL_MISSING > 0 )); then
    if [[ "$(to_bool01 "${ALLOW_PARTIAL_MERGE}")" == "1" ]]; then
        echo "[turbospec] WARN: missing shards detected; enabling partial merge (--allow-missing --skip-nonexistent-shards)."
        MERGE_CMD+=(--allow-missing --skip-nonexistent-shards)
    else
        echo "[turbospec] ERROR: ${FINAL_MISSING} shard IDs are still missing; merge aborted." >&2
        exit 1
    fi
fi

echo "[turbospec] Merging shard outputs..."
"${MERGE_CMD[@]}"
echo "[turbospec] Merge complete: ${MERGED_ZARR}"
