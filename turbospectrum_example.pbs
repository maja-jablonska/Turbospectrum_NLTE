#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N turbospec
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail
cd $PBS_O_WORKDIR

############################################
# Thread caps (CRITICAL)
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

# Prevent mixed-prefix Python startup failures on HPC nodes.
unset PYTHONHOME || true
unset PYTHONPATH || true
PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[turbospec] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[turbospec] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[turbospec] Python: ${PYTHON}"
echo "[turbospec] Mamba env: ${MAMBA_ENV_NAME}"
echo "[turbospec] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Paths
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
RUN_ROOT="${RUN_ROOT:-/scratch/${PROJECT}/${USER_ID}/Turbospectrum_NLTE}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
WORKERS_OVERRIDE="${WORKERS:-}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO=$(cd "${REPO}" >/dev/null 2>&1 && pwd)

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[turbospec] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

CONFIG_OUTPUTS=$(
    "${PYTHON}" - <<PY
import json
import os

cfg_path = os.path.abspath(r"${CONFIG_PATH}")
cfg_dir = os.path.dirname(cfg_path)
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
outs = cfg.get("outputs", {}) or {}
runtime = cfg.get("runtime", {}) or {}

def _abs(p):
    if not p:
        return ""
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cfg_dir, p))

grid = _abs(outs.get("grid_zarr"))
shard_tmpl = _abs(outs.get("spectra_shard_template"))
merged = _abs(outs.get("spectra_zarr"))
shards_dir = os.path.dirname(shard_tmpl) if shard_tmpl else ""
workers = runtime.get("workers")
workers_out = ""
if workers not in (None, ""):
    try:
        workers_out = str(int(workers))
    except Exception:
        workers_out = ""

print(grid)
print(shards_dir)
print(merged)
print(workers_out)
PY
)
mapfile -t _cfg_lines <<< "${CONFIG_OUTPUTS}"
CFG_GRID_ZARR="${_cfg_lines[0]:-}"
CFG_SHARDS_DIR="${_cfg_lines[1]:-}"
CFG_MERGED_ZARR="${_cfg_lines[2]:-}"
CFG_WORKERS="${_cfg_lines[3]:-}"

WORKERS="${WORKERS_OVERRIDE:-${CFG_WORKERS:-16}}"

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR:-${RUN_ROOT}/grid/parameter_grid.zarr}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR:-${RUN_ROOT}/shards}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR:-${RUN_ROOT}/synthesized_spectra.zarr}}"

if [[ "${GRID_ZARR}" != /* ]]; then
    GRID_ZARR="${REPO}/${GRID_ZARR}"
fi
if [[ "${SHARDS_DIR}" != /* ]]; then
    SHARDS_DIR="${REPO}/${SHARDS_DIR}"
fi
if [[ "${MERGED_ZARR}" != /* ]]; then
    MERGED_ZARR="${REPO}/${MERGED_ZARR}"
fi

NEXT_SHARD="${NEXT_SHARD:-${RUN_ROOT}/next_shard.txt}"
LOCK_FILE="${LOCK_FILE:-${RUN_ROOT}/counter.lock}"
LOG_DIR="${LOG_DIR:-${RUN_ROOT}/logs}"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"
mkdir -p "${LOG_DIR}" "${SHARDS_DIR}" "$(dirname "${NEXT_SHARD}")" "$(dirname "${LOCK_FILE}")" \
         "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}"
MAX_RESUBMITS="${MAX_RESUBMITS:-1}"                        # max automatic qsub continuation attempts (hard cap)
RESUBMIT_COUNT="${RESUBMIT_COUNT:-0}"                      # current automatic resubmit count (0 = first submission)

if ! [[ "${MAX_RESUBMITS}" =~ ^[0-9]+$ ]]; then
    echo "[turbospec] WARN: invalid MAX_RESUBMITS='${MAX_RESUBMITS}', defaulting to 1." >&2
    MAX_RESUBMITS=1
fi
if ! [[ "${RESUBMIT_COUNT}" =~ ^[0-9]+$ ]]; then
    echo "[turbospec] WARN: invalid RESUBMIT_COUNT='${RESUBMIT_COUNT}', defaulting to 0." >&2
    RESUBMIT_COUNT=0
fi

STATE_FOUND=0
if [[ -f "${NEXT_SHARD}" ]]; then
    STATE_FOUND=1
elif [[ -n "$(find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' -print -quit 2>/dev/null)" ]]; then
    STATE_FOUND=1
fi

# Force mkstemp()/tempfile users to write under designated scratch temp.
export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

echo "[turbospec] Repo: ${REPO}"
echo "[turbospec] Config: ${CONFIG_PATH}"
echo "[turbospec] Grid: ${GRID_ZARR}"
echo "[turbospec] Shards: ${SHARDS_DIR}"
echo "[turbospec] Merged: ${MERGED_ZARR}"
echo "[turbospec] Scratch tmp root: ${SCRATCH_TMP_ROOT}"
echo "[turbospec] Workers: ${WORKERS}"
echo "[turbospec] Auto-resubmits used/max: ${RESUBMIT_COUNT}/${MAX_RESUBMITS}"
echo "[turbospec] Prior shard state found: ${STATE_FOUND}"

CONFIG_NUM_SAMPLES=$(
    "${PYTHON}" - <<PY
import json
with open(r"${CONFIG_PATH}", "r", encoding="utf-8") as f:
    cfg = json.load(f)
print(int((cfg.get("grid") or {}).get("num_samples", 0)))
PY
)

if (( STATE_FOUND == 1 )); then
    echo "[turbospec] Existing shard state detected; preserving shards and counter for recovery."
fi

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec] Grid not found; generating grid (num_samples=${CONFIG_NUM_SAMPLES})."
    "${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
        --config "${CONFIG_PATH}" \
        --skip-synthesis
else
    echo "[turbospec] Using existing grid: ${GRID_ZARR}"
fi

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec] ERROR: grid zarr still not found after generation: ${GRID_ZARR}" >&2
    exit 1
fi

############################################
# Grid sanity check
############################################

ROW_COUNT=$(${PYTHON} - <<PY
import zarr
root = zarr.open_group(r"${GRID_ZARR}", mode="r")
for key in ("teff", "params", "global_index"):
    if key in root and len(root[key].shape) >= 1:
        print(int(root[key].shape[0]))
        break
else:
    raise RuntimeError(f"Could not infer row count from {r'${GRID_ZARR}'}")
PY
)

echo "Grid rows: ${ROW_COUNT}"

############################################
# Initialize atomic counter (ONLY once)
############################################

if [[ ! -f "${NEXT_SHARD}" ]]; then
    echo "Initializing shard counter"
    echo 0 > "${NEXT_SHARD}"
fi

############################################
# Walltime guard
############################################

WALLTIME_SECONDS=$((12*3600))
START_TIME=$(date +%s)

SAFETY_BUFFER="${SAFETY_BUFFER:-900}"  # stop 15 minutes early
EST_RUNTIME="${EST_RUNTIME:-600}"      # expected shard runtime (tune later)
SHARD_RETRY_ATTEMPTS="${SHARD_RETRY_ATTEMPTS:-3}"          # attempts during the main worker loop
RECOVERY_PASSES="${RECOVERY_PASSES:-2}"                    # post-pass missing-shard recovery passes
RECOVERY_RETRY_ATTEMPTS="${RECOVERY_RETRY_ATTEMPTS:-2}"    # attempts per shard in each recovery pass
RECOVERY_JITTER_BASE="${RECOVERY_JITTER_BASE:-20}"         # backoff base (seconds)
MISSING_FILE="${MISSING_FILE:-${RUN_ROOT}/missing_shards.txt}"

time_left () {
    echo $((WALLTIME_SECONDS - ($(date +%s) - START_TIME)))
}

is_valid_shard () {
    local shard_path="$1"
    ${PYTHON} - <<PY >/dev/null 2>&1
import zarr
root = zarr.open_group(r"${shard_path}", mode="r")
assert "flux" in root and "wavelength" in root and root["flux"].shape[0] > 0
PY
}

run_shard_attempts () {
    local shard="$1"
    local max_attempts="$2"
    local scratch_root="$3"
    local log_file="$4"
    local sleep_base="$5"

    local out="${SHARDS_DIR}/spectra_shard_${shard}.zarr"
    local tmp_out="${TMP_OUTPUT_DIR}/spectra_shard_${shard}.a$$.tmp.zarr"

    for ((attempt=1; attempt<=max_attempts; attempt++)); do
        local start end attempt_scratch
        start=$(date +%s)
        attempt_scratch="${scratch_root}/shard_${shard}_a${attempt}"
        mkdir -p "${attempt_scratch}"

        ${PYTHON} ${REPO}/scripts/pipeline_from_config.py \
          --config "${CONFIG_PATH}" \
          --skip-grid \
          --synthesis-mode sharded \
          --shard-index "${shard}" \
          --shard-count "${ROW_COUNT}" \
          --workers 1 \
          --scratch "${attempt_scratch}" \
          --output "${tmp_out}" \
          >> "${log_file}" 2>&1 || true

        if is_valid_shard "${out}"; then
            end=$(date +%s)
            echo "runtime_seconds=$((end-start)) attempt=${attempt}" >> "${log_file}"
            return 0
        fi

        rm -rf "${tmp_out}" "${out}"
        sleep $(( (RANDOM % 10) + attempt * sleep_base ))
    done

    return 1
}

resubmit_self () {
    if (( RESUBMIT_COUNT >= MAX_RESUBMITS )); then
        echo "[turbospec] Auto-resubmit limit reached (${RESUBMIT_COUNT}/${MAX_RESUBMITS}); not resubmitting."
        return 1
    fi

    local next_resubmit
    next_resubmit=$((RESUBMIT_COUNT + 1))
    echo "[turbospec] Resubmitting for remaining/failed shards (attempt ${next_resubmit}/${MAX_RESUBMITS})."
    qsub -v "PYTHON_BIN=${PYTHON_BIN},MAMBA_ENV_NAME=${MAMBA_ENV_NAME},PROJECT=${PROJECT},USER_ID=${USER_ID},RUN_ROOT=${RUN_ROOT},REPO=${REPO},CONFIG_PATH=${CONFIG_PATH},GRID_ZARR=${GRID_ZARR},SHARDS_DIR=${SHARDS_DIR},MERGED_ZARR=${MERGED_ZARR},NEXT_SHARD=${NEXT_SHARD},LOCK_FILE=${LOCK_FILE},LOG_DIR=${LOG_DIR},WORKERS=${WORKERS},SAFETY_BUFFER=${SAFETY_BUFFER},EST_RUNTIME=${EST_RUNTIME},SHARD_RETRY_ATTEMPTS=${SHARD_RETRY_ATTEMPTS},RECOVERY_PASSES=${RECOVERY_PASSES},RECOVERY_RETRY_ATTEMPTS=${RECOVERY_RETRY_ATTEMPTS},RECOVERY_JITTER_BASE=${RECOVERY_JITTER_BASE},MISSING_FILE=${MISSING_FILE},MAX_RESUBMITS=${MAX_RESUBMITS},RESUBMIT_COUNT=${next_resubmit},SCRATCH_TMP_ROOT=${SCRATCH_TMP_ROOT},TMP_SYSTEM_DIR=${TMP_SYSTEM_DIR},TMP_WORK_DIR=${TMP_WORK_DIR},TMP_OUTPUT_DIR=${TMP_OUTPUT_DIR}" "$0"
}

############################################
# Worker
############################################

worker() {

    JOBFS_DIR=${TMP_WORK_DIR}/worker_${RANDOM}
    mkdir -p $JOBFS_DIR

    while true; do

        #################################
        # Walltime protection
        #################################

        if (( $(time_left) < EST_RUNTIME + SAFETY_BUFFER )); then
            echo "Worker exiting safely before walltime."
            break
        fi

        #################################
        # Scratch precheck
        #################################

        AVAILABLE=$(df -Pk "$JOBFS_DIR" | awk 'NR==2 {print $4}')

        # Require ~5GB free
        if (( AVAILABLE < 5*1024*1024 )); then
            echo "Low scratch — sleeping."
            sleep 60
            continue
        fi

        #################################
        # Atomic shard grab
        #################################

        exec 9<>${LOCK_FILE}
        flock -x 9

        shard=$(cat ${NEXT_SHARD})
        echo $((shard + 1)) > ${NEXT_SHARD}

        flock -u 9
        exec 9>&-

        if (( shard >= ROW_COUNT )); then
            break
        fi

        OUT=${SHARDS_DIR}/spectra_shard_${shard}.zarr

        #################################
        # Skip valid shards
        #################################

        if is_valid_shard "${OUT}"; then
            continue
        fi

        #################################
        # Retry with jitter
        #################################

        if ! run_shard_attempts "${shard}" "${SHARD_RETRY_ATTEMPTS}" "${JOBFS_DIR}" "${LOG_DIR}/shard_${shard}.log" 15; then
            echo "Shard ${shard} failed after ${SHARD_RETRY_ATTEMPTS} attempts in main loop." >> "${LOG_DIR}/shard_${shard}.log"
        fi
    done
}

export -f worker
export NEXT_SHARD LOCK_FILE ROW_COUNT LOG_DIR REPO PYTHON PBS_JOBID CONFIG_PATH TMP_OUTPUT_DIR

############################################
# Launch workers (start conservative!)
############################################

echo "Launching ${WORKERS} workers..."

for ((i=0;i<WORKERS;i++)); do
    worker &
done

wait

############################################
# Auto-resubmit if shards remain
############################################

CURRENT=$(cat ${NEXT_SHARD})

if (( CURRENT < ROW_COUNT )); then
    echo "Shards remaining ($CURRENT / $ROW_COUNT)."
    if resubmit_self; then
        exit 0
    fi
    echo "[turbospec] Continuing without further resubmits."
fi

mkdir -p "$(dirname "${MISSING_FILE}")"

if (( RESUBMIT_COUNT >= MAX_RESUBMITS )); then
    echo "[turbospec] Job has already been resubmitted once (${RESUBMIT_COUNT}/${MAX_RESUBMITS}); skipping recovery and merging current results as-is."
else
    echo "All shard IDs assigned. Running post-pass recovery for failed shards..."
    for ((pass=1; pass<=RECOVERY_PASSES; pass++)); do
        ${PYTHON} ${REPO}/scripts/find_missing_shards.py \
            --shard-dir "${SHARDS_DIR}" \
            --expected-shards "${ROW_COUNT}" \
            --output "${MISSING_FILE}" \
            2>> "${LOG_DIR}/recovery.log"

        MISSING_COUNT=$(wc -l < "${MISSING_FILE}" | tr -d '[:space:]')
        if (( MISSING_COUNT == 0 )); then
            echo "Recovery pass ${pass}: no missing shards left." | tee -a "${LOG_DIR}/recovery.log"
            break
        fi

        echo "Recovery pass ${pass}/${RECOVERY_PASSES}: ${MISSING_COUNT} missing shard(s)." | tee -a "${LOG_DIR}/recovery.log"

        while IFS= read -r shard; do
            [[ -z "${shard}" ]] && continue
            if ! [[ "${shard}" =~ ^[0-9]+$ ]]; then
                echo "Skipping invalid shard id '${shard}' in ${MISSING_FILE}" | tee -a "${LOG_DIR}/recovery.log"
                continue
            fi

            if (( $(time_left) < EST_RUNTIME + SAFETY_BUFFER )); then
                echo "Low walltime during recovery; resubmitting job for continuation." | tee -a "${LOG_DIR}/recovery.log"
                if resubmit_self; then
                    exit 0
                fi
                echo "[turbospec] Recovery continuation skipped because auto-resubmit limit is reached." | tee -a "${LOG_DIR}/recovery.log"
                break
            fi

            SHARD_OUT="${SHARDS_DIR}/spectra_shard_${shard}.zarr"
            SHARD_LOG="${LOG_DIR}/shard_${shard}.recovery_pass${pass}.log"
            if is_valid_shard "${SHARD_OUT}"; then
                continue
            fi

            if ! run_shard_attempts "${shard}" "${RECOVERY_RETRY_ATTEMPTS}" "${TMP_WORK_DIR}/recovery_pass${pass}" "${SHARD_LOG}" "${RECOVERY_JITTER_BASE}"; then
                echo "Shard ${shard} still failed after recovery pass ${pass}." >> "${SHARD_LOG}"
            fi
        done < "${MISSING_FILE}"
    done
fi

${PYTHON} ${REPO}/scripts/find_missing_shards.py \
    --shard-dir "${SHARDS_DIR}" \
    --expected-shards "${ROW_COUNT}" \
    --output "${MISSING_FILE}" \
    2>> "${LOG_DIR}/recovery.log"
FINAL_MISSING=$(wc -l < "${MISSING_FILE}" | tr -d '[:space:]')

MERGE_EXTRA=()
if (( FINAL_MISSING == 0 )); then
    echo "All shards recovered. Validating completeness before merge..."
    ${PYTHON} ${REPO}/scripts/validate_dataset.py \
        --shard-dir "${SHARDS_DIR}" \
        --expected-shards "${ROW_COUNT}" \
        | tee "${LOG_DIR}/validate.log"
else
    echo "WARNING: ${FINAL_MISSING} shard(s) still missing after recovery; proceeding with partial merge." | tee -a "${LOG_DIR}/recovery.log"
    echo "Missing shard list: ${MISSING_FILE}" | tee -a "${LOG_DIR}/recovery.log"
    MERGE_EXTRA+=(--allow-missing)
fi

echo "Merging shards..."
${PYTHON} ${REPO}/scripts/merge_spectra_shards.py \
    --shard-dir "${SHARDS_DIR}" \
    --grid-zarr "${GRID_ZARR}" \
    --output-zarr "${MERGED_ZARR}" \
    --tmp-dir "${TMP_SYSTEM_DIR}" \
    "${MERGE_EXTRA[@]}" \
    > "${LOG_DIR}/merge.log" 2>&1
