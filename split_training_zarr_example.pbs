#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N zsplit
#PBS -r y
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89+gdata/y89

# Shuffle-and-split a training .zarr into ~equal-size stores
# (scripts/split_training_zarr.py). I/O-bound, single-process — 1 cpu is enough.
#
# Two modes, auto-detected:
#
#   1) Single job – writes all splits sequentially (resumes: existing splits
#      are skipped, so just resubmit if walltime runs out)
#      qsub -v INPUT_ZARR=/scratch/.../train.zarr,OUTPUT_DIR=/scratch/.../splits split_training_zarr_example.pbs
#
#   2) Array job – one split per task (run --dry-run first to get the split
#      count N, then submit -J 0-$((N-1)))
#      qsub -J 0-11 -v INPUT_ZARR=...,OUTPUT_DIR=... split_training_zarr_example.pbs
#
# Useful -v knobs (all optional):
#   TARGET_GB=10        target size per split in GiB (on-disk basis)
#   SIZE_BASIS=disk     disk (compressed) | logical (uncompressed)
#   NUM_SPLITS=N        override sizing: exact number of splits
#   ROWS_PER_SPLIT=R    override sizing: exact rows per split
#   SEED=0              shuffle seed — MUST match across array tasks
#   PREFIX=name         output store name prefix
#   BATCH_ROWS=N        rows per streamed read batch
#   CHUNK_ROWS=N        output row chunking
#   DRY_RUN=1           print the split plan and exit

set -euo pipefail
cd "${PBS_O_WORKDIR}"

TAG="zsplit"

############################################
# Thread caps
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

unset PYTHONHOME || true
unset PYTHONPATH || true

############################################
# Environment activation
############################################

PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[${TAG}] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[${TAG}] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[${TAG}] Python: ${PYTHON}"

############################################
# Variables
############################################

REPO="${REPO:-${PBS_O_WORKDIR}}"
if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO="$(cd "${REPO}" >/dev/null 2>&1 && pwd)"

INPUT_ZARR="${INPUT_ZARR:-}"
OUTPUT_DIR="${OUTPUT_DIR:-}"
TARGET_GB="${TARGET_GB:-10}"
SIZE_BASIS="${SIZE_BASIS:-disk}"
SEED="${SEED:-0}"

if [[ -z "${INPUT_ZARR}" ]]; then
    echo "[${TAG}] ERROR: INPUT_ZARR is required (qsub -v INPUT_ZARR=/path/to/train.zarr,...)." >&2
    exit 1
fi
if [[ -z "${OUTPUT_DIR}" ]]; then
    echo "[${TAG}] ERROR: OUTPUT_DIR is required (qsub -v OUTPUT_DIR=/path/to/splits,...)." >&2
    exit 1
fi
if [[ ! -d "${INPUT_ZARR}" ]]; then
    echo "[${TAG}] ERROR: input zarr not found: ${INPUT_ZARR}" >&2
    exit 1
fi

CMD=(
    "${PYTHON}" "${REPO}/scripts/split_training_zarr.py"
    --input "${INPUT_ZARR}"
    --output-dir "${OUTPUT_DIR}"
    --target-gb "${TARGET_GB}"
    --size-basis "${SIZE_BASIS}"
    --seed "${SEED}"
)

if [[ -n "${NUM_SPLITS:-}" ]];     then CMD+=(--num-splits "${NUM_SPLITS}"); fi
if [[ -n "${ROWS_PER_SPLIT:-}" ]]; then CMD+=(--rows-per-split "${ROWS_PER_SPLIT}"); fi
if [[ -n "${PREFIX:-}" ]];         then CMD+=(--prefix "${PREFIX}"); fi
if [[ -n "${BATCH_ROWS:-}" ]];     then CMD+=(--batch-rows "${BATCH_ROWS}"); fi
if [[ -n "${CHUNK_ROWS:-}" ]];     then CMD+=(--chunk-rows "${CHUNK_ROWS}"); fi
if [[ "${DRY_RUN:-0}" == "1" ]];   then CMD+=(--dry-run); fi

############################################
# Mode detection
############################################

if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    echo "[${TAG}] Mode: array task (split ${PBS_ARRAY_INDEX}, seed ${SEED})"
    CMD+=(--split-index "${PBS_ARRAY_INDEX}")
else
    echo "[${TAG}] Mode: single job (all splits)"
fi

echo "[${TAG}] Input:  ${INPUT_ZARR}"
echo "[${TAG}] Output: ${OUTPUT_DIR}"

"${CMD[@]}"
echo "[${TAG}] Done."
