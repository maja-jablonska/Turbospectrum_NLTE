#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N ts-merge
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l jobfs=50GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail
cd "${PBS_O_WORKDIR}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

unset PYTHONHOME || true
unset PYTHONPATH || true

PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[merge] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[merge] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[merge] Python: ${PYTHON}"
echo "[merge] Mamba env: ${MAMBA_ENV_NAME}"
echo "[merge] Conda prefix: ${CONDA_PREFIX:-<unset>}"

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
RUN_ROOT="${RUN_ROOT:-/scratch/${PROJECT}/${USER_ID}/Turbospectrum_NLTE}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
MERGE_CHUNK_ROWS="${MERGE_CHUNK_ROWS:-128}"
ALLOW_MISSING="${ALLOW_MISSING:-0}"
ALLOW_INCOMPLETE_PROVENANCE="${ALLOW_INCOMPLETE_PROVENANCE:-0}"
SKIP_BAD_SHARDS="${SKIP_BAD_SHARDS:-1}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO="$(cd "${REPO}" >/dev/null 2>&1 && pwd)"

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi

to_bool01() {
    local val
    val="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "${val}" in
        1|true|yes|on) echo 1 ;;
        *) echo 0 ;;
    esac
}

CONFIG_OUTPUTS=""
if [[ -f "${CONFIG_PATH}" ]]; then
    CONFIG_OUTPUTS=$(
        "${PYTHON}" - <<PY
import json
import os

cfg_path = os.path.abspath(r"${CONFIG_PATH}")
cfg_dir = os.path.dirname(cfg_path)
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
outs = cfg.get("outputs", {}) or {}

def _abs(p):
    if not p:
        return ""
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cfg_dir, p))

grid = _abs(outs.get("grid_zarr"))
shard_tmpl = _abs(outs.get("spectra_shard_template"))
merged = _abs(outs.get("spectra_zarr"))
shards_dir = os.path.dirname(shard_tmpl) if shard_tmpl else ""

print(grid)
print(shards_dir)
print(merged)
PY
    )
fi

mapfile -t _cfg_lines <<< "${CONFIG_OUTPUTS}"
CFG_GRID_ZARR="${_cfg_lines[0]:-}"
CFG_SHARDS_DIR="${_cfg_lines[1]:-}"
CFG_MERGED_ZARR="${_cfg_lines[2]:-}"

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR:-${RUN_ROOT}/outputs/grids/parameter_grid.zarr}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR:-${RUN_ROOT}/outputs/shards}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR:-${RUN_ROOT}/outputs/zarr/synthesized_spectra.zarr}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${RUN_ROOT}/tmp/merge_${PBS_JOBID}}"

if [[ "${GRID_ZARR}" != /* ]]; then
    GRID_ZARR="${REPO}/${GRID_ZARR}"
fi
if [[ "${SHARDS_DIR}" != /* ]]; then
    SHARDS_DIR="${REPO}/${SHARDS_DIR}"
fi
if [[ "${MERGED_ZARR}" != /* ]]; then
    MERGED_ZARR="${REPO}/${MERGED_ZARR}"
fi
if [[ "${TMP_SYSTEM_DIR}" != /* ]]; then
    TMP_SYSTEM_DIR="${REPO}/${TMP_SYSTEM_DIR}"
fi

mkdir -p "${TMP_SYSTEM_DIR}" "$(dirname "${MERGED_ZARR}")"
export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

if ! [[ "${MERGE_CHUNK_ROWS}" =~ ^[0-9]+$ ]] || (( MERGE_CHUNK_ROWS < 1 )); then
    echo "[merge] ERROR: MERGE_CHUNK_ROWS must be a positive integer." >&2
    exit 1
fi

if [[ ! -d "${SHARDS_DIR}" ]]; then
    echo "[merge] ERROR: shard directory not found: ${SHARDS_DIR}" >&2
    exit 1
fi

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[merge] WARN: grid zarr not found: ${GRID_ZARR}" >&2
    echo "[merge] WARN: proceeding without --grid-zarr; row count will be inferred from shards." >&2
fi

echo "[merge] Repo: ${REPO}"
echo "[merge] Config: ${CONFIG_PATH}"
echo "[merge] Shards: ${SHARDS_DIR}"
echo "[merge] Grid: ${GRID_ZARR}"
echo "[merge] Output: ${MERGED_ZARR}"
echo "[merge] Chunk rows: ${MERGE_CHUNK_ROWS}"
echo "[merge] Allow missing: ${ALLOW_MISSING}"
echo "[merge] Allow incomplete provenance: ${ALLOW_INCOMPLETE_PROVENANCE}"
echo "[merge] Skip bad shards: ${SKIP_BAD_SHARDS}"
echo "[merge] TMPDIR: ${TMPDIR}"

MERGE_CMD=(
    "${PYTHON}" "${REPO}/scripts/merge_spectra_shards.py"
    --shard-dir "${SHARDS_DIR}"
    --output-zarr "${MERGED_ZARR}"
    --chunk-rows "${MERGE_CHUNK_ROWS}"
    --tmp-dir "${TMPDIR}"
)

if [[ -d "${GRID_ZARR}" ]]; then
    MERGE_CMD+=(--grid-zarr "${GRID_ZARR}")
fi

if [[ "$(to_bool01 "${ALLOW_MISSING}")" == "1" ]]; then
    MERGE_CMD+=(--allow-missing --skip-nonexistent-shards)
fi

if [[ "$(to_bool01 "${SKIP_BAD_SHARDS}")" == "1" ]]; then
    MERGE_CMD+=(--skip-invalid-shards)
fi

if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    MERGE_CMD+=(--allow-incomplete-provenance)
fi

echo "[merge] Running shard merge..."
"${MERGE_CMD[@]}"
echo "[merge] Merge complete: ${MERGED_ZARR}"
