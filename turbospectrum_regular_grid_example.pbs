#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N ts-regular-grid
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89

# Usage examples:
#   qsub -v CONFIG_PATH=configs/pipeline/config_regular_grid.example.json turbospectrum_regular_grid_example.pbs
#   qsub -J 0-511 -v CONFIG_PATH=configs/pipeline/config_regular_grid.example.json,ROWS_PER_SHARD=128,WORKERS=32 turbospectrum_regular_grid_example.pbs
#   qsub -J 0-9 -v CONFIG_PATH=configs/pipeline/config_regular_grid.example.json,SHARD_COUNT=10,WORKERS=32 turbospectrum_regular_grid_example.pbs
#   qsub -v CONFIG_PATH=configs/pipeline/config_regular_grid.example.json,FINALIZE_ONLY=1 turbospectrum_regular_grid_example.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR}"

############################################
# Thread caps
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

# Prevent mixed-prefix Python startup failures on HPC nodes.
unset PYTHONHOME || true
unset PYTHONPATH || true

############################################
# Environment activation
############################################

PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[regular-grid] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[regular-grid] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[regular-grid] Python: ${PYTHON}"
echo "[regular-grid] Mamba env: ${MAMBA_ENV_NAME}"
echo "[regular-grid] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Paths
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
RUN_ROOT="${RUN_ROOT:-/scratch/${PROJECT}/${USER_ID}/Turbospectrum_NLTE_regular}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_regular_grid.example.json}"
WORKERS_OVERRIDE="${WORKERS:-}"
SHARD_COUNT_OVERRIDE="${SHARD_COUNT:-}"
ROWS_PER_SHARD_OVERRIDE="${ROWS_PER_SHARD:-}"
SKIP_SYNTHESIS_OVERRIDE="${SKIP_SYNTHESIS:-}"
FINALIZE_ONLY="${FINALIZE_ONLY:-0}"
FORCE_RESTART="${FORCE_RESTART:-0}"
ALLOW_PARTIAL_MERGE="${ALLOW_PARTIAL_MERGE:-1}"
ALLOW_INCOMPLETE_PROVENANCE="${ALLOW_INCOMPLETE_PROVENANCE:-0}"
SKIP_BAD_SHARDS="${SKIP_BAD_SHARDS:-1}"
AUTO_PRUNE_STALE_SHARDS="${AUTO_PRUNE_STALE_SHARDS:-1}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO="$(cd "${REPO}" >/dev/null 2>&1 && pwd)"
LAYOUT_HELPER="${REPO}/scripts/resolve_shard_layout.py"

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[regular-grid] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

to_bool01() {
    local val
    val="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    case "${val}" in
        1|true|yes|on) echo 1 ;;
        *) echo 0 ;;
    esac
}

print_log_excerpt() {
    local log_path="$1"
    local label="$2"
    if [[ -f "${log_path}" ]]; then
        echo "[regular-grid] ${label}: ${log_path}" >&2
        if grep -Einq 'error|failed|exception|traceback|missing spectrum|forrtl|killed|oom|assert' "${log_path}"; then
            echo "[regular-grid] Matching error lines from ${log_path} (last 80):" >&2
            grep -Ein 'error|failed|exception|traceback|missing spectrum|forrtl|killed|oom|assert' "${log_path}" | tail -n 80 >&2 || true
        fi
        echo "[regular-grid] Last 120 lines from ${log_path}:" >&2
        tail -n 120 "${log_path}" >&2 || true
    fi
}

REGULAR_RUNTIME_JSON="$(
    "${PYTHON}" "${REPO}/scripts/synthesize_regular_grid.py" \
        --config-json "${CONFIG_PATH}" \
        --print-runtime-json
)"

RUNTIME_VALUES="$(
    "${PYTHON}" - <<PY
import json

payload = json.loads(r'''${REGULAR_RUNTIME_JSON}''')
fields = [
    "run_root",
    "grid_zarr",
    "spectra_zarr",
    "spectra_shard_template",
    "spectra_shards_dir",
    "synthesis_config_path",
    "scratch",
    "output_tmp",
    "workers",
    "shard_count",
    "rows_per_shard",
    "chunk_rows",
    "log_level",
    "log_file",
    "skip_synthesis",
]
for field in fields:
    value = payload.get(field, "")
    if value is None:
        value = ""
    print(value)
PY
)"

_runtime_lines=()
while IFS= read -r _runtime_line; do
    _runtime_lines+=("${_runtime_line}")
done <<< "${RUNTIME_VALUES}"
CFG_RUN_ROOT="${_runtime_lines[0]:-}"
CFG_GRID_ZARR="${_runtime_lines[1]:-}"
CFG_MERGED_ZARR="${_runtime_lines[2]:-}"
CFG_SHARD_TEMPLATE="${_runtime_lines[3]:-}"
CFG_SHARDS_DIR="${_runtime_lines[4]:-}"
CFG_SYNTH_CONFIG="${_runtime_lines[5]:-}"
CFG_SCRATCH="${_runtime_lines[6]:-}"
CFG_OUTPUT_TMP="${_runtime_lines[7]:-}"
CFG_WORKERS="${_runtime_lines[8]:-}"
CFG_SHARD_COUNT="${_runtime_lines[9]:-}"
CFG_ROWS_PER_SHARD="${_runtime_lines[10]:-}"
CFG_CHUNK_ROWS="${_runtime_lines[11]:-32}"
CFG_LOG_LEVEL="${_runtime_lines[12]:-INFO}"
CFG_LOG_FILE="${_runtime_lines[13]:-}"
CFG_SKIP_SYNTHESIS="${_runtime_lines[14]:-False}"

if [[ -n "${CFG_RUN_ROOT}" ]]; then
    RUN_ROOT="${CFG_RUN_ROOT}"
fi

WORKERS="${WORKERS_OVERRIDE:-${CFG_WORKERS:-16}}"
if ! [[ "${WORKERS}" =~ ^[0-9]+$ ]] || (( WORKERS < 1 )); then
    echo "[regular-grid] WARN: invalid WORKERS='${WORKERS}', defaulting to 16." >&2
    WORKERS=16
fi

DEFAULT_VALIDATE_WORKERS="${WORKERS}"
if (( DEFAULT_VALIDATE_WORKERS > 32 )); then
    DEFAULT_VALIDATE_WORKERS=32
fi
VALIDATE_WORKERS="${VALIDATE_WORKERS:-${DEFAULT_VALIDATE_WORKERS}}"
if ! [[ "${VALIDATE_WORKERS}" =~ ^[0-9]+$ ]] || (( VALIDATE_WORKERS < 1 )); then
    echo "[regular-grid] WARN: invalid VALIDATE_WORKERS='${VALIDATE_WORKERS}', defaulting to ${DEFAULT_VALIDATE_WORKERS}." >&2
    VALIDATE_WORKERS="${DEFAULT_VALIDATE_WORKERS}"
fi

MERGE_CHUNK_ROWS="${MERGE_CHUNK_ROWS:-128}"
if ! [[ "${MERGE_CHUNK_ROWS}" =~ ^[0-9]+$ ]] || (( MERGE_CHUNK_ROWS < 1 )); then
    echo "[regular-grid] WARN: invalid MERGE_CHUNK_ROWS='${MERGE_CHUNK_ROWS}', defaulting to 128." >&2
    MERGE_CHUNK_ROWS=128
fi

SKIP_SYNTHESIS_EFFECTIVE="$(to_bool01 "${CFG_SKIP_SYNTHESIS}")"
if [[ "$(to_bool01 "${SKIP_SYNTHESIS_OVERRIDE}")" == "1" ]]; then
    SKIP_SYNTHESIS_EFFECTIVE="1"
fi

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR}}"
SHARD_TEMPLATE="${SHARD_TEMPLATE:-${CFG_SHARD_TEMPLATE}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR}}"
SYNTH_CONFIG_PATH="${SYNTH_CONFIG_PATH:-${CFG_SYNTH_CONFIG}}"
SYNTH_SCRATCH="${SYNTH_SCRATCH:-${CFG_SCRATCH:-${RUN_ROOT}/tmp/synthesis}}"
LOG_DIR="${LOG_DIR:-${RUN_ROOT}/logs}"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"
PENDING_SHARDS_FILE="${PENDING_SHARDS_FILE:-${RUN_ROOT}/pending_shards.txt}"
MISSING_FILE="${MISSING_FILE:-${RUN_ROOT}/missing_shards.txt}"
NEXT_WORK_ITEM="${NEXT_WORK_ITEM:-${RUN_ROOT}/next_work_item.txt}"
LOCK_FILE="${LOCK_FILE:-${RUN_ROOT}/counter.lock}"
INITIAL_FAILURE_ABORT_THRESHOLD="${INITIAL_FAILURE_ABORT_THRESHOLD:-0}"
INITIAL_FAILURE_COUNT_FILE="${INITIAL_FAILURE_COUNT_FILE:-${RUN_ROOT}/initial_failure_count.txt}"
SUCCESS_COUNT_FILE="${SUCCESS_COUNT_FILE:-${RUN_ROOT}/success_count.txt}"
EARLY_STOP_MARKER="${EARLY_STOP_MARKER:-${RUN_ROOT}/early_stop_marker.txt}"
SYNTH_LOG_LEVEL="${SYNTH_LOG_LEVEL:-${CFG_LOG_LEVEL:-INFO}}"
SYNTH_LOG_FILE="${SYNTH_LOG_FILE:-${CFG_LOG_FILE:-${LOG_DIR}/regular_grid_synthesis.log}}"
ROWS_PER_SHARD_RAW="${ROWS_PER_SHARD_OVERRIDE:-${CFG_ROWS_PER_SHARD:-}}"
ARRAY_TASK_MODE=0
if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    ARRAY_TASK_MODE=1
fi
FINALIZE_ONLY_EFFECTIVE="$(to_bool01 "${FINALIZE_ONLY}")"
FORCE_RESTART_EFFECTIVE="$(to_bool01 "${FORCE_RESTART}")"
JOB_ID_BASE="${PBS_JOBID:-manual}"
JOB_ID_BASE="${JOB_ID_BASE%%[*}"
ARRAY_PREP_MARKER="${RUN_ROOT}/.regular_grid_array_prepare_${JOB_ID_BASE}.done"
ARRAY_PREP_FAILURE_MARKER="${RUN_ROOT}/.regular_grid_array_prepare_${JOB_ID_BASE}.failed"
ARRAY_PREP_LOCK_DIR="${RUN_ROOT}/.regular_grid_array_prepare_${JOB_ID_BASE}.lock"
ARRAY_PREP_TIMEOUT="${ARRAY_PREP_TIMEOUT:-3600}"
if ! [[ "${ARRAY_PREP_TIMEOUT}" =~ ^[0-9]+$ ]] || (( ARRAY_PREP_TIMEOUT < 1 )); then
    echo "[regular-grid] WARN: invalid ARRAY_PREP_TIMEOUT='${ARRAY_PREP_TIMEOUT}', defaulting to 3600." >&2
    ARRAY_PREP_TIMEOUT=3600
fi

mkdir -p "${LOG_DIR}" "${SHARDS_DIR}" "$(dirname "${MERGED_ZARR}")" \
         "$(dirname "${NEXT_WORK_ITEM}")" "$(dirname "${LOCK_FILE}")" \
         "$(dirname "${PENDING_SHARDS_FILE}")" "$(dirname "${MISSING_FILE}")" \
         "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}" "${SYNTH_SCRATCH}" \
         "$(dirname "${INITIAL_FAILURE_COUNT_FILE}")" "$(dirname "${SUCCESS_COUNT_FILE}")" \
         "$(dirname "${EARLY_STOP_MARKER}")"

export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

if [[ -z "${GRID_ZARR}" || -z "${MERGED_ZARR}" || -z "${SHARD_TEMPLATE}" || -z "${SHARDS_DIR}" || -z "${SYNTH_CONFIG_PATH}" ]]; then
    echo "[regular-grid] ERROR: failed to resolve one or more required runtime paths." >&2
    exit 1
fi

is_valid_grid_zarr() {
    local zarr_path="$1"
    if [[ ! -d "${zarr_path}" ]]; then
        return 1
    fi
    "${PYTHON}" - <<PY >/dev/null 2>&1
import zarr
root = zarr.open_group(r"${zarr_path}", mode="r")
assert "teff" in root and "logg" in root and "feh" in root
assert root["teff"].shape[0] > 0
PY
}

is_valid_merged_zarr() {
    local zarr_path="$1"
    if [[ ! -d "${zarr_path}" ]]; then
        return 1
    fi
    "${PYTHON}" - <<PY >/dev/null 2>&1
import zarr

root = zarr.open_group(r"${zarr_path}", mode="r")
for key in ("wavelength", "flux", "continuum"):
    assert key in root, f"missing {key}"
assert root["flux"].shape[0] > 0
assert root["flux"].shape == root["continuum"].shape
status_counts = root.attrs.get("status_counts")
if isinstance(status_counts, dict):
    bad = {
        str(key): int(value)
        for key, value in status_counts.items()
        if str(key).strip().lower() not in {"success", "skipped"} and int(value) > 0
    }
    assert not bad, f"bad status_counts={bad}"
PY
}

grid_row_count() {
    "${PYTHON}" - <<PY
import zarr
root = zarr.open_group(r"${GRID_ZARR}", mode="r")
print(int(root["teff"].shape[0]))
PY
}

render_shard_path() {
    local shard="$1"
    printf '%s\n' "${SHARD_TEMPLATE//\{shard_index\}/${shard}}"
}

initial_failure_stop_enabled() {
    [[ "${INITIAL_FAILURE_ABORT_THRESHOLD}" =~ ^[0-9]+$ ]] && (( INITIAL_FAILURE_ABORT_THRESHOLD > 0 ))
}

initialize_initial_failure_tracking() {
    local completed_count="${1:-0}"
    if ! initial_failure_stop_enabled; then
        return
    fi
    printf '0\n' > "${INITIAL_FAILURE_COUNT_FILE}"
    printf '%s\n' "${completed_count}" > "${SUCCESS_COUNT_FILE}"
    rm -f "${EARLY_STOP_MARKER}"
}

record_shard_outcome() {
    local shard="$1"
    local outcome="$2"
    local log_file="$3"
    if ! initial_failure_stop_enabled; then
        return
    fi

    exec 8<>"${LOCK_FILE}"
    flock -x 8
    local success_count failure_count
    success_count="$(cat "${SUCCESS_COUNT_FILE}" 2>/dev/null || printf '0')"
    failure_count="$(cat "${INITIAL_FAILURE_COUNT_FILE}" 2>/dev/null || printf '0')"
    [[ "${success_count}" =~ ^[0-9]+$ ]] || success_count=0
    [[ "${failure_count}" =~ ^[0-9]+$ ]] || failure_count=0

    if [[ "${outcome}" == "success" ]]; then
        success_count=$((success_count + 1))
        printf '%s\n' "${success_count}" > "${SUCCESS_COUNT_FILE}"
    elif (( success_count == 0 )); then
        failure_count=$((failure_count + 1))
        printf '%s\n' "${failure_count}" > "${INITIAL_FAILURE_COUNT_FILE}"
        if (( failure_count >= INITIAL_FAILURE_ABORT_THRESHOLD )) && [[ ! -f "${EARLY_STOP_MARKER}" ]]; then
            {
                printf 'reason=initial_failure_threshold_reached\n'
                printf 'threshold=%s\n' "${INITIAL_FAILURE_ABORT_THRESHOLD}"
                printf 'failure_count=%s\n' "${failure_count}"
                printf 'success_count=%s\n' "${success_count}"
                printf 'last_shard=%s\n' "${shard}"
                printf 'last_log=%s\n' "${log_file}"
                printf 'timestamp=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"
            } > "${EARLY_STOP_MARKER}"
            printf '[regular-grid] EARLY STOP: first %s shard calculation(s) failed before any success; threshold=%s; last_shard=%s; log=%s\n' \
                "${failure_count}" "${INITIAL_FAILURE_ABORT_THRESHOLD}" "${shard}" "${log_file}" >> "${LOG_DIR}/early_stop.log"
        fi
    fi
    flock -u 8
    exec 8>&-
}

should_stop_early() {
    initial_failure_stop_enabled && [[ -f "${EARLY_STOP_MARKER}" ]]
}

wait_for_array_prepare() {
    local waited=0
    while (( waited < ARRAY_PREP_TIMEOUT )); do
        if [[ -f "${ARRAY_PREP_MARKER}" ]] && is_valid_grid_zarr "${GRID_ZARR}"; then
            return 0
        fi
        if [[ -f "${ARRAY_PREP_FAILURE_MARKER}" ]]; then
            echo "[regular-grid] ERROR: one-time array preparation failed; details from ${ARRAY_PREP_FAILURE_MARKER}:" >&2
            sed -n '1,80p' "${ARRAY_PREP_FAILURE_MARKER}" >&2 || true
            return 1
        fi
        sleep 15
        waited=$((waited + 15))
    done

    if [[ -d "${ARRAY_PREP_LOCK_DIR}" ]]; then
        echo "[regular-grid] ERROR: timed out after ${ARRAY_PREP_TIMEOUT}s waiting for one-time array preparation to finish (lock still present: ${ARRAY_PREP_LOCK_DIR})." >&2
    else
        echo "[regular-grid] ERROR: timed out after ${ARRAY_PREP_TIMEOUT}s waiting for array preparation marker ${ARRAY_PREP_MARKER}." >&2
    fi
    return 1
}

prepare_array_if_needed() {
    local owner_id prep_rc=0
    owner_id="${PBS_JOBID:-manual}"
    if [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
        owner_id="${owner_id} task=${PBS_ARRAY_INDEX}"
    fi

    while true; do
        if [[ -f "${ARRAY_PREP_MARKER}" ]] && is_valid_grid_zarr "${GRID_ZARR}"; then
            return 0
        fi
        if [[ -f "${ARRAY_PREP_FAILURE_MARKER}" ]]; then
            echo "[regular-grid] ERROR: one-time array preparation previously failed; details from ${ARRAY_PREP_FAILURE_MARKER}:" >&2
            sed -n '1,80p' "${ARRAY_PREP_FAILURE_MARKER}" >&2 || true
            return 1
        fi

        if mkdir "${ARRAY_PREP_LOCK_DIR}" 2>/dev/null; then
            rm -f "${ARRAY_PREP_FAILURE_MARKER}"

            if [[ -f "${ARRAY_PREP_MARKER}" ]] && is_valid_grid_zarr "${GRID_ZARR}"; then
                rmdir "${ARRAY_PREP_LOCK_DIR}" 2>/dev/null || true
                return 0
            fi

            echo "[regular-grid] Array task ${PBS_ARRAY_INDEX:-<none>} acquired one-time grid-preparation lock."

            if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" && -d "${GRID_ZARR}" ]]; then
                echo "[regular-grid] Force restart requested; removing existing grid: ${GRID_ZARR}"
                rm -rf "${GRID_ZARR}" || prep_rc=$?
            fi
            if (( prep_rc == 0 )) && [[ "${FORCE_RESTART_EFFECTIVE}" == "1" ]]; then
                clear_restart_outputs || prep_rc=$?
            fi
            if (( prep_rc == 0 )); then
                generate_grid_if_needed || prep_rc=$?
            fi

            if (( prep_rc == 0 )); then
                {
                    printf 'ready\n'
                    printf 'prepared_by=%s\n' "${owner_id}"
                    printf 'prepared_at=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"
                } > "${ARRAY_PREP_MARKER}"
                rm -f "${ARRAY_PREP_FAILURE_MARKER}"
                rmdir "${ARRAY_PREP_LOCK_DIR}" 2>/dev/null || true
                return 0
            fi

            {
                printf 'prepare_failed_by=%s\n' "${owner_id}"
                printf 'prepare_failed_at=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')"
                printf 'prepare_failed_rc=%s\n' "${prep_rc}"
                printf 'run_root=%s\n' "${RUN_ROOT}"
                printf 'grid_zarr=%s\n' "${GRID_ZARR}"
            } > "${ARRAY_PREP_FAILURE_MARKER}"
            rmdir "${ARRAY_PREP_LOCK_DIR}" 2>/dev/null || true
            echo "[regular-grid] ERROR: one-time array preparation failed in ${owner_id}; see ${ARRAY_PREP_FAILURE_MARKER}." >&2
            return "${prep_rc}"
        fi

        echo "[regular-grid] Array task ${PBS_ARRAY_INDEX:-<none>} waiting for one-time grid/shard preparation..."
        wait_for_array_prepare || return $?
    done
}

write_missing_shards_file() {
    "${PYTHON}" - <<PY
import os
import re
from pathlib import Path

import numpy as np
import zarr

shard_dir = Path(r"${SHARDS_DIR}")
expected_shards = int(r"${SHARD_COUNT}")
row_count = int(r"${ROW_COUNT}")
out_path = Path(r"${MISSING_FILE}")
out_path.parent.mkdir(parents=True, exist_ok=True)

pattern = re.compile(r"^spectra_shard_(\d+)\.zarr$")
seen: set[int] = set()

for shard_path in sorted(shard_dir.glob("spectra_shard_*.zarr")):
    match = pattern.match(shard_path.name)
    if match is None:
        continue
    shard_idx = int(match.group(1))
    if shard_idx < 0 or shard_idx >= expected_shards:
        continue
    try:
        root = zarr.open_group(str(shard_path), mode="r")
        for key in ("wavelength", "global_index", "flux", "status", "message"):
            if key not in root:
                raise KeyError(key)
        expected_indices = np.arange(shard_idx, row_count, expected_shards, dtype=np.int64)
        gidx = np.asarray(root["global_index"][:], dtype=np.int64)
        if gidx.shape != expected_indices.shape or not np.array_equal(gidx, expected_indices):
            continue
        statuses = [str(x).strip().lower() for x in np.asarray(root["status"][:]).tolist()]
        if len(statuses) != expected_indices.size or any(status not in {"success", "skipped"} for status in statuses):
            continue
        flux = np.asarray(root["flux"][:], dtype=np.float32)
        if flux.shape[0] != expected_indices.size:
            continue
        if flux.size and not np.all(np.isfinite(flux)):
            continue
        if "continuum" in root:
            continuum = np.asarray(root["continuum"][:], dtype=np.float32)
            if continuum.shape != flux.shape:
                continue
            if continuum.size and not np.all(np.isfinite(continuum)):
                continue
        seen.add(shard_idx)
    except Exception:
        continue

missing = sorted(set(range(expected_shards)) - seen)
text = "\n".join(str(x) for x in missing)
out_path.write_text(f"{text}\n" if text else "", encoding="utf-8")
print(
    f"[regular-grid missing] expected_shards={expected_shards} seen={len(seen)} missing={len(missing)} stores={len(list(shard_dir.glob('spectra_shard_*.zarr')))}"
)
PY
}

prune_incompatible_shards() {
    "${PYTHON}" - <<PY
import re
import shutil
from pathlib import Path

import numpy as np
import zarr

shard_dir = Path(r"${SHARDS_DIR}")
expected_shards = int(r"${SHARD_COUNT}")
row_count = int(r"${ROW_COUNT}")
pattern = re.compile(r"^spectra_shard_(\d+)\.zarr$")
removed: list[str] = []

for shard_path in sorted(shard_dir.glob("spectra_shard_*.zarr")):
    match = pattern.match(shard_path.name)
    if match is None:
        continue
    shard_idx = int(match.group(1))
    remove_reason = None
    if shard_idx < 0 or shard_idx >= expected_shards:
        remove_reason = "outside_expected_range"
    else:
        try:
            root = zarr.open_group(str(shard_path), mode="r")
            expected_indices = np.arange(shard_idx, row_count, expected_shards, dtype=np.int64)
            gidx = np.asarray(root["global_index"][:], dtype=np.int64)
            if gidx.shape != expected_indices.shape or not np.array_equal(gidx, expected_indices):
                remove_reason = "layout_mismatch"
        except Exception:
            remove_reason = "unreadable_or_missing_global_index"
    if remove_reason is not None:
        shutil.rmtree(shard_path, ignore_errors=True)
        removed.append(f"{shard_path.name}:{remove_reason}")

preview = removed[:10]
suffix = " (truncated)" if len(removed) > 10 else ""
print(f"[regular-grid prune] removed={len(removed)} preview={preview}{suffix}")
PY
}

############################################
# Grid generation / shard layout
############################################

generate_grid_if_needed() {
    if [[ ! -d "${GRID_ZARR}" ]]; then
        echo "[regular-grid] Grid not found; generating regular grid."
        GRID_CMD=(
            "${PYTHON}" "${REPO}/scripts/synthesize_regular_grid.py"
            --config-json "${CONFIG_PATH}"
            --skip-synthesis
        )
        if [[ -n "${WORKERS_OVERRIDE}" ]]; then
            GRID_CMD+=(--workers "${WORKERS_OVERRIDE}")
        fi
        "${GRID_CMD[@]}"
    else
        echo "[regular-grid] Using existing grid: ${GRID_ZARR}"
    fi
}

clear_restart_outputs() {
    echo "[regular-grid] Force restart requested; clearing previous shard outputs."
    find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' -exec rm -rf {} +
    rm -f "${PENDING_SHARDS_FILE}" "${MISSING_FILE}" "${NEXT_WORK_ITEM}" \
          "${ARRAY_PREP_MARKER}" "${ARRAY_PREP_FAILURE_MARKER}"
    rm -rf "${ARRAY_PREP_LOCK_DIR}"
    if [[ -d "${MERGED_ZARR}" ]]; then
        rm -rf "${MERGED_ZARR}"
    fi
}

if (( ARRAY_TASK_MODE == 1 )) && [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]]; then
    echo "[regular-grid] ERROR: FINALIZE_ONLY=1 should be submitted as a normal job, not as a PBS array task." >&2
    exit 1
fi

if (( ARRAY_TASK_MODE == 1 )); then
    if ! [[ "${PBS_ARRAY_INDEX}" =~ ^[0-9]+$ ]]; then
        echo "[regular-grid] ERROR: PBS_ARRAY_INDEX must be a non-negative integer, got '${PBS_ARRAY_INDEX:-}'." >&2
        exit 1
    fi
    prepare_array_if_needed
else
    if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" && -d "${GRID_ZARR}" ]]; then
        echo "[regular-grid] Force restart requested; removing existing grid: ${GRID_ZARR}"
        rm -rf "${GRID_ZARR}"
    fi
    generate_grid_if_needed
    if [[ "${FORCE_RESTART_EFFECTIVE}" == "1" ]]; then
        clear_restart_outputs
    fi
fi

if ! is_valid_grid_zarr "${GRID_ZARR}"; then
    echo "[regular-grid] ERROR: grid output is missing or invalid: ${GRID_ZARR}" >&2
    exit 1
fi

ROW_COUNT="$(grid_row_count)"
echo "[regular-grid] Grid rows: ${ROW_COUNT}"

if [[ ! -f "${LAYOUT_HELPER}" ]]; then
    echo "[regular-grid] ERROR: shard layout helper not found: ${LAYOUT_HELPER}" >&2
    exit 1
fi

SHARD_COUNT_RAW="${SHARD_COUNT_OVERRIDE:-${CFG_SHARD_COUNT:-}}"
LAYOUT_CMD=(
    "${PYTHON}" "${LAYOUT_HELPER}"
    --row-count "${ROW_COUNT}"
    --default-rows-per-shard 1
)
if [[ -n "${ROWS_PER_SHARD_RAW}" ]]; then
    LAYOUT_CMD+=(--rows-per-shard "${ROWS_PER_SHARD_RAW}")
fi
if [[ -n "${SHARD_COUNT_RAW}" ]]; then
    LAYOUT_CMD+=(--shard-count "${SHARD_COUNT_RAW}")
fi

LAYOUT_OUTPUT="$("${LAYOUT_CMD[@]}")"
while IFS='=' read -r key value; do
    case "${key}" in
        ROW_COUNT) ROW_COUNT="${value}" ;;
        ROWS_PER_SHARD) ROWS_PER_SHARD="${value}" ;;
        SHARD_COUNT) SHARD_COUNT="${value}" ;;
        ARRAY_RANGE) ARRAY_RANGE="${value}" ;;
    esac
done <<< "${LAYOUT_OUTPUT}"

EST_ROWS_PER_SHARD="${ROWS_PER_SHARD}"

SHARD_INDEX="${PBS_ARRAY_INDEX:-}"
if (( ARRAY_TASK_MODE == 1 )) && (( SHARD_INDEX >= SHARD_COUNT )); then
    echo "[regular-grid] INFO: array task ${SHARD_INDEX} is outside SHARD_COUNT=${SHARD_COUNT}; exiting cleanly."
    exit 0
fi

ARRAY_SHARD_ROWS=0
if (( ARRAY_TASK_MODE == 1 )) && (( SHARD_INDEX < ROW_COUNT )); then
    ARRAY_SHARD_ROWS=$(( (ROW_COUNT - SHARD_INDEX + SHARD_COUNT - 1) / SHARD_COUNT ))
fi

############################################
# Logging
############################################

echo "[regular-grid] Repo: ${REPO}"
echo "[regular-grid] Config: ${CONFIG_PATH}"
echo "[regular-grid] Run root: ${RUN_ROOT}"
echo "[regular-grid] Grid Zarr: ${GRID_ZARR}"
echo "[regular-grid] Shards: ${SHARDS_DIR}"
echo "[regular-grid] Merged: ${MERGED_ZARR}"
echo "[regular-grid] Log dir: ${LOG_DIR}"
echo "[regular-grid] Synthesis config: ${SYNTH_CONFIG_PATH}"
echo "[regular-grid] Scratch tmp root: ${SCRATCH_TMP_ROOT}"
echo "[regular-grid] Synthesis scratch root: ${SYNTH_SCRATCH}"
echo "[regular-grid] Workers: ${WORKERS}"
echo "[regular-grid] Validate workers: ${VALIDATE_WORKERS}"
echo "[regular-grid] Merge chunk rows: ${MERGE_CHUNK_ROWS}"
echo "[regular-grid] Shard count: ${SHARD_COUNT}"
echo "[regular-grid] Rows per shard: ${ROWS_PER_SHARD}"
echo "[regular-grid] Estimated rows per shard: ${EST_ROWS_PER_SHARD}"
echo "[regular-grid] Array range: ${ARRAY_RANGE}"
echo "[regular-grid] Array mode: ${ARRAY_TASK_MODE}"
echo "[regular-grid] Finalize only: ${FINALIZE_ONLY_EFFECTIVE}"
echo "[regular-grid] Array index: ${PBS_ARRAY_INDEX:-<none>}"
echo "[regular-grid] Skip synthesis: ${SKIP_SYNTHESIS_EFFECTIVE}"
echo "[regular-grid] Force restart: ${FORCE_RESTART_EFFECTIVE}"
echo "[regular-grid] Missing shard report: ${MISSING_FILE}"
echo "[regular-grid] Run policy: preserve valid shards and resume missing ones."

if [[ "${SKIP_SYNTHESIS_EFFECTIVE}" == "1" ]]; then
    echo "[regular-grid] Completed grid generation only."
    exit 0
fi

############################################
# Fresh run / resume setup
############################################

if (( ARRAY_TASK_MODE == 0 || FINALIZE_ONLY_EFFECTIVE == 1 )); then
    if [[ "$(to_bool01 "${AUTO_PRUNE_STALE_SHARDS}")" == "1" ]]; then
        prune_incompatible_shards
    fi
    write_missing_shards_file
    cp "${MISSING_FILE}" "${PENDING_SHARDS_FILE}"
    PENDING_COUNT="$(wc -l < "${PENDING_SHARDS_FILE}" | tr -d '[:space:]')"
    echo 0 > "${NEXT_WORK_ITEM}"

    COMPLETED_COUNT=$((SHARD_COUNT - PENDING_COUNT))
    initialize_initial_failure_tracking "${COMPLETED_COUNT}"
    echo "[regular-grid] Existing valid shards: ${COMPLETED_COUNT}/${SHARD_COUNT}"

    if (( PENDING_COUNT == 0 )) && is_valid_merged_zarr "${MERGED_ZARR}"; then
        echo "[regular-grid] All shards are already present and merged output is valid; skipping work."
        exit 0
    fi
else
    PENDING_COUNT=0
    existing_shard_count="$(find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' | wc -l | tr -d '[:space:]')"
    if ! [[ "${existing_shard_count}" =~ ^[0-9]+$ ]]; then
        existing_shard_count=0
    fi
    initialize_initial_failure_tracking "${existing_shard_count}"
    echo "[regular-grid] Array task ${SHARD_INDEX}/${SHARD_COUNT} assigned approximately ${ARRAY_SHARD_ROWS} grid rows."
fi

############################################
# Walltime guard
############################################

walltime_to_seconds () {
    local raw="$1"
    if [[ -z "${raw}" ]]; then
        echo ""
        return 0
    fi
    if [[ "${raw}" =~ ^[0-9]+$ ]]; then
        echo "${raw}"
        return 0
    fi
    if [[ "${raw}" =~ ^([0-9]+):([0-9]{2}):([0-9]{2})$ ]]; then
        local hh mm ss
        hh="${BASH_REMATCH[1]}"
        mm="${BASH_REMATCH[2]}"
        ss="${BASH_REMATCH[3]}"
        echo $((10#${hh} * 3600 + 10#${mm} * 60 + 10#${ss}))
        return 0
    fi
    echo ""
}

WALLTIME_RAW="${WALLTIME_SECONDS:-${PBS_WALLTIME:-${PBS_RESOURCE_LIST_WALLTIME:-}}}"
WALLTIME_SECONDS="$(walltime_to_seconds "${WALLTIME_RAW}")"
if ! [[ "${WALLTIME_SECONDS}" =~ ^[0-9]+$ ]] || (( WALLTIME_SECONDS < 1 )); then
    WALLTIME_SECONDS=$((12*3600))
    echo "[regular-grid] WARN: could not parse walltime from '${WALLTIME_RAW:-<unset>}' — defaulting to ${WALLTIME_SECONDS}s." >&2
fi
START_TIME=$(date +%s)

SAFETY_BUFFER="${SAFETY_BUFFER:-900}"
EST_RUNTIME="${EST_RUNTIME:-600}"
SHARD_RETRY_ATTEMPTS="${SHARD_RETRY_ATTEMPTS:-3}"
SINGLE_JOB_SHARD_WORKERS_OVERRIDE="${SINGLE_JOB_SHARD_WORKERS:-}"
if [[ -n "${SINGLE_JOB_SHARD_WORKERS_OVERRIDE}" ]] && { ! [[ "${SINGLE_JOB_SHARD_WORKERS_OVERRIDE}" =~ ^[0-9]+$ ]] || (( SINGLE_JOB_SHARD_WORKERS_OVERRIDE < 1 )); }; then
    echo "[regular-grid] WARN: invalid SINGLE_JOB_SHARD_WORKERS='${SINGLE_JOB_SHARD_WORKERS_OVERRIDE}', ignoring override." >&2
    SINGLE_JOB_SHARD_WORKERS_OVERRIDE=""
fi
ARRAY_SHARD_WORKERS="${ARRAY_SHARD_WORKERS:-${WORKERS}}"
if ! [[ "${ARRAY_SHARD_WORKERS}" =~ ^[0-9]+$ ]] || (( ARRAY_SHARD_WORKERS < 1 )); then
    echo "[regular-grid] WARN: invalid ARRAY_SHARD_WORKERS='${ARRAY_SHARD_WORKERS}', defaulting to WORKERS=${WORKERS}." >&2
    ARRAY_SHARD_WORKERS="${WORKERS}"
fi
SINGLE_JOB_SHARD_WORKERS_EFFECTIVE=1

time_left () {
    echo $((WALLTIME_SECONDS - ($(date +%s) - START_TIME)))
}

run_shard_attempts () {
    local shard="$1"
    local max_attempts="$2"
    local scratch_root="$3"
    local log_file="$4"
    local sleep_base="$5"
    local worker_count="$6"

    local shard_out tmp_out
    shard_out="$(render_shard_path "${shard}")"
    tmp_out="${TMP_OUTPUT_DIR}/spectra_shard_${shard}.a$$.tmp.zarr"

    for ((attempt=1; attempt<=max_attempts; attempt++)); do
        local start end attempt_scratch
        start=$(date +%s)
        attempt_scratch="${scratch_root}/shard_${shard}_a${attempt}"
        mkdir -p "${attempt_scratch}"
        {
            printf '[regular-grid] shard=%s attempt=%s/%s workers=%s scratch=%s started_at=%s\n' \
                "${shard}" "${attempt}" "${max_attempts}" "${worker_count}" "${attempt_scratch}" "$(date '+%Y-%m-%dT%H:%M:%S%z')"
        } >> "${log_file}"

        if "${PYTHON}" "${REPO}/scripts/run_turbospectrum_shard.py" \
            --grid-zarr "${GRID_ZARR}" \
            --config "${SYNTH_CONFIG_PATH}" \
            --output-zarr "${shard_out}" \
            --output-tmp "${tmp_out}" \
            --shard-index "${shard}" \
            --shard-count "${SHARD_COUNT}" \
            --workers "${worker_count}" \
            --scratch "${attempt_scratch}" \
            --log-level "${SYNTH_LOG_LEVEL}" \
            >> "${log_file}" 2>&1; then
            end=$(date +%s)
            {
                printf '[regular-grid] shard=%s attempt=%s/%s completed_at=%s runtime_seconds=%s workers=%s\n' \
                    "${shard}" "${attempt}" "${max_attempts}" "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$((end-start))" "${worker_count}"
            } >> "${log_file}"
            return 0
        fi

        rc=$?
        {
            printf '[regular-grid] shard=%s attempt=%s/%s failed_rc=%s failed_at=%s workers=%s\n' \
                "${shard}" "${attempt}" "${max_attempts}" "${rc}" "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${worker_count}"
        } >> "${log_file}"
        rm -rf "${tmp_out}"
        sleep $(( (RANDOM % 10) + attempt * sleep_base ))
    done

    return 1
}

############################################
# Worker
############################################

worker() {
    local jobfs_dir task_index shard available_kb
    jobfs_dir="${TMP_WORK_DIR}/worker_${RANDOM}"
    mkdir -p "${jobfs_dir}"
    trap 'rc=$?; if (( rc != 0 )); then echo "[regular-grid] WARN: outer worker aborted unexpectedly with rc=${rc} task_index=${task_index:-<unset>} shard=${shard:-<unset>} jobfs=${jobfs_dir:-<unset>}." >&2; fi' EXIT

    while true; do
        if should_stop_early; then
            echo "[regular-grid] Early-stop marker detected; worker is exiting without starting new shards."
            break
        fi
        if (( $(time_left) < EST_RUNTIME + SAFETY_BUFFER )); then
            echo "Worker exiting safely before walltime."
            break
        fi

        available_kb="$(df -Pk "${jobfs_dir}" 2>/dev/null | awk 'NR==2 {print $4}')"
        if ! [[ "${available_kb}" =~ ^[0-9]+$ ]]; then
            echo "[regular-grid] WARN: could not determine scratch availability for ${jobfs_dir}; retrying in 15s."
            sleep 15
            continue
        fi

        if (( available_kb < 5*1024*1024 )); then
            echo "Low scratch — sleeping."
            sleep 60
            continue
        fi

        exec 9<>"${LOCK_FILE}"
        flock -x 9
        task_index="$(cat "${NEXT_WORK_ITEM}" 2>/dev/null || printf '')"
        if ! [[ "${task_index}" =~ ^[0-9]+$ ]]; then
            flock -u 9
            exec 9>&-
            echo "[regular-grid] WARN: next-work counter ${NEXT_WORK_ITEM} is missing or invalid; stopping this worker."
            break
        fi
        echo $((task_index + 1)) > "${NEXT_WORK_ITEM}"
        flock -u 9
        exec 9>&-

        if (( task_index >= PENDING_COUNT )); then
            break
        fi

        shard="$(sed -n "$((task_index + 1))p" "${PENDING_SHARDS_FILE}")"
        if [[ -z "${shard}" ]]; then
            break
        fi

        if ! run_shard_attempts "${shard}" "${SHARD_RETRY_ATTEMPTS}" "${jobfs_dir}" "${LOG_DIR}/shard_${shard}.log" 15 "${SINGLE_JOB_SHARD_WORKERS_EFFECTIVE}"; then
            echo "Shard ${shard} failed after ${SHARD_RETRY_ATTEMPTS} attempts in main loop." >> "${LOG_DIR}/shard_${shard}.log"
            record_shard_outcome "${shard}" "failure" "${LOG_DIR}/shard_${shard}.log"
            if should_stop_early; then
                echo "[regular-grid] Early-stop threshold reached after shard ${shard} failure; worker is exiting."
                break
            fi
        else
            record_shard_outcome "${shard}" "success" "${LOG_DIR}/shard_${shard}.log"
        fi
    done

    trap - EXIT
}

export NEXT_WORK_ITEM LOCK_FILE PENDING_COUNT PENDING_SHARDS_FILE LOG_DIR REPO PYTHON \
       GRID_ZARR SYNTH_CONFIG_PATH TMP_OUTPUT_DIR ROW_COUNT SHARD_COUNT SYNTH_LOG_LEVEL SHARD_TEMPLATE \
       SINGLE_JOB_SHARD_WORKERS_EFFECTIVE INITIAL_FAILURE_ABORT_THRESHOLD \
       INITIAL_FAILURE_COUNT_FILE SUCCESS_COUNT_FILE EARLY_STOP_MARKER

############################################
# Launch workers / array shard
############################################

MIN_REQUIRED_SECONDS=$((EST_RUNTIME + SAFETY_BUFFER))
REMAINING_AT_LAUNCH="$(time_left)"

if (( ARRAY_TASK_MODE == 1 )); then
    if (( REMAINING_AT_LAUNCH < MIN_REQUIRED_SECONDS )); then
        echo "[regular-grid] WARN: only ${REMAINING_AT_LAUNCH}s remain before walltime, but the worker guard requires at least ${MIN_REQUIRED_SECONDS}s (EST_RUNTIME=${EST_RUNTIME}s + SAFETY_BUFFER=${SAFETY_BUFFER}s). No shard attempt will be started in this array task."
        echo "[regular-grid] WARN: rerun with more walltime or lower SAFETY_BUFFER/EST_RUNTIME if that is safe for your workload."
        exit 0
    fi

    ARRAY_LOG_FILE="${LOG_DIR}/shard_${SHARD_INDEX}.log"
    if should_stop_early; then
        echo "[regular-grid] Early-stop marker detected before array shard launch; see ${EARLY_STOP_MARKER}." >&2
        cat "${EARLY_STOP_MARKER}" >&2 || true
        exit 1
    fi
    echo "[regular-grid] Array task ${SHARD_INDEX}/${SHARD_COUNT} starting with ${ARRAY_SHARD_WORKERS} synthesis workers across ~${ARRAY_SHARD_ROWS} grid rows."
    if ! run_shard_attempts "${SHARD_INDEX}" "${SHARD_RETRY_ATTEMPTS}" "${TMP_WORK_DIR}/array_${SHARD_INDEX}" "${ARRAY_LOG_FILE}" 15 "${ARRAY_SHARD_WORKERS}"; then
        echo "Shard ${SHARD_INDEX} failed after ${SHARD_RETRY_ATTEMPTS} attempts in array mode." >> "${ARRAY_LOG_FILE}"
        record_shard_outcome "${SHARD_INDEX}" "failure" "${ARRAY_LOG_FILE}"
        print_log_excerpt "${ARRAY_LOG_FILE}" "Array shard log excerpt"
        if should_stop_early; then
            echo "[regular-grid] ERROR: early-stop threshold reached; see ${EARLY_STOP_MARKER}." >&2
            cat "${EARLY_STOP_MARKER}" >&2 || true
        fi
        exit 1
    fi
    record_shard_outcome "${SHARD_INDEX}" "success" "${ARRAY_LOG_FILE}"
    echo "[regular-grid] Array task ${SHARD_INDEX} completed: $(render_shard_path "${SHARD_INDEX}")"
    exit 0
fi

if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]]; then
    echo "[regular-grid] FINALIZE_ONLY=1: skipping shard synthesis and moving directly to validation/merge."
elif (( PENDING_COUNT > 0 )); then
    if (( REMAINING_AT_LAUNCH < MIN_REQUIRED_SECONDS )); then
        echo "[regular-grid] WARN: only ${REMAINING_AT_LAUNCH}s remain before walltime, but the worker guard requires at least ${MIN_REQUIRED_SECONDS}s (EST_RUNTIME=${EST_RUNTIME}s + SAFETY_BUFFER=${SAFETY_BUFFER}s). No shard attempts will be started in this job."
        echo "[regular-grid] WARN: rerun with more walltime or lower SAFETY_BUFFER/EST_RUNTIME if that is safe for your workload."
    else
        ACTIVE_OUTER_WORKERS="${WORKERS}"
        if (( PENDING_COUNT < ACTIVE_OUTER_WORKERS )); then
            ACTIVE_OUTER_WORKERS="${PENDING_COUNT}"
        fi
        SINGLE_JOB_SHARD_WORKERS_EFFECTIVE="${SINGLE_JOB_SHARD_WORKERS_OVERRIDE}"
        if [[ -z "${SINGLE_JOB_SHARD_WORKERS_EFFECTIVE}" ]]; then
            if (( ACTIVE_OUTER_WORKERS > 0 )); then
                SINGLE_JOB_SHARD_WORKERS_EFFECTIVE=$(( WORKERS / ACTIVE_OUTER_WORKERS ))
            else
                SINGLE_JOB_SHARD_WORKERS_EFFECTIVE=1
            fi
            if (( SINGLE_JOB_SHARD_WORKERS_EFFECTIVE < 1 )); then
                SINGLE_JOB_SHARD_WORKERS_EFFECTIVE=1
            fi
        fi
        export SINGLE_JOB_SHARD_WORKERS_EFFECTIVE
        echo "[regular-grid] Launching ${ACTIVE_OUTER_WORKERS} outer workers for ${PENDING_COUNT} pending shards (${SINGLE_JOB_SHARD_WORKERS_EFFECTIVE} synthesis worker(s) per shard subprocess)..."
        WORKER_PIDS=()
        for ((i=0; i<ACTIVE_OUTER_WORKERS; i++)); do
            worker &
            WORKER_PIDS+=("$!")
        done
        WORKER_FAILURES=0
        for worker_pid in "${WORKER_PIDS[@]}"; do
            if wait "${worker_pid}"; then
                :
            else
                worker_rc=$?
                WORKER_FAILURES=$((WORKER_FAILURES + 1))
                echo "[regular-grid] WARN: outer worker pid=${worker_pid} exited unexpectedly with rc=${worker_rc}."
            fi
        done
        if (( WORKER_FAILURES > 0 )); then
            echo "[regular-grid] WARN: ${WORKER_FAILURES}/${#WORKER_PIDS[@]} outer workers exited unexpectedly; continuing to validation/merge with completed shards."
        fi
    fi
else
    echo "[regular-grid] No pending shards detected; moving directly to validation/merge."
fi

if should_stop_early; then
    echo "[regular-grid] ERROR: early-stop threshold reached; aborting before validation/merge. See ${EARLY_STOP_MARKER}." >&2
    cat "${EARLY_STOP_MARKER}" >&2 || true
    exit 1
fi

CURRENT="$(cat "${NEXT_WORK_ITEM}")"
if (( FINALIZE_ONLY_EFFECTIVE == 0 && PENDING_COUNT > 0 && CURRENT == 0 )); then
    echo "[regular-grid] NOTICE: no shards were assigned in this job. If no per-shard logs were written, the walltime guard likely prevented the first shard attempt."
fi

write_missing_shards_file
FINAL_MISSING="$(wc -l < "${MISSING_FILE}" | tr -d '[:space:]')"

echo "[regular-grid] Failed shard report written: ${MISSING_FILE} (count=${FINAL_MISSING})"
if (( FINAL_MISSING > 0 )); then
    echo "First 20 failed shard IDs:"
    head -n 20 "${MISSING_FILE}"
fi

echo "[regular-grid] Validating shard outputs..."
VALIDATE_CMD=(
    "${PYTHON}" "${REPO}/scripts/validate_dataset.py"
    --shard-dir "${SHARDS_DIR}"
    --expected-shards "${SHARD_COUNT}"
    --workers "${VALIDATE_WORKERS}"
)
if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    VALIDATE_CMD+=(--allow-incomplete-provenance)
fi
set +e
"${VALIDATE_CMD[@]}"
VALIDATE_RC=$?
set -e
if (( VALIDATE_RC != 0 )); then
    echo "[regular-grid] WARN: validation exited with code ${VALIDATE_RC}; continuing with merge policy."
fi

SHARD_STORE_COUNT=$(find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' | wc -l | tr -d '[:space:]')
if (( SHARD_STORE_COUNT == 0 )); then
    echo "[regular-grid] ERROR: no shard stores were produced in ${SHARDS_DIR}; skipping merge." >&2
    echo "[regular-grid] ERROR: inspect ${LOG_DIR}/shard_*.log for worker failures." >&2
    FIRST_SHARD_LOG=""
    if compgen -G "${LOG_DIR}/shard_*.log" > /dev/null; then
        FIRST_SHARD_LOG="$(printf '%s\n' "${LOG_DIR}"/shard_*.log | sort | head -n 1)"
    fi
    if [[ -z "${FIRST_SHARD_LOG}" ]]; then
        echo "[regular-grid] ERROR: no per-shard logs were written under ${LOG_DIR}. This usually means the job never reached a shard attempt, often because the walltime guard stopped workers before launch." >&2
    fi
    if [[ -n "${FIRST_SHARD_LOG}" && -f "${FIRST_SHARD_LOG}" ]]; then
        echo "[regular-grid] ERROR: first shard log excerpt (${FIRST_SHARD_LOG}):" >&2
        if grep -Fq 'Fix the missing binaries/data paths before rerunning:' "${FIRST_SHARD_LOG}"; then
            grep -Fin -A8 'Fix the missing binaries/data paths before rerunning:' "${FIRST_SHARD_LOG}" | tail -n 40 >&2 || true
        elif grep -Einq 'error|failed|exception|missing spectrum|traceback|forrtl|stop|log=' "${FIRST_SHARD_LOG}"; then
            grep -Ein 'error|failed|exception|missing spectrum|traceback|forrtl|stop|log=' "${FIRST_SHARD_LOG}" | tail -n 80 >&2 || true
        else
            tail -n 120 "${FIRST_SHARD_LOG}" >&2 || true
        fi
    fi
    exit 1
fi

MERGE_CMD=(
    "${PYTHON}" "${REPO}/scripts/merge_spectra_shards.py"
    --shard-dir "${SHARDS_DIR}"
    --grid-zarr "${GRID_ZARR}"
    --output-zarr "${MERGED_ZARR}"
    --chunk-rows "${MERGE_CHUNK_ROWS}"
    --tmp-dir "${TMP_SYSTEM_DIR}"
)

if [[ "$(to_bool01 "${SKIP_BAD_SHARDS}")" == "1" ]]; then
    MERGE_CMD+=(--skip-invalid-shards)
fi

if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    MERGE_CMD+=(--allow-incomplete-provenance)
fi

if (( FINAL_MISSING > 0 )); then
    if [[ "$(to_bool01 "${ALLOW_PARTIAL_MERGE}")" == "1" ]]; then
        echo "[regular-grid] WARN: missing shards detected; enabling partial merge (--allow-missing --skip-nonexistent-shards)."
        MERGE_CMD+=(--allow-missing --skip-nonexistent-shards)
    else
        echo "[regular-grid] ERROR: ${FINAL_MISSING} shards are still missing; merge aborted." >&2
        exit 1
    fi
fi

echo "[regular-grid] Merging shard outputs..."
"${MERGE_CMD[@]}"
echo "[regular-grid] Merge complete: ${MERGED_ZARR}"
