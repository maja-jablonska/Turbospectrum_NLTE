#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N turbospec
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89

set -euo pipefail
cd $PBS_O_WORKDIR

############################################
# Thread caps (CRITICAL)
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

# Prevent mixed-prefix Python startup failures on HPC nodes.
unset PYTHONHOME || true
unset PYTHONPATH || true
PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[turbospec] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[turbospec] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[turbospec] Python: ${PYTHON}"
echo "[turbospec] Mamba env: ${MAMBA_ENV_NAME}"
echo "[turbospec] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Paths
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
RUN_ROOT="${RUN_ROOT:-/scratch/${PROJECT}/${USER_ID}/turbospec}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
WORKERS="${WORKERS:-16}"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO=$(cd "${REPO}" >/dev/null 2>&1 && pwd)

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[turbospec] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

# Build a job-local pipeline config with outputs under RUN_ROOT.
RUN_CONFIG_DIR="${RUN_ROOT}/config"
mkdir -p "${RUN_CONFIG_DIR}"
JOB_CONFIG_PATH="${RUN_CONFIG_DIR}/config_pipeline.${PBS_JOBID}.json"

"${PYTHON}" - <<PY
import json
import os

src = os.path.abspath(r"${CONFIG_PATH}")
dst = os.path.abspath(r"${JOB_CONFIG_PATH}")
run_root = os.path.abspath(r"${RUN_ROOT}")

with open(src, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)

outs = cfg.setdefault("outputs", {})
outs["grid_csv"] = os.path.join(run_root, "outputs", "grids", "parameter_grid.csv")
outs["grid_zarr"] = os.path.join(run_root, "outputs", "grids", "parameter_grid.zarr")
outs["spectra_zarr"] = os.path.join(run_root, "outputs", "zarr", "synthesized_spectra.zarr")
outs["spectra_shard_template"] = os.path.join(run_root, "outputs", "shards", "spectra_shard_{shard_index}.zarr")

runtime = cfg.setdefault("runtime", {})
runtime.setdefault("scratch", os.path.join(run_root, "tmp"))

with open(dst, "w", encoding="utf-8") as handle:
    json.dump(cfg, handle, indent=2, sort_keys=True)
PY

CONFIG_PATH="${JOB_CONFIG_PATH}"

CONFIG_OUTPUTS=$(
    "${PYTHON}" - <<PY
import json
import os

cfg_path = os.path.abspath(r"${CONFIG_PATH}")
cfg_dir = os.path.dirname(cfg_path)
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
outs = cfg.get("outputs", {}) or {}

def _abs(p):
    if not p:
        return ""
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cfg_dir, p))

grid = _abs(outs.get("grid_zarr"))
shard_tmpl = _abs(outs.get("spectra_shard_template"))
merged = _abs(outs.get("spectra_zarr"))
shards_dir = os.path.dirname(shard_tmpl) if shard_tmpl else ""

print(grid)
print(shards_dir)
print(merged)
PY
)
mapfile -t _cfg_lines <<< "${CONFIG_OUTPUTS}"
CFG_GRID_ZARR="${_cfg_lines[0]:-}"
CFG_SHARDS_DIR="${_cfg_lines[1]:-}"
CFG_MERGED_ZARR="${_cfg_lines[2]:-}"

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR:-${RUN_ROOT}/grid/parameter_grid.zarr}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR:-${RUN_ROOT}/shards}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR:-${RUN_ROOT}/synthesized_spectra.zarr}}"

if [[ "${GRID_ZARR}" != /* ]]; then
    GRID_ZARR="${REPO}/${GRID_ZARR}"
fi
if [[ "${SHARDS_DIR}" != /* ]]; then
    SHARDS_DIR="${REPO}/${SHARDS_DIR}"
fi
if [[ "${MERGED_ZARR}" != /* ]]; then
    MERGED_ZARR="${REPO}/${MERGED_ZARR}"
fi

NEXT_SHARD="${NEXT_SHARD:-${RUN_ROOT}/next_shard.txt}"
LOCK_FILE="${LOCK_FILE:-${RUN_ROOT}/counter.lock}"
LOG_DIR="${LOG_DIR:-${RUN_ROOT}/logs}"
mkdir -p "${LOG_DIR}" "${SHARDS_DIR}" "$(dirname "${NEXT_SHARD}")" "$(dirname "${LOCK_FILE}")"

echo "[turbospec] Repo: ${REPO}"
echo "[turbospec] Config: ${CONFIG_PATH}"
echo "[turbospec] Grid: ${GRID_ZARR}"
echo "[turbospec] Shards: ${SHARDS_DIR}"
echo "[turbospec] Merged: ${MERGED_ZARR}"
echo "[turbospec] Job config: ${CONFIG_PATH}"

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec] Grid Zarr missing; generating grid from config..."
    "${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
        --config "${CONFIG_PATH}" \
        --skip-synthesis
fi

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec] ERROR: grid zarr still not found after generation: ${GRID_ZARR}" >&2
    exit 1
fi

############################################
# Node-local scratch
############################################

JOBFS_BASE=${PBS_JOBFS:-${TMPDIR:-/tmp/${USER_ID}/pbs_${PBS_JOBID}}}

############################################
# Grid sanity check
############################################

ROW_COUNT=$(${PYTHON} - <<PY
import zarr
root = zarr.open_group(r"${GRID_ZARR}", mode="r")
print(int(root["teff"].shape[0]))
PY
)

echo "Grid rows: ${ROW_COUNT}"

############################################
# Initialize atomic counter (ONLY once)
############################################

if [[ ! -f "${NEXT_SHARD}" ]]; then
    echo "Initializing shard counter"
    echo 0 > "${NEXT_SHARD}"
fi

############################################
# Walltime guard
############################################

WALLTIME_SECONDS=$((12*3600))
START_TIME=$(date +%s)

SAFETY_BUFFER="${SAFETY_BUFFER:-900}"  # stop 15 minutes early
EST_RUNTIME="${EST_RUNTIME:-600}"      # expected shard runtime (tune later)

time_left () {
    echo $((WALLTIME_SECONDS - ($(date +%s) - START_TIME)))
}

############################################
# Worker
############################################

worker() {

    JOBFS_DIR=${JOBFS_BASE}/worker_$RANDOM
    mkdir -p $JOBFS_DIR

    while true; do

        #################################
        # Walltime protection
        #################################

        if (( $(time_left) < EST_RUNTIME + SAFETY_BUFFER )); then
            echo "Worker exiting safely before walltime."
            break
        fi

        #################################
        # Scratch precheck
        #################################

        AVAILABLE=$(df -Pk "$JOBFS_DIR" | awk 'NR==2 {print $4}')

        # Require ~5GB free
        if (( AVAILABLE < 5*1024*1024 )); then
            echo "Low scratch — sleeping."
            sleep 60
            continue
        fi

        #################################
        # Atomic shard grab
        #################################

        exec 9<>${LOCK_FILE}
        flock -x 9

        shard=$(cat ${NEXT_SHARD})
        echo $((shard + 1)) > ${NEXT_SHARD}

        flock -u 9
        exec 9>&-

        if (( shard >= ROW_COUNT )); then
            break
        fi

        OUT=${SHARDS_DIR}/spectra_shard_${shard}.zarr
        TMP_OUT=${OUT}.tmp

        #################################
        # Skip valid shards
        #################################

        if ${PYTHON} - <<PY >/dev/null 2>&1
import zarr
root = zarr.open_group(r"${OUT}", mode="r")
assert "flux" in root and "wavelength" in root
PY
        then
            continue
        fi

        #################################
        # Retry with jitter
        #################################

        for attempt in {1..3}; do

            START=$(date +%s)

            ${PYTHON} ${REPO}/scripts/pipeline_from_config.py \
              --config "${CONFIG_PATH}" \
              --skip-grid \
              --synthesis-mode sharded \
              --shard-index "$shard" \
              --shard-count "${ROW_COUNT}" \
              --workers 1 \
              --scratch "$JOBFS_DIR" \
              --output "$TMP_OUT" \
              > "${LOG_DIR}/shard_${shard}.log" 2>&1 || true

            #################################
            # Validate (pipeline does atomic rename: TMP_OUT -> OUT)
            #################################

            if ${PYTHON} - <<PY >/dev/null 2>&1
import zarr
root = zarr.open_group(r"${OUT}", mode="r")
assert "flux" in root and "wavelength" in root and root["flux"].shape[0] > 0
PY
            then
                END=$(date +%s)
                echo "runtime_seconds=$((END-START))" >> "${LOG_DIR}/shard_${shard}.log"
                break
            fi

            rm -rf "$TMP_OUT" "$OUT"

            sleep $(( (RANDOM % 10) + attempt * 15 ))
        done
    done
}

export -f worker
export NEXT_SHARD LOCK_FILE ROW_COUNT LOG_DIR REPO PYTHON PBS_JOBID JOBFS_BASE CONFIG_PATH

############################################
# Launch workers (start conservative!)
############################################

echo "Launching ${WORKERS} workers..."

for ((i=0;i<WORKERS;i++)); do
    worker &
done

wait

############################################
# Auto-resubmit if shards remain
############################################

CURRENT=$(cat ${NEXT_SHARD})

if (( CURRENT < ROW_COUNT )); then
    echo "Shards remaining ($CURRENT / $ROW_COUNT). Resubmitting..."
    qsub -v "PYTHON_BIN=${PYTHON_BIN},MAMBA_ENV_NAME=${MAMBA_ENV_NAME},PROJECT=${PROJECT},USER_ID=${USER_ID},RUN_ROOT=${RUN_ROOT},REPO=${REPO},CONFIG_PATH=${CONFIG_PATH},GRID_ZARR=${GRID_ZARR},SHARDS_DIR=${SHARDS_DIR},MERGED_ZARR=${MERGED_ZARR},NEXT_SHARD=${NEXT_SHARD},LOCK_FILE=${LOCK_FILE},LOG_DIR=${LOG_DIR},WORKERS=${WORKERS},SAFETY_BUFFER=${SAFETY_BUFFER},EST_RUNTIME=${EST_RUNTIME}" "$0"

else
    echo "All shards completed."

    echo "Validating shard completeness before merge..."
    ${PYTHON} ${REPO}/scripts/validate_dataset.py \
        --shard-dir "${SHARDS_DIR}" \
        --expected-shards "${ROW_COUNT}" \
        | tee "${LOG_DIR}/validate.log"

    echo "Merging shards..."

    ${PYTHON} ${REPO}/scripts/merge_spectra_shards.py \
        --shard-dir "${SHARDS_DIR}" \
        --grid-zarr "${GRID_ZARR}" \
        --output-zarr "${MERGED_ZARR}" \
        > "${LOG_DIR}/merge.log" 2>&1
fi
