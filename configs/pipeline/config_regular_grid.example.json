{
  "_comment": "Regular Cartesian grid template for linear interpolation workflows.",
  "_note": [
    "Use with: python scripts/synthesize_regular_grid.py --config-json configs/pipeline/config_regular_grid.example.json",
    "For HPC, use turbospectrum_regular_grid_example.pbs which reads output/runtime paths from this config by default.",
    "Set runtime.rows_per_shard (or runtime.shard_count) to switch from one-row shards to chunked shards for array jobs and lower startup overhead."
  ],
  "grid": {
    "grid_version": "regular-linear-v1",
    "axes": {
      "teff": "4000:7000:250",
      "logg": "0.0:5.0:0.5",
      "feh": "-2.5:0.5:0.25",
      "turbvel": "01,02,03"
    },
    "abundances": {
      "a": "+0.00",
      "c": "+0.00",
      "n": "+0.00",
      "o": "+0.00",
      "r": "+0.00",
      "s": "+0.00"
    },
    "synthesis": {
      "lam_min": 8400.0,
      "lam_max": 8800.0,
      "lam_step": 0.01,
      "output_mode": "Intensity",
      "mode": "1D",
      "calculation_mode": "LTE",
      "_mu_range_note": "Uniform mu axis for regular-grid intensity runs (start:end:step or comma list).",
      "mu_range": "0.0:1.0:0.1"
    },
    "limits": {
      "max_rows": 2000000
    },
    "io": {
      "csv_compression": "zstd",
      "csv_compression_level": 5,
      "zarr_chunks": 2048,
      "zarr_compressor": {
        "cname": "zstd",
        "clevel": 5,
        "shuffle": true
      }
    }
  },
  "turbospectrum": {
    "_note": [
      "Base synthesis runtime config used by synthesize_spectra_from_zarr.py.",
      "overrides lets this regular-grid example carry its own linelist settings without duplicating the full synthesis schema."
    ],
    "config": "../synthesis/config_sample_comprehensive.json",
    "overrides": {
      "paths": {
        "linelist_path": "../../input_files/linelists",
        "linelist_files": [
          "nlte_ges_linelist_jmg6may2025_I_II"
        ]
      }
    }
  },
  "outputs": {
    "_note": "Paths resolved relative to this config unless absolute.",
    "run_root": "../../runs/regular-grid",
    "grid_csv": "../../runs/regular-grid/outputs/grids/regular_parameter_grid.csv",
    "grid_zarr": "../../runs/regular-grid/outputs/grids/regular_parameter_grid.zarr",
    "grid_index_parquet": "../../runs/regular-grid/outputs/grids/index.parquet",
    "spectra_zarr": "../../runs/regular-grid/outputs/zarr/regular_synthesized_spectra.zarr",
    "spectra_shard_template": "../../runs/regular-grid/outputs/shards/spectra_shard_{shard_index}.zarr"
  },
  "runtime": {
    "_note": "rows_per_shard is recommended for regular-grid HPC runs; PBS arrays can overshoot the final index because extra tasks exit cleanly.",
    "workers": 16,
    "shard_count": null,
    "rows_per_shard": 128,
    "scratch": null,
    "chunk_rows": 32,
    "output_tmp": null,
    "log_level": "INFO",
    "log_file": null,
    "skip_synthesis": false
  }
}
