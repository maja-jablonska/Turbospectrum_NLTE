# Shared Weights & Biases defaults for Gadi/HPC PBS jobs.
# Both `wandb_agent.pbs` and `wandb_sync.pbs` source this file automatically.
# Override any value at submit time with `qsub -v KEY=value,...`.

_WANDB_BASE_DIR="${PBS_O_WORKDIR:-$(pwd)}"

# Local run/output root for MLP sweep artifacts.
RUN_DIR="${RUN_DIR:-${_WANDB_BASE_DIR}/runs/mlp_wandb}"

# Store all local W&B files in one place so offline sync paths are obvious.
WANDB_LOCAL_DIR="${WANDB_LOCAL_DIR:-${RUN_DIR}/wandb}"
WANDB_SYNC_DIR="${WANDB_SYNC_DIR:-${WANDB_LOCAL_DIR}}"

# Set project/entity once here.
WANDB_PROJECT="${WANDB_PROJECT:-turbospectrum-mlp}"
WANDB_ENTITY="${WANDB_ENTITY:-}"
WANDB_GROUP="${WANDB_GROUP:-gadi}"
WANDB_TAGS="${WANDB_TAGS:-gadi,pbs}"

unset _WANDB_BASE_DIR
