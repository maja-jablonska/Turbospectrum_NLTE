#!/bin/bash
#PBS -P mk27
#PBS -q rsaa
#PBS -N turbospec-array
#PBS -r y
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l jobfs=100GB
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -M maja.jablonska@anu.edu.au
#PBS -m bae
#PBS -l storage=scratch/mk27+scratch/y89
#PBS -J 0-99

# Usage examples:
#   qsub -J 0-99 -v CONFIG_PATH=configs/pipeline/config_pipeline.json turbospectrum_example_array.pbs
#   qsub -v CONFIG_PATH=configs/pipeline/config_pipeline.json,FINALIZE_ONLY=1 turbospectrum_example_array.pbs

set -euo pipefail
cd "${PBS_O_WORKDIR}"

############################################
# Thread caps
############################################

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

unset PYTHONHOME || true
unset PYTHONPATH || true

############################################
# Environment activation
############################################

PYTHON_BIN="${PYTHON_BIN:-}"
MAMBA_ENV_NAME="${MAMBA_ENV_NAME:-astro}"

activate_mamba() {
    if [[ -n "${MAMBA_EXE:-}" && -x "${MAMBA_EXE}" ]]; then
        eval "$("${MAMBA_EXE}" shell hook --shell bash)"
    elif command -v mamba >/dev/null 2>&1; then
        eval "$(mamba shell hook --shell bash)"
    elif [[ -f "${HOME}/miniforge/etc/profile.d/conda.sh" ]]; then
        source "${HOME}/miniforge/etc/profile.d/conda.sh"
    else
        return 1
    fi

    if command -v mamba >/dev/null 2>&1; then
        mamba activate "${MAMBA_ENV_NAME}"
    elif command -v conda >/dev/null 2>&1; then
        conda activate "${MAMBA_ENV_NAME}"
    else
        return 1
    fi
}

if [[ -z "${PYTHON_BIN}" ]]; then
    if activate_mamba; then
        :
    else
        echo "[turbospec-array] WARN: could not activate mamba env '${MAMBA_ENV_NAME}', falling back to PATH python." >&2
    fi

    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python)"
    elif command -v python3 >/dev/null 2>&1; then
        PYTHON_BIN="$(command -v python3)"
    else
        echo "[turbospec-array] ERROR: no python executable found after env setup." >&2
        exit 1
    fi
fi

PYTHON="${PYTHON_BIN}"
echo "[turbospec-array] Python: ${PYTHON}"
echo "[turbospec-array] Mamba env: ${MAMBA_ENV_NAME}"
echo "[turbospec-array] Conda prefix: ${CONDA_PREFIX:-<unset>}"

############################################
# Paths and shard layout
############################################

PROJECT="${PROJECT:-mk27}"
USER_ID="${USER_ID:-$(whoami)}"
DEFAULT_RUN_ROOT="/scratch/${PROJECT}/${USER_ID}/Turbospectrum_NLTE"
USER_RUN_ROOT="${RUN_ROOT:-}"
RUN_ROOT="${USER_RUN_ROOT:-${DEFAULT_RUN_ROOT}}"
REPO="${REPO:-${PBS_O_WORKDIR}}"
CONFIG_PATH="${CONFIG_PATH:-configs/pipeline/config_pipeline.json}"
WORKERS="${WORKERS:-${PBS_NCPUS:-32}}"
SHARD_COUNT_OVERRIDE="${SHARD_COUNT:-}"
ROWS_PER_SHARD_OVERRIDE="${ROWS_PER_SHARD:-}"
FINALIZE_ONLY="${FINALIZE_ONLY:-0}"
ALLOW_PARTIAL_MERGE="${ALLOW_PARTIAL_MERGE:-1}"
ALLOW_INCOMPLETE_PROVENANCE="${ALLOW_INCOMPLETE_PROVENANCE:-0}"
SKIP_BAD_SHARDS="${SKIP_BAD_SHARDS:-1}"
CLEANUP_SHARDS="${CLEANUP_SHARDS:-1}"
MERGE_CHUNK_ROWS="${MERGE_CHUNK_ROWS:-128}"
VALIDATE_WORKERS="${VALIDATE_WORKERS:-${WORKERS}}"

to_bool01() {
    local val
    val="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    case "${val}" in
        1|true|yes|on) echo 1 ;;
        *) echo 0 ;;
    esac
}

FINALIZE_ONLY_EFFECTIVE="$(to_bool01 "${FINALIZE_ONLY}")"

if [[ "${REPO}" != /* ]]; then
    REPO="${PBS_O_WORKDIR}/${REPO}"
fi
REPO="$(cd "${REPO}" >/dev/null 2>&1 && pwd)"
LAYOUT_HELPER="${REPO}/scripts/resolve_shard_layout.py"

if [[ "${CONFIG_PATH}" != /* ]]; then
    CONFIG_PATH="${REPO}/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_PATH}" ]]; then
    echo "[turbospec-array] ERROR: config not found: ${CONFIG_PATH}" >&2
    exit 1
fi

CONFIG_OUTPUTS="$(
    "${PYTHON}" - <<PY
import json
import os

cfg_path = os.path.abspath(r"${CONFIG_PATH}")
cfg_dir = os.path.dirname(cfg_path)
with open(cfg_path, "r", encoding="utf-8") as handle:
    cfg = json.load(handle)
outs = cfg.get("outputs", {}) or {}
runtime = cfg.get("runtime", {}) or {}

def _abs(p):
    if not p:
        return ""
    return p if os.path.isabs(p) else os.path.abspath(os.path.join(cfg_dir, p))

def _infer_run_root(*paths):
    for path in paths:
        if not path:
            continue
        parent = os.path.dirname(os.path.normpath(path))
        if os.path.basename(parent) in {"shards", "zarr", "grids"} and os.path.basename(os.path.dirname(parent)) == "outputs":
            return os.path.dirname(os.path.dirname(parent))
    return ""

run_root = _abs(outs.get("run_root")) or _infer_run_root(
    outs.get("spectra_shard_template") and _abs(outs.get("spectra_shard_template")),
    outs.get("spectra_zarr") and _abs(outs.get("spectra_zarr")),
    outs.get("grid_zarr") and _abs(outs.get("grid_zarr")),
)
grid = _abs(outs.get("grid_zarr"))
merged = _abs(outs.get("spectra_zarr"))
shard_tmpl = _abs(outs.get("spectra_shard_template"))
shards_dir = os.path.dirname(shard_tmpl) if shard_tmpl else ""
shard_count = runtime.get("shard_count")
rows_per_shard = runtime.get("rows_per_shard")

print(run_root)
print(grid)
print(merged)
print(shard_tmpl)
print(shards_dir)
print("" if shard_count in (None, "") else int(shard_count))
print("" if rows_per_shard in (None, "") else int(rows_per_shard))
PY
)"

mapfile -t _cfg_lines <<< "${CONFIG_OUTPUTS}"
CFG_RUN_ROOT="${_cfg_lines[0]:-}"
CFG_GRID_ZARR="${_cfg_lines[1]:-}"
CFG_MERGED_ZARR="${_cfg_lines[2]:-}"
CFG_SHARD_TEMPLATE="${_cfg_lines[3]:-}"
CFG_SHARDS_DIR="${_cfg_lines[4]:-}"
CFG_SHARD_COUNT="${_cfg_lines[5]:-}"
CFG_ROWS_PER_SHARD="${_cfg_lines[6]:-}"

if [[ -z "${USER_RUN_ROOT}" && -n "${CFG_RUN_ROOT}" ]]; then
    RUN_ROOT="${CFG_RUN_ROOT}"
fi

GRID_ZARR="${GRID_ZARR:-${CFG_GRID_ZARR:-${RUN_ROOT}/outputs/grids/parameter_grid.zarr}}"
MERGED_ZARR="${MERGED_ZARR:-${CFG_MERGED_ZARR:-${RUN_ROOT}/outputs/zarr/synthesized_spectra.zarr}}"
SHARD_TEMPLATE="${SHARD_TEMPLATE:-${CFG_SHARD_TEMPLATE}}"
SHARDS_DIR="${SHARDS_DIR:-${CFG_SHARDS_DIR:-${RUN_ROOT}/outputs/shards}}"

if [[ -z "${GRID_ZARR}" || -z "${SHARD_TEMPLATE}" || -z "${SHARDS_DIR}" ]]; then
    echo "[turbospec-array] ERROR: failed to resolve grid/shard paths from config." >&2
    exit 1
fi

if [[ ! -d "${GRID_ZARR}" ]]; then
    echo "[turbospec-array] ERROR: grid zarr not found: ${GRID_ZARR}" >&2
    echo "[turbospec-array] ERROR: generate the grid first, e.g. python scripts/pipeline_from_config.py --config ${CONFIG_PATH} --skip-synthesis" >&2
    exit 1
fi

if [[ ! -f "${LAYOUT_HELPER}" ]]; then
    echo "[turbospec-array] ERROR: shard layout helper not found: ${LAYOUT_HELPER}" >&2
    exit 1
fi

ROWS_PER_SHARD_RAW="${ROWS_PER_SHARD_OVERRIDE:-${CFG_ROWS_PER_SHARD:-}}"
SHARD_COUNT_RAW="${SHARD_COUNT_OVERRIDE:-${CFG_SHARD_COUNT:-}}"

# When FINALIZE_ONLY and no explicit layout, infer from saved layout file or
# existing shard directories (same logic as the regular-grid PBS).
SHARD_LAYOUT_FILE="${SHARDS_DIR}/.shard_layout"
if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" && -z "${SHARD_COUNT_OVERRIDE}" && -z "${ROWS_PER_SHARD_RAW}" && -z "${CFG_SHARD_COUNT}" ]]; then
    if [[ -f "${SHARD_LAYOUT_FILE}" ]]; then
        read _saved_sc _saved_rps < "${SHARD_LAYOUT_FILE}" 2>/dev/null || true
        if [[ "${_saved_sc}" =~ ^[0-9]+$ && "${_saved_rps}" =~ ^[0-9]+$ ]]; then
            SHARD_COUNT_RAW="${_saved_sc}"
            ROWS_PER_SHARD_RAW="${_saved_rps}"
            echo "[turbospec-array] FINALIZE_ONLY: restored shard layout from ${SHARD_LAYOUT_FILE}: SHARD_COUNT=${_saved_sc} ROWS_PER_SHARD=${_saved_rps}"
        fi
    fi
    # Fallback: infer shard count from existing shard directories.
    if [[ -z "${SHARD_COUNT_RAW}" ]]; then
        _inferred_sc="$("${PYTHON}" -c "
import re, sys
from pathlib import Path
shard_dir = Path(sys.argv[1])
indices = sorted(
    int(m.group(1))
    for p in shard_dir.glob('spectra_shard_*.zarr')
    if (m := re.match(r'spectra_shard_(\d+)\.zarr', p.name))
)
print(max(indices) + 1 if indices else '')
" "${SHARDS_DIR}" 2>/dev/null || echo "")"
        if [[ -n "${_inferred_sc}" && "${_inferred_sc}" =~ ^[0-9]+$ ]] && (( _inferred_sc > 0 )); then
            SHARD_COUNT_RAW="${_inferred_sc}"
            echo "[turbospec-array] FINALIZE_ONLY: inferred SHARD_COUNT=${_inferred_sc} from existing shard files."
        fi
    fi
fi

if [[ -z "${ROWS_PER_SHARD_RAW}" && -z "${SHARD_COUNT_RAW}" ]]; then
    echo "[turbospec-array] ERROR: SHARD_COUNT is not set and runtime.shard_count is missing in the config." >&2
    echo "[turbospec-array] ERROR: provide SHARD_COUNT=N or ROWS_PER_SHARD=N (or set runtime.shard_count / runtime.rows_per_shard in the config)." >&2
    exit 1
fi

LAYOUT_CMD=(
    "${PYTHON}" "${LAYOUT_HELPER}"
    --zarr-path "${GRID_ZARR}"
    --row-keys "teff,params,global_index"
)
if [[ -n "${ROWS_PER_SHARD_RAW}" ]]; then
    LAYOUT_CMD+=(--rows-per-shard "${ROWS_PER_SHARD_RAW}")
fi
if [[ -n "${SHARD_COUNT_RAW}" ]]; then
    LAYOUT_CMD+=(--shard-count "${SHARD_COUNT_RAW}")
fi

LAYOUT_OUTPUT="$("${LAYOUT_CMD[@]}")"
while IFS='=' read -r key value; do
    case "${key}" in
        ROW_COUNT) ROW_COUNT="${value}" ;;
        ROWS_PER_SHARD) ROWS_PER_SHARD="${value}" ;;
        SHARD_COUNT) SHARD_COUNT="${value}" ;;
        ARRAY_RANGE) ARRAY_RANGE="${value}" ;;
    esac
done <<< "${LAYOUT_OUTPUT}"

LOG_DIR="${LOG_DIR:-${RUN_ROOT}/logs/pbs}"
SCRATCH_TMP_ROOT="${SCRATCH_TMP_ROOT:-${RUN_ROOT}/tmp/pbs_${PBS_JOBID}}"
TMP_SYSTEM_DIR="${TMP_SYSTEM_DIR:-${SCRATCH_TMP_ROOT}/system_tmp}"
TMP_WORK_DIR="${TMP_WORK_DIR:-${SCRATCH_TMP_ROOT}/workers}"
TMP_OUTPUT_DIR="${TMP_OUTPUT_DIR:-${SCRATCH_TMP_ROOT}/outputs}"

mkdir -p "${LOG_DIR}" "${SHARDS_DIR}" "${TMP_SYSTEM_DIR}" "${TMP_WORK_DIR}" "${TMP_OUTPUT_DIR}"

export TMPDIR="${TMP_SYSTEM_DIR}"
export TMP="${TMP_SYSTEM_DIR}"
export TEMP="${TMP_SYSTEM_DIR}"

echo "[turbospec-array] Repo: ${REPO}"
echo "[turbospec-array] Config: ${CONFIG_PATH}"
echo "[turbospec-array] Run root: ${RUN_ROOT}"
echo "[turbospec-array] Log dir: ${LOG_DIR}"
echo "[turbospec-array] Grid: ${GRID_ZARR}"
echo "[turbospec-array] Merged: ${MERGED_ZARR}"
echo "[turbospec-array] Shards: ${SHARDS_DIR}"
echo "[turbospec-array] Grid rows: ${ROW_COUNT}"
echo "[turbospec-array] Rows per shard: ${ROWS_PER_SHARD}"
echo "[turbospec-array] Shard count: ${SHARD_COUNT}"
echo "[turbospec-array] Array range: ${ARRAY_RANGE}"
echo "[turbospec-array] Finalize only: ${FINALIZE_ONLY_EFFECTIVE}"
echo "[turbospec-array] Workers: ${WORKERS}"

############################################
# FINALIZE_ONLY guard
############################################

if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]] && [[ -n "${PBS_ARRAY_INDEX:-}" ]]; then
    echo "[turbospec-array] ERROR: FINALIZE_ONLY=1 should be submitted as a normal job, not as a PBS array task." >&2
    exit 1
fi

if [[ "${FINALIZE_ONLY_EFFECTIVE}" == "1" ]]; then
    echo "[turbospec-array] FINALIZE_ONLY=1: skipping shard synthesis and moving directly to validation/merge."
else

############################################
# Per-shard synthesis (array task)
############################################

SHARD_INDEX="${PBS_ARRAY_INDEX:-0}"
if ! [[ "${SHARD_INDEX}" =~ ^[0-9]+$ ]] || (( SHARD_INDEX < 0 )); then
    echo "[turbospec-array] ERROR: PBS_ARRAY_INDEX must be a non-negative integer, got '${SHARD_INDEX}'." >&2
    exit 1
fi
if (( SHARD_INDEX >= SHARD_COUNT )); then
    echo "[turbospec-array] INFO: array task ${SHARD_INDEX} is outside SHARD_COUNT=${SHARD_COUNT}; exiting cleanly."
    exit 0
fi

SCRATCH="${TMP_WORK_DIR}/shard_${SHARD_INDEX}"
TMP_OUT="${TMP_OUTPUT_DIR}/spectra_shard_${SHARD_INDEX}.tmp.zarr"
SHARD_OUT="${SHARD_TEMPLATE//\{shard_index\}/${SHARD_INDEX}}"
mkdir -p "${SCRATCH}"

echo "[turbospec-array] Shard index: ${SHARD_INDEX}"
echo "[turbospec-array] Output: ${SHARD_OUT}"
echo "[turbospec-array] Scratch: ${SCRATCH}"

"${PYTHON}" "${REPO}/scripts/pipeline_from_config.py" \
    --config "${CONFIG_PATH}" \
    --skip-grid \
    --synthesis-mode sharded \
    --shard-index "${SHARD_INDEX}" \
    --shard-count "${SHARD_COUNT}" \
    --workers "${WORKERS}" \
    --scratch "${SCRATCH}" \
    --output "${TMP_OUT}"

if [[ -d "${SCRATCH}" ]]; then
    rm -rf "${SCRATCH}"
fi

# Array tasks exit here — only finalize jobs continue to validation/merge.
exit 0
fi

############################################
# Validation
############################################

echo "[turbospec-array] Validating shard outputs..."

DEFAULT_VALIDATE_WORKERS="${WORKERS}"
if (( DEFAULT_VALIDATE_WORKERS > 32 )); then
    DEFAULT_VALIDATE_WORKERS=32
fi
VALIDATE_WORKERS="${VALIDATE_WORKERS:-${DEFAULT_VALIDATE_WORKERS}}"

VALIDATE_CMD=(
    "${PYTHON}" "${REPO}/scripts/validate_dataset.py"
    --shard-dir "${SHARDS_DIR}"
    --expected-shards "${SHARD_COUNT}"
    --workers "${VALIDATE_WORKERS}"
)
if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    VALIDATE_CMD+=(--allow-incomplete-provenance)
fi
set +e
"${VALIDATE_CMD[@]}"
VALIDATE_RC=$?
set -e
if (( VALIDATE_RC != 0 )); then
    echo "[turbospec-array] WARN: validation exited with code ${VALIDATE_RC}; continuing with merge policy."
fi

############################################
# Merge
############################################

SHARD_STORE_COUNT=$(find "${SHARDS_DIR}" -mindepth 1 -maxdepth 1 -type d -name 'spectra_shard_*.zarr' | wc -l | tr -d '[:space:]')
if (( SHARD_STORE_COUNT == 0 )); then
    echo "[turbospec-array] ERROR: no shard stores were produced in ${SHARDS_DIR}; skipping merge." >&2
    exit 1
fi

mkdir -p "$(dirname "${MERGED_ZARR}")"

MERGE_CMD=(
    "${PYTHON}" "${REPO}/scripts/merge_spectra_shards.py"
    --shard-dir "${SHARDS_DIR}"
    --grid-zarr "${GRID_ZARR}"
    --output-zarr "${MERGED_ZARR}"
    --chunk-rows "${MERGE_CHUNK_ROWS}"
    --tmp-dir "${TMP_SYSTEM_DIR}"
)

if [[ "$(to_bool01 "${SKIP_BAD_SHARDS}")" == "1" ]]; then
    MERGE_CMD+=(--skip-invalid-shards)
fi

if [[ "$(to_bool01 "${ALLOW_INCOMPLETE_PROVENANCE}")" == "1" ]]; then
    MERGE_CMD+=(--allow-incomplete-provenance)
fi

if [[ "$(to_bool01 "${ALLOW_PARTIAL_MERGE}")" == "1" ]]; then
    MERGE_CMD+=(--allow-missing --skip-nonexistent-shards)
fi

echo "[turbospec-array] Merging shard outputs..."
"${MERGE_CMD[@]}"
echo "[turbospec-array] Merge complete: ${MERGED_ZARR}"

############################################
# Post-merge cleanup
############################################

if [[ "$(to_bool01 "${CLEANUP_SHARDS}")" == "1" ]]; then
    echo "[turbospec-array] Cleaning up shard directory to reclaim inodes: ${SHARDS_DIR}"
    rm -rf "${SHARDS_DIR}"
fi

if [[ -d "${SCRATCH_TMP_ROOT}" ]]; then
    echo "[turbospec-array] Cleaning up scratch tmp: ${SCRATCH_TMP_ROOT}"
    rm -rf "${SCRATCH_TMP_ROOT}"
fi
